{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/mens-group(?:/.*)?$",
      "has": [{ "type": "host", "value": { "eq": "samperet.com" } }],
      "status": 308,
      "headers": { "Location": "https://men.samperet.com/" }
    },
    {
      "src": "^/mens-group/?$",
      "has": [{ "type": "host", "value": { "eq": "men.samperet.com" } }],
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": { "eq": "men.samperet.com" } }],
      "dest": "/mens-group/index.html"
    },
    {
      "src": "^/(?!api/|_astro/|_image|_server-islands/|_vercel/)([^.]+)$",
      "has": [{ "type": "host", "value": { "eq": "men.samperet.com" } }],
      "status": 308,
      "headers": { "Location": "https://samperet.com/$1" }
    }
  ]
}
