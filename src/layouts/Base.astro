---
// The one <head> and the shared styles. Pages pass what differs: title, description, path (a
// full URL for a page with its own subdomain), whether Merlin and the photo viewer ride along,
// and the interests whose books the footer shelves. The footer comes on every page but the
// private ones; the homepage fills its slot.
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Merlin from '../components/Merlin.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import Footer from '../components/Footer.astro';

type Props = {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  merlin?: boolean;
  viewer?: boolean;
  bodyClass?: string;
  footer?: boolean;
  interests?: string[];
};

const {
  title,
  description,
  path,
  ogImage = '/og.jpg',
  ogType = 'website',
  noindex = false,
  merlin = true,
  viewer = true,
  bodyClass,
  footer = !noindex,
  interests,
} = Astro.props;

const url = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={url} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-fraunces" preload />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    {footer && (
      <Footer path={path} interests={interests} cards={Astro.slots.has('footer')}>
        <slot name="footer" />
      </Footer>
    )}
    {viewer && <PhotoViewer />}
    {merlin && <Merlin />}
  </body>
</html>
