---
// Full-screen photo viewer for every .photos grid on the page. Each thumbnail stays a plain
// link to the full image (so it works without JavaScript); with it, a click opens the viewer
// on that photo, and the arrows, swipes and arrow keys move through the rest of its section.
// A photo with a story (data-story-* on its link) plays its audio over the picture, with the
// WebVTT captions shown as subtitles. A link marked data-story-tile (a told story's tile) opens it alone.
---

<dialog class="viewer" aria-label="Photo viewer" data-viewer data-merlin-ui>
  <figure>
    <div class="viewer-stage">
      <img data-viewer-img alt="" />
      <p class="viewer-subtitle" data-viewer-subtitle aria-live="polite" hidden></p>
      <div class="viewer-story" data-viewer-story hidden>
        <button type="button" class="viewer-btn viewer-play" data-viewer-play aria-label="Play story" aria-pressed="false">
          <span class="viewer-play-icon" aria-hidden="true"></span>
        </button>
        <div class="viewer-progress" aria-hidden="true"><div data-viewer-bar></div></div>
        <span class="viewer-time" data-viewer-time>0:00</span>
      </div>
    </div>
    <figcaption>
      <span data-viewer-caption></span>
      <span class="viewer-count" data-viewer-count></span>
    </figcaption>
  </figure>
  <button type="button" class="viewer-btn viewer-prev" data-viewer-prev data-track="viewer:prev" aria-label="Previous photo">‹</button>
  <button type="button" class="viewer-btn viewer-next" data-viewer-next data-track="viewer:next" aria-label="Next photo">›</button>
  <button type="button" class="viewer-btn viewer-close" data-viewer-close data-track="viewer:close" aria-label="Close">×</button>
</dialog>

<script>
  import { type Cue, cueAt, clock, loadCues, pickSource } from '../scripts/narration';

  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-viewer-img]')!;
  const caption = dialog.querySelector<HTMLElement>('[data-viewer-caption]')!;
  const count = dialog.querySelector<HTMLElement>('[data-viewer-count]')!;
  const prev = dialog.querySelector<HTMLButtonElement>('[data-viewer-prev]')!;
  const next = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]')!;
  const subtitle = dialog.querySelector<HTMLElement>('[data-viewer-subtitle]')!;
  const storyBar = dialog.querySelector<HTMLElement>('[data-viewer-story]')!;
  const playButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-play]')!;
  const bar = dialog.querySelector<HTMLElement>('[data-viewer-bar]')!;
  const time = dialog.querySelector<HTMLElement>('[data-viewer-time]')!;

  type Story = { title: string; audio: string; captions: string };
  type Photo = { src: string; alt: string; caption?: string; story?: Story };

  let photos: Photo[] = [];
  let index = 0;

  // ---- Story playback -------------------------------------------------------------------

  const audio = new Audio();
  audio.preload = 'none';
  let cues: Cue[] = [];
  let story: Story | undefined;

  const setPlaying = (on: boolean) => {
    playButton.setAttribute('aria-pressed', String(on));
    playButton.setAttribute('aria-label', on ? 'Pause story' : 'Play story');
    dialog.classList.toggle('playing', on);
  };

  const stopStory = () => {
    audio.pause();
    audio.removeAttribute('src');
    audio.load();
    cues = [];
    story = undefined;
    subtitle.hidden = true;
    subtitle.textContent = '';
    storyBar.hidden = true;
    bar.style.width = '0%';
    time.textContent = '0:00';
    setPlaying(false);
  };

  const startStory = async (s: Story, autoplay: boolean) => {
    story = s;
    storyBar.hidden = false;
    subtitle.hidden = false;
    subtitle.textContent = '';
    audio.src = pickSource(audio, s.audio);
    cues = await loadCues(s.captions);
    if (story !== s) return; // moved on while the captions loaded
    if (autoplay) audio.play().catch(() => setPlaying(false));
  };

  const togglePlay = () => {
    if (!story) return;
    if (audio.paused) {
      if (audio.ended) audio.currentTime = 0;
      audio.play().catch(() => setPlaying(false));
    } else audio.pause();
  };

  audio.addEventListener('play', () => setPlaying(true));
  audio.addEventListener('pause', () => setPlaying(false));
  audio.addEventListener('ended', () => {
    setPlaying(false);
    subtitle.textContent = '';
  });
  audio.addEventListener('timeupdate', () => {
    const t = audio.currentTime;
    const text = cueAt(cues, t);
    if (subtitle.textContent !== text) subtitle.textContent = text;
    if (audio.duration) bar.style.width = `${(t / audio.duration) * 100}%`;
    time.textContent = clock(t);
  });

  playButton.addEventListener('click', togglePlay);
  storyBar.querySelector('.viewer-progress')!.addEventListener('click', (e) => {
    const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
    if (audio.duration) audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
  });

  // ---- Photos --------------------------------------------------------------------------

  const preload = (i: number) => {
    const photo = photos[(i + photos.length) % photos.length];
    if (photo) new Image().src = photo.src;
  };

  const show = (i: number, autoplay = false) => {
    stopStory();
    index = (i + photos.length) % photos.length;
    const photo = photos[index];
    img.classList.remove('viewer-in');
    img.src = photo.src;
    img.alt = photo.alt;
    // Only Sam's own captions show under a photo; alt text is for screen readers. A story shows its title.
    caption.textContent = photo.story ? photo.story.title : (photo.caption ?? '');
    count.textContent = photos.length > 1 ? `${index + 1} / ${photos.length}` : '';
    void img.offsetWidth;
    img.classList.add('viewer-in');
    preload(index + 1);
    preload(index - 1);
    if (photo.story) void startStory(photo.story, autoplay);
  };

  const photoOf = (a: HTMLAnchorElement): Photo => {
    const { caption, storyTitle, storyAudio, storyCaptions } = a.dataset;
    return {
      src: a.getAttribute('href')!,
      alt: a.querySelector('img')?.alt ?? '',
      caption,
      story: storyAudio && storyCaptions ? { title: storyTitle ?? '', audio: storyAudio, captions: storyCaptions } : undefined,
    };
  };

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.photos a, a[data-story-tile]');
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    const grid = link.closest('.photos');
    const links = grid ? [...grid.querySelectorAll<HTMLAnchorElement>('a')] : [link];
    photos = links.map(photoOf);
    dialog.classList.toggle('single', photos.length < 2);
    // Opened by a click, so a story may start playing straight away.
    show(links.indexOf(link), true);
    dialog.showModal();
    document.documentElement.classList.add('viewer-open');
  });

  dialog.addEventListener('close', () => {
    stopStory();
    document.documentElement.classList.remove('viewer-open');
  });
  prev.addEventListener('click', () => show(index - 1));
  next.addEventListener('click', () => show(index + 1));
  dialog.querySelector('[data-viewer-close]')!.addEventListener('click', () => dialog.close());

  // A click on the dark backdrop (not the photo or a control) closes it.
  dialog.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === dialog || t.tagName === 'FIGURE' || t.classList.contains('viewer-stage')) dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
    if (e.key === ' ' && story && !(e.target as HTMLElement).closest('button')) {
      e.preventDefault();
      togglePlay();
    }
  });

  // Swipe left or right on touch screens.
  let startX: number | null = null;
  dialog.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse') startX = e.clientX;
  });
  dialog.addEventListener('pointerup', (e) => {
    if (startX === null) return;
    const dx = e.clientX - startX;
    startX = null;
    if (Math.abs(dx) > 50 && photos.length > 1) show(index + (dx < 0 ? 1 : -1));
  });
</script>

<style is:global>
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: #f5f5f4;
    overflow: hidden;
  }

  .viewer::backdrop {
    background: rgb(10 10 10 / 0.92);
  }

  .viewer[open] {
    display: grid;
    place-items: center;
    animation: viewer-fade 0.2s ease-out;
  }

  .viewer figure {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 3.5rem 4.5rem 1.5rem;
  }

  .viewer-stage {
    position: relative;
    display: grid;
    place-items: center;
    max-width: 100%;
  }

  .viewer img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    border-radius: var(--radius-lg, 6px);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.5);
    touch-action: pan-y;
    user-select: none;
  }

  .viewer img.viewer-in {
    animation: viewer-fade 0.25s ease-out;
  }

  /* Subtitles sit over the lower part of the photo, like captions on a film. */
  .viewer-subtitle {
    position: absolute;
    left: 50%;
    bottom: 4.25rem;
    transform: translateX(-50%);
    max-width: min(90%, 40rem);
    margin: 0;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.72);
    color: #fff;
    font-size: clamp(1rem, 2.2vw, 1.375rem);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
    pointer-events: none;
    white-space: pre-line;
  }

  .viewer-subtitle:empty {
    display: none;
  }

  .viewer-story {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.75rem 0.4rem 0.4rem;
    border-radius: var(--radius, 3px);
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(6px);
  }

  .viewer-story[hidden],
  .viewer-subtitle[hidden] {
    display: none;
  }

  .viewer-story .viewer-play {
    position: static;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    padding: 0;
    background: #fff;
    color: #111;
  }

  .viewer-story .viewer-play:hover,
  .viewer-story .viewer-play:focus-visible {
    background: #fff;
  }

  .viewer-play-icon {
    display: block;
    width: 0;
    height: 0;
    margin-left: 3px;
    border-style: solid;
    border-width: 0.45rem 0 0.45rem 0.75rem;
    border-color: transparent transparent transparent #111;
  }

  .viewer.playing .viewer-play-icon {
    width: 0.7rem;
    height: 0.8rem;
    margin-left: 0;
    border-width: 0 0.22rem;
    border-color: #111;
    border-style: solid;
  }

  .viewer-progress {
    flex: 1;
    height: 0.75rem;
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .viewer-progress::before {
    content: '';
    position: absolute;
    left: 3.9rem;
    right: 3.6rem;
    height: 3px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.25);
  }

  .viewer-progress div {
    position: relative;
    height: 3px;
    width: 0;
    border-radius: 2px;
    background: var(--accent, #007a87);
  }

  .viewer-time {
    flex: none;
    min-width: 2.4rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .viewer figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    max-width: 48rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    text-align: center;
  }

  .viewer-count {
    color: #a8a29e;
    font-variant-numeric: tabular-nums;
  }

  .viewer-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0 0 0.2rem;
    border: none;
    border-radius: var(--radius, 3px);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .viewer-btn:hover,
  .viewer-btn:focus-visible {
    background: rgb(255 255 255 / 0.25);
  }

  .viewer-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .viewer-prev,
  .viewer-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .viewer-prev {
    left: 1rem;
  }

  .viewer-next {
    right: 1rem;
  }

  .viewer-close {
    top: 1rem;
    right: 1rem;
    font-size: 1.75rem;
  }

  .viewer.single .viewer-prev,
  .viewer.single .viewer-next {
    display: none;
  }

  .viewer-open {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .viewer figure {
      padding: 3.5rem 0.75rem 5rem;
    }

    .viewer-prev,
    .viewer-next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }

    .viewer img {
      max-height: calc(100dvh - 12rem);
    }

    .viewer-subtitle {
      bottom: 3.9rem;
      font-size: 1rem;
    }
  }

  @keyframes viewer-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer[open],
    .viewer img.viewer-in {
      animation: none;
    }
  }
</style>
