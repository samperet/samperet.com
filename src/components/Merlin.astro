---
// Merlin, the original Microsoft Agent character, played from his own sprite sheet and frame
// data via clippyjs. He waits behind a wizard-hat button in the corner; summoned, he asks what
// the visitor is interested in (src/scripts/topics.ts) or takes a message for Sam
// (/api/message). Vivify supplies the CSS effects around him.
import '../styles/vivify-subset.css';

const moves = [
  ['Wave', 'Wave'],
  ['Greet', 'Greet'],
  ['DoMagic1', 'Magic'],
  ['Congratulate', 'Congratulate'],
  ['Think', 'Think'],
  ['Read', 'Read'],
  ['Searching', 'Search'],
  ['Surprised', 'Surprised'],
  ['Confused', 'Confused'],
  ['Announce', 'Announce'],
];
---

<div class="merlin-ui" data-merlin-ui>
  <button type="button" class="merlin-toggle" data-merlin-toggle aria-pressed="false">Summon Merlin</button>
  <div class="merlin-moves" data-merlin-moves hidden>
    {
      moves.map(([anim, label]) => (
        <button type="button" data-anim={anim} data-track={`merlin:anim:${anim}`}>
          {label}
        </button>
      ))
    }
  </div>
  <p class="merlin-hint">Or use the wizard hat in the corner. Click anywhere and he’ll point.</p>
  <p class="sr-only" aria-live="polite" data-merlin-live></p>
</div>

<script>
  import { initAgent } from 'clippyjs';
  import MerlinLoaders from 'clippyjs/agents/merlin';
  import { TOPICS, isTopic, openTopic, type Topic } from '../scripts/topics';
  import { sessionId } from '../scripts/track';

  type Agent = Awaited<ReturnType<typeof initAgent>>;

  const ui = document.querySelector<HTMLElement>('[data-merlin-ui]')!;
  const toggle = ui.querySelector<HTMLButtonElement>('[data-merlin-toggle]')!;
  const movesEl = ui.querySelector<HTMLElement>('[data-merlin-moves]')!;
  const live = ui.querySelector<HTMLElement>('[data-merlin-live]')!;

  let agent: Agent | undefined;
  let loading: Promise<Agent> | undefined;
  let visible = false;

  const agentEl = () => (agent as unknown as { _el: HTMLElement } | undefined)?._el;

  const load = () =>
    (loading ??= initAgent({
      agent: MerlinLoaders.agent,
      // The sprite sheet ships as a cacheable PNG instead of a 1.4 MB base64 module.
      map: async () => ({ default: '/merlin/map.png' }),
      // Silent: no sounds on a web page unless asked for.
      sound: async () => ({ default: {} }),
    } as Parameters<typeof initAgent>[0]).then((a) => {
      agent = a;
      const el = agentEl()!;
      el.setAttribute('role', 'img');
      el.setAttribute('aria-label', 'Merlin the wizard');
      el.dataset.merlinAgent = '';
      el.dataset.track = 'merlin:character';
      return a;
    }));

  // The wizard hat: Merlin's hiding place, bottom right, on every visit.
  const hat = document.createElement('button');
  hat.type = 'button';
  hat.className = 'merlin-hat vivify popIn';
  hat.dataset.merlinUi = '';
  hat.dataset.track = 'merlin:hat';
  hat.setAttribute('aria-label', 'Summon Merlin');
  hat.innerHTML = '<img src="/merlin/hat.webp" alt="" width="64" height="63" />';
  document.body.appendChild(hat);

  const say = (text: string) => {
    agent?.speak(text);
    live.textContent = text;
  };

  const setVisible = (on: boolean) => {
    visible = on;
    toggle.setAttribute('aria-pressed', String(on));
    toggle.textContent = on ? 'Dismiss Merlin' : 'Summon Merlin';
    // The hat is where he hides: it disappears while he's out and comes back when he leaves.
    hat.hidden = on;
    if (!on) {
      hat.classList.remove('popIn');
      void hat.offsetWidth;
      hat.classList.add('popIn');
    }
    movesEl.hidden = !on;
    if (on) movesEl.classList.add('vivify', 'fadeInBottom');
  };

  // Merlin's card: a balloon-styled panel beside him that either asks what the visitor is
  // interested in or runs the message chat.
  const card = document.createElement('div');
  card.className = 'merlin-ask';
  card.dataset.merlinUi = '';
  card.setAttribute('role', 'dialog');
  card.hidden = true;
  document.body.appendChild(card);

  const placeCard = () => {
    const el = agentEl();
    if (!el || card.hidden) return;
    const r = el.getBoundingClientRect();
    const w = card.offsetWidth;
    const h = card.offsetHeight;
    const left = Math.min(Math.max(8, r.right - w), innerWidth - w - 8);
    const above = r.top - h - 8;
    card.style.left = `${left}px`;
    card.style.top = `${above >= 8 ? above : Math.min(r.bottom + 8, innerHeight - h - 8)}px`;
  };

  const popCard = () => {
    agent?.closeBalloon();
    card.hidden = false;
    card.classList.remove('popIn');
    void card.offsetWidth;
    card.classList.add('vivify', 'popIn');
    placeCard();
  };

  const hideCard = () => {
    card.hidden = true;
  };

  const closeButton = '<button type="button" class="merlin-ask-close" aria-label="Close">×</button>';
  const awayButton = '<button type="button" class="merlin-away" data-away data-track="merlin:away">Send Merlin back to his hat</button>';

  const showAsk = () => {
    card.setAttribute('aria-label', 'Merlin asks what you are interested in');
    card.innerHTML = `${closeButton}
      <p class="merlin-ask-q">Hi! What are you interested in?</p>
      <div class="merlin-ask-options">
        ${Object.entries(TOPICS)
          .map(([key, { label }]) => `<button type="button" data-ask="${key}" data-track="merlin:topic:${key}">${label}</button>`)
          .join('')}
        <button type="button" class="merlin-joke-button" data-joke data-track="merlin:joke">Tell me a joke</button>
      </div>
      ${awayButton}`;
    popCard();
    live.textContent = 'Merlin asks: what are you interested in?';
  };

  // A few jokes, told setup first; the punchline waits for the visitor. They come round in a
  // shuffled order so nobody hears the same one twice in a row.
  const JOKES = [
    { setup: 'What’s a wizard’s favorite subject in school?', prompt: 'I give up', punchline: 'Spelling!' },
    { setup: 'What do you call a wizard from outer space?', prompt: 'Tell me', punchline: 'A flying sorcerer.' },
    { setup: 'How many wizards does it take to change a light bulb?', prompt: 'How many?', punchline: 'Depends what you want it changed into.' },
    { setup: 'Why do programmers prefer dark mode?', prompt: 'Why?', punchline: 'Because light attracts bugs.' },
    { setup: 'Why did the programmer quit his job?', prompt: 'Why?', punchline: 'He didn’t get arrays.' },
    { setup: 'There are 10 kinds of people in the world…', prompt: 'Go on', punchline: 'Those who understand binary, and those who don’t.' },
  ];
  let jokeOrder: number[] = [];
  let lastJoke = -1;
  const nextJoke = () => {
    if (!jokeOrder.length) {
      jokeOrder = JOKES.map((_, i) => i).sort(() => Math.random() - 0.5);
      if (jokeOrder[0] === lastJoke) jokeOrder.push(jokeOrder.shift()!);
    }
    return (lastJoke = jokeOrder.shift()!);
  };

  const tellJoke = () => {
    const i = nextJoke();
    const joke = JOKES[i];
    card.setAttribute('aria-label', 'Merlin tells a joke');
    card.innerHTML = `${closeButton}
      <p class="merlin-ask-q"></p>
      <div class="merlin-ask-options">
        <button type="button" data-punchline data-track="merlin:joke:${i}:reveal"></button>
      </div>`;
    card.querySelector('.merlin-ask-q')!.textContent = joke.setup;
    card.querySelector('[data-punchline]')!.textContent = joke.prompt;
    popCard();
    live.textContent = joke.setup;
    agent?.stop();
    agent?.play('Explain');
    card.querySelector<HTMLButtonElement>('[data-punchline]')!.focus();
  };

  const revealPunchline = () => {
    const joke = JOKES[lastJoke];
    const punchline = document.createElement('p');
    punchline.className = 'merlin-joke-punchline';
    punchline.textContent = joke.punchline;
    card.querySelector('.merlin-ask-q')!.after(punchline);
    card.querySelector('.merlin-ask-options')!.innerHTML = `
      <button type="button" data-joke data-track="merlin:joke:another">Another one</button>
      <button type="button" data-restart>Back to the menu</button>`;
    placeCard();
    live.textContent = joke.punchline;
    agent?.stop();
    agent?.play(['Pleased', 'Congratulate', 'Surprised'][Math.floor(Math.random() * 3)]);
    card.querySelector<HTMLButtonElement>('[data-joke]')!.focus();
  };

  // The message chat: name, then the message, with a reminder to include a way to reply.
  type Step = 'name' | 'message' | 'sending' | 'done';
  let step: Step = 'name';
  const draft = { name: '', message: '' };

  const showChat = () => {
    step = 'name';
    draft.name = draft.message = '';
    card.setAttribute('aria-label', 'Send Sam a message through Merlin');
    card.innerHTML = `${closeButton}
      <div class="merlin-chat-log" aria-live="polite"></div>
      <form class="merlin-chat-form">
        <label class="sr-only" for="merlin-chat-input">Your reply</label>
        <textarea id="merlin-chat-input" rows="1" maxlength="4000" required></textarea>
        <input class="merlin-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="merlin-chat-actions">
          <button type="submit" data-track="merlin:message:submit">Send</button>
        </div>
      </form>`;
    popCard();
    merlinSays('Happy to deliver a message to Sam. What’s your name?');
    agent?.play('Write');
    input().focus();
  };

  const log = () => card.querySelector<HTMLElement>('.merlin-chat-log')!;
  const input = () => card.querySelector<HTMLTextAreaElement>('#merlin-chat-input')!;

  const line = (who: 'merlin' | 'you', text: string) => {
    const p = document.createElement('p');
    p.className = `merlin-chat-${who}`;
    p.textContent = text;
    log().appendChild(p);
    log().scrollTop = log().scrollHeight;
    placeCard();
  };
  const merlinSays = (text: string) => line('merlin', text);

  const prompt = (next: Step) => {
    step = next;
    const field = input();
    field.value = '';
    field.rows = next === 'message' ? 4 : 1;
    field.placeholder = next === 'message' ? 'Your message, and how to reach you' : '';
    field.focus();
    placeCard();
  };

  const send = async () => {
    step = 'sending';
    merlinSays('Sending it by owl…');
    agent?.play('DoMagic1');
    try {
      const res = await fetch('/api/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...draft,
          website: card.querySelector<HTMLInputElement>('.merlin-hp')!.value,
          session: sessionId(),
        }),
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok || !result.ok) throw new Error(result.error);
      step = 'done';
      merlinSays('Delivered! Sam will read it soon.');
      agent?.play('Congratulate');
      card.querySelector('.merlin-chat-form')!.innerHTML =
        '<div class="merlin-chat-actions"><button type="button" data-restart>Back to the menu</button></div>';
      placeCard();
    } catch (err) {
      merlinSays(`My magic fizzled${err instanceof Error && err.message ? `: ${err.message}` : '.'} Press Send to try again.`);
      agent?.play('Sad');
      step = 'message';
      input().value = draft.message;
      input().focus();
    }
  };

  const answer = (value: string) => {
    if (step === 'name') {
      draft.name = value;
      line('you', value);
      merlinSays(`Nice to meet you, ${value}! What would you like to say? If you’d like a reply, include your email or phone number in the message.`);
      prompt('message');
    } else if (step === 'message') {
      draft.message = value;
      line('you', value);
      void send();
    }
  };

  card.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = input().value.trim();
    if (step === 'sending' || step === 'done' || !value) return;
    answer(value);
  });

  card.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return hideCard();
    // Enter sends; Shift+Enter makes a new line in the message.
    if (e.key === 'Enter' && !e.shiftKey && (e.target as HTMLElement).id === 'merlin-chat-input') {
      e.preventDefault();
      card.querySelector<HTMLFormElement>('.merlin-chat-form')?.requestSubmit();
    }
  });

  card.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.merlin-ask-close')) return hideCard();
    if (target.closest('[data-restart]')) return showAsk();
    if (target.closest('[data-joke]')) return tellJoke();
    if (target.closest('[data-punchline]')) return revealPunchline();
    if (target.closest('[data-away]')) return dismiss();
    const topic = target.closest<HTMLButtonElement>('[data-ask]')?.dataset.ask;
    if (isTopic(topic)) openTopic(topic);
  });

  addEventListener('resize', placeCard);

  const summon = async () => {
    const a = await load();
    const el = agentEl()!;
    // Appear where the hat was, in the bottom-right corner.
    el.style.left = `${Math.max(8, innerWidth - 128 - 16)}px`;
    el.style.top = `${Math.max(8, innerHeight - 128 - 16)}px`;
    setVisible(true);
    a.show();
    return a;
  };

  // clippyjs's own hide() can leave its animation queue stuck when an animation is running, and
  // he never shows again. So he plays Hide, then is disposed; the next summon builds a fresh one.
  const dismiss = () => {
    hideCard();
    setVisible(false);
    const leaving = agent;
    agent = undefined;
    loading = undefined;
    if (!leaving) return;
    leaving.stop();
    if (!leaving.play('Hide', 3000, () => leaving.dispose())) leaving.dispose();
  };

  const summonAndAsk = async () => {
    const a = await summon();
    a.play('Wave');
    setTimeout(showAsk, 900);
  };

  hat.addEventListener('click', () => void summonAndAsk());
  toggle.addEventListener('click', () => (visible ? dismiss() : summonAndAsk()));

  movesEl.addEventListener('click', (e) => {
    const anim = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-anim]')?.dataset.anim;
    if (!anim || !agent) return;
    agent.stop();
    agent.play(anim);
  });

  // Whichever chooser opened the topic, Merlin answers and points at the first section; for a
  // message he comes out (if hidden) and starts the chat.
  const reactions: Record<Topic, string> = {
    professional: 'Explain',
    personal: 'Think',
    family: 'Pleased',
    adventure: 'DoMagic1',
    message: 'Write',
  };

  document.addEventListener('topic:open', async (e) => {
    const { topic, target } = (e as CustomEvent<{ topic: Topic; target: HTMLElement | null }>).detail;
    if (topic === 'message') {
      if (visible) agent?.stop();
      else await summon();
      showChat();
      return;
    }
    hideCard();
    if (!visible || !agent) return;
    agent.stop();
    say(TOPICS[topic].reply);
    agent.play(reactions[topic]);
    if (target) {
      // Point once the smooth scroll has settled.
      setTimeout(() => {
        const r = target.getBoundingClientRect();
        agent?.gestureAt(r.left + 40, r.top + 24);
      }, 700);
    }
  });

  // Point at every click outside Merlin and his controls.
  const marker = (x: number, y: number) => {
    const dot = document.createElement('span');
    dot.className = 'merlin-target vivify popIn';
    dot.style.left = `${x}px`;
    dot.style.top = `${y}px`;
    document.body.appendChild(dot);
    setTimeout(() => dot.classList.replace('popIn', 'fadeOut'), 700);
    setTimeout(() => dot.remove(), 1500);
  };

  document.addEventListener('click', (e) => {
    if (!visible || !agent) return;
    const target = e.target as HTMLElement;
    if (target.closest('[data-merlin-ui], [data-merlin-agent]')) return;
    marker(e.pageX, e.pageY);
    agent.stop();
    agent.gestureAt(e.clientX, e.clientY);
  });

  // A click on Merlin (not a drag) brings the question back; after a drag the card follows him.
  let downAt: [number, number] | undefined;
  document.addEventListener('mousedown', (e) => {
    if ((e.target as HTMLElement).closest('[data-merlin-agent]')) downAt = [e.clientX, e.clientY];
  });
  document.addEventListener('mouseup', (e) => {
    if (!downAt) return;
    const moved = Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 4;
    downAt = undefined;
    if (moved) setTimeout(placeCard, 20);
    else if (card.hidden) showAsk();
  });
</script>

<style is:global>
  .merlin-ui {
    margin-top: 1.25rem;
  }

  .merlin-ui button {
    font: inherit;
    font-size: 0.8125rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }

  .merlin-ui button:hover,
  .merlin-ui button:focus-visible {
    border-color: currentColor;
  }

  .merlin-toggle {
    font-weight: 600;
  }

  .merlin-moves {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .merlin-moves[hidden] {
    display: none;
  }

  .text .merlin-hint {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .merlin-hat {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 10003;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.25));
    transition: transform 0.2s;
  }

  .merlin-hat[hidden] {
    display: none;
  }

  .merlin-hat img {
    display: block;
    width: 64px;
    height: auto;
  }

  .merlin-hat:hover,
  .merlin-hat:focus-visible {
    transform: rotate(-8deg) scale(1.08);
  }

  .merlin-hat:focus-visible {
    outline: 2px solid #f5b400;
    outline-offset: 2px;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .merlin-hat {
      transition: none;
    }
  }

  /* Styled after Merlin's own speech balloon. */
  .merlin-ask {
    position: fixed;
    z-index: 10002;
    width: min(20rem, calc(100vw - 16px));
    padding: 0.75rem 0.85rem 0.85rem;
    background: #ffc;
    color: #000;
    border: 1px solid #000;
    border-radius: 6px;
    font: 0.875rem/1.4 'Microsoft Sans Serif', Tahoma, system-ui, sans-serif;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.15);
  }

  .merlin-ask[hidden] {
    display: none;
  }

  .merlin-ask .merlin-ask-q {
    margin: 0 1.5rem 0.6rem 0;
    font-weight: 600;
  }

  .merlin-chat-log {
    max-height: 14rem;
    overflow-y: auto;
    margin-right: 1.25rem;
  }

  .merlin-chat-log p {
    margin: 0 0 0.45rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .merlin-chat-merlin {
    font-weight: 600;
  }

  .merlin-chat-you {
    margin-left: 1.25rem !important;
    padding: 0.3rem 0.5rem;
    background: #fff;
    border: 1px solid #000;
    border-radius: 4px;
  }

  .merlin-chat-form {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .merlin-chat-form textarea {
    font: inherit;
    width: 100%;
    resize: vertical;
    color: #000;
    background: #fff;
    border: 1px solid #000;
    border-radius: 4px;
    padding: 0.35rem 0.45rem;
  }

  .merlin-chat-form textarea:focus-visible {
    outline: 2px solid #000;
    outline-offset: 1px;
  }

  .merlin-chat-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.375rem;
  }

  .merlin-chat-actions [hidden] {
    display: none;
  }

  .merlin-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
  }

  .merlin-ask-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .merlin-ask button {
    font: inherit;
    color: #000;
    background: #fff;
    border: 1px solid #000;
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  .merlin-ask button:hover,
  .merlin-ask button:focus-visible {
    background: #000;
    color: #ffc;
  }

  .merlin-ask .merlin-joke-button {
    background: #000;
    color: #ffc;
  }

  .merlin-ask .merlin-joke-button:hover,
  .merlin-ask .merlin-joke-button:focus-visible {
    background: #fff;
    color: #000;
  }

  .merlin-joke-punchline {
    margin: 0 1.5rem 0.6rem 0;
    font-size: 1rem;
    font-style: italic;
  }

  .merlin-ask .merlin-away {
    display: block;
    margin: 0.65rem 0 0 auto;
    padding: 0;
    border: none;
    background: transparent;
    font-size: 0.8125rem;
    text-decoration: underline;
  }

  .merlin-ask .merlin-away:hover,
  .merlin-ask .merlin-away:focus-visible {
    background: transparent;
    color: #000;
    text-decoration-thickness: 2px;
  }

  .merlin-ask .merlin-ask-close {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    line-height: 1;
    border: none;
    background: transparent;
    font-size: 1.1rem;
  }

  .merlin-target {
    position: absolute;
    z-index: 10000;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border: 2px solid #4338ca;
    border-radius: 50%;
    background: rgb(67 56 202 / 0.15);
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
