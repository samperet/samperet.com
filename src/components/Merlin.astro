---
// Merlin, the original Microsoft Agent character, played from his own sprite sheet and frame
// data via clippyjs. He waits behind a wizard-hat button in the corner; summoned, he asks what
// the visitor is interested in (src/scripts/topics.ts) or takes a message for Sam
// (/api/message). Everything he says is in one card styled by the design system; Vivify
// supplies the click marker.
import '../styles/vivify-subset.css';
---

<p class="sr-only" aria-live="polite" data-merlin-ui data-merlin-live></p>

<script>
  import { initAgent } from 'clippyjs';
  import MerlinLoaders from 'clippyjs/agents/merlin';
  import { TOPICS, isTopic, openTopic, type Topic } from '../scripts/topics';
  import { sessionId } from '../scripts/track';

  type Agent = Awaited<ReturnType<typeof initAgent>>;

  const live = document.querySelector<HTMLElement>('[data-merlin-live]')!;

  let agent: Agent | undefined;
  let loading: Promise<Agent> | undefined;
  let visible = false;

  const agentEl = () => (agent as unknown as { _el: HTMLElement } | undefined)?._el;

  const load = () =>
    (loading ??= initAgent({
      agent: MerlinLoaders.agent,
      // The sprite sheet ships as a cacheable PNG instead of a 1.4 MB base64 module.
      map: async () => ({ default: '/merlin/map.png' }),
      // Silent: no sounds on a web page unless asked for.
      sound: async () => ({ default: {} }),
    } as Parameters<typeof initAgent>[0]).then((a) => {
      agent = a;
      const el = agentEl()!;
      el.setAttribute('role', 'img');
      el.setAttribute('aria-label', 'Merlin the wizard');
      el.dataset.merlinAgent = '';
      el.dataset.track = 'merlin:character';
      return a;
    }));

  // The wizard hat: Merlin's hiding place, bottom right, on every visit.
  const hat = document.createElement('button');
  hat.type = 'button';
  hat.className = 'merlin-hat';
  hat.dataset.merlinUi = '';
  hat.dataset.track = 'merlin:hat';
  hat.setAttribute('aria-label', 'Summon Merlin');
  hat.innerHTML = '<img src="/merlin/hat.webp" alt="" width="64" height="63" />';
  document.body.appendChild(hat);

  const setVisible = (on: boolean) => {
    visible = on;
    // The hat is where he hides: it disappears while he's out and comes back when he leaves.
    hat.hidden = on;
  };

  // Merlin's card: one panel beside him for everything he says, asks and takes down. It follows
  // the site's design system (/branding/); his own yellow clippyjs balloon is never used.
  const card = document.createElement('div');
  card.className = 'merlin-ask';
  card.dataset.merlinUi = '';
  card.setAttribute('role', 'dialog');
  card.hidden = true;
  document.body.appendChild(card);

  const placeCard = () => {
    const el = agentEl();
    if (!el || card.hidden) return;
    const r = el.getBoundingClientRect();
    const w = card.offsetWidth;
    const h = card.offsetHeight;
    const left = Math.min(Math.max(8, r.right - w), innerWidth - w - 8);
    const above = r.top - h - 12;
    card.style.left = `${left}px`;
    card.style.top = `${above >= 8 ? above : Math.min(r.bottom + 12, innerHeight - h - 8)}px`;
  };

  // The card fades up once when it opens, because the visitor asked for it; after that its
  // contents change in place.
  const popCard = () => {
    agent?.closeBalloon();
    const opening = card.hidden;
    card.hidden = false;
    if (opening) {
      card.classList.remove('is-in');
      void card.offsetWidth;
      card.classList.add('is-in');
    }
    placeCard();
  };

  const hideCard = () => {
    card.hidden = true;
  };

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => `&${({ '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot' } as Record<string, string>)[c]};`);

  // Every view is the same frame: a name line with the close button, the body, and a way to
  // send him back to his hat.
  const frame = (label: string, body: string, foot = true) => {
    card.setAttribute('aria-label', label);
    card.innerHTML = `
      <header class="merlin-head">
        <span class="merlin-name">Merlin</span>
        <button type="button" class="merlin-ask-close" aria-label="Close">×</button>
      </header>
      <div class="merlin-body">${body}</div>
      ${foot ? '<footer class="merlin-foot"><button type="button" class="merlin-away" data-away data-track="merlin:away" aria-label="Silencio: send Merlin back to his hat">Silencio</button></footer>' : ''}`;
    popCard();
  };

  // A choice is a row: label on the left, an arrow that steps right on hover. Never a pill.
  const option = (attrs: string, label: string, kind = '') =>
    `<li><button type="button" class="merlin-option ${kind}" ${attrs}><span>${esc(label)}</span><span class="arrow" aria-hidden="true">→</span></button></li>`;

  const showAsk = () => {
    frame(
      'Merlin asks what you are interested in',
      `<p class="merlin-say">What are you interested in?</p>
      <ul class="merlin-options">
        ${Object.entries(TOPICS)
          .map(([key, { label }]) => option(`data-ask="${key}" data-track="merlin:topic:${key}"`, label))
          .join('')}
        ${option('data-joke data-track="merlin:joke"', 'Tell me a joke', 'is-aside')}
      </ul>`,
    );
    live.textContent = 'Merlin asks: what are you interested in?';
    card.querySelector<HTMLButtonElement>('.merlin-option')?.focus({ preventScroll: true });
  };

  // What he says after a choice, in the card rather than his old balloon.
  const say = (text: string) => {
    frame(
      'Merlin',
      `<p class="merlin-say">${esc(text)}</p>
      <ul class="merlin-options">${option('data-restart', 'Something else')}</ul>`,
    );
    live.textContent = text;
  };

  // A few jokes, told setup first; the punchline waits for the visitor. They come round in a
  // shuffled order so nobody hears the same one twice in a row.
  const JOKES = [
    { setup: 'What’s a wizard’s favorite subject in school?', prompt: 'I give up', punchline: 'Spelling!' },
    { setup: 'What do you call a wizard from outer space?', prompt: 'Tell me', punchline: 'A flying sorcerer.' },
    { setup: 'How many wizards does it take to change a light bulb?', prompt: 'How many?', punchline: 'Depends what you want it changed into.' },
    { setup: 'Why do programmers prefer dark mode?', prompt: 'Why?', punchline: 'Because light attracts bugs.' },
    { setup: 'Why did the programmer quit his job?', prompt: 'Why?', punchline: 'He didn’t get arrays.' },
    { setup: 'There are 10 kinds of people in the world…', prompt: 'Go on', punchline: 'Those who understand binary, and those who don’t.' },
  ];
  let jokeOrder: number[] = [];
  let lastJoke = -1;
  const nextJoke = () => {
    if (!jokeOrder.length) {
      jokeOrder = JOKES.map((_, i) => i).sort(() => Math.random() - 0.5);
      if (jokeOrder[0] === lastJoke) jokeOrder.push(jokeOrder.shift()!);
    }
    return (lastJoke = jokeOrder.shift()!);
  };

  const tellJoke = () => {
    const i = nextJoke();
    const joke = JOKES[i];
    frame(
      'Merlin tells a joke',
      `<p class="merlin-say">${esc(joke.setup)}</p>
      <ul class="merlin-options">${option(`data-punchline data-track="merlin:joke:${i}:reveal"`, joke.prompt)}</ul>`,
    );
    live.textContent = joke.setup;
    agent?.stop();
    agent?.play('Explain');
    card.querySelector<HTMLButtonElement>('[data-punchline]')!.focus({ preventScroll: true });
  };

  const revealPunchline = () => {
    const joke = JOKES[lastJoke];
    frame(
      'Merlin tells a joke',
      `<p class="merlin-say is-muted">${esc(joke.setup)}</p>
      <p class="merlin-punchline">${esc(joke.punchline)}</p>
      <ul class="merlin-options">
        ${option('data-joke data-track="merlin:joke:another"', 'Another one')}
        ${option('data-restart', 'Back to the menu')}
      </ul>`,
    );
    live.textContent = joke.punchline;
    agent?.stop();
    agent?.play(['Pleased', 'Congratulate', 'Surprised'][Math.floor(Math.random() * 3)]);
    card.querySelector<HTMLButtonElement>('[data-joke]')!.focus({ preventScroll: true });
  };

  // The message chat: name, then the message, with a reminder to include a way to reply.
  type Step = 'name' | 'message' | 'sending' | 'done';
  let step: Step = 'name';
  const draft = { name: '', message: '' };

  const showChat = () => {
    step = 'name';
    draft.name = draft.message = '';
    frame(
      'Send Sam a message through Merlin',
      `<div class="merlin-chat-log" aria-live="polite"></div>
      <form class="merlin-chat-form">
        <label class="sr-only" for="merlin-chat-input">Your reply</label>
        <textarea id="merlin-chat-input" rows="1" maxlength="4000" required placeholder="Your name"></textarea>
        <input class="merlin-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="merlin-chat-actions">
          <span class="merlin-hint">Enter to send</span>
          <button type="submit" class="btn btn-primary merlin-send" data-track="merlin:message:submit">Send</button>
        </div>
      </form>`,
    );
    merlinSays('Happy to carry a message to Sam. What’s your name?');
    agent?.play('Write');
    input().focus();
  };

  const log = () => card.querySelector<HTMLElement>('.merlin-chat-log')!;
  const input = () => card.querySelector<HTMLTextAreaElement>('#merlin-chat-input')!;

  const line = (who: 'merlin' | 'you', text: string) => {
    const p = document.createElement('p');
    p.className = `merlin-chat-${who}`;
    p.textContent = text;
    log().appendChild(p);
    log().scrollTop = log().scrollHeight;
    placeCard();
  };
  const merlinSays = (text: string) => line('merlin', text);

  const prompt = (next: Step) => {
    step = next;
    const field = input();
    field.value = '';
    field.rows = next === 'message' ? 4 : 1;
    field.placeholder = next === 'message' ? 'Your message, and how to reach you' : 'Your name';
    card.querySelector('.merlin-hint')!.textContent = next === 'message' ? 'Enter to send · Shift+Enter for a new line' : 'Enter to send';
    field.focus();
    placeCard();
  };

  const send = async () => {
    step = 'sending';
    merlinSays('Sending it by owl…');
    agent?.play('DoMagic1');
    try {
      const res = await fetch('/api/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...draft,
          website: card.querySelector<HTMLInputElement>('.merlin-hp')!.value,
          session: sessionId(),
        }),
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok || !result.ok) throw new Error(result.error);
      step = 'done';
      merlinSays('Delivered! Sam will read it soon.');
      agent?.play('Congratulate');
      card.querySelector('.merlin-chat-form')!.outerHTML = `<ul class="merlin-options">${option('data-restart', 'Back to the menu')}</ul>`;
      placeCard();
    } catch (err) {
      merlinSays(`My magic fizzled${err instanceof Error && err.message ? `: ${err.message}` : '.'} Press Send to try again.`);
      agent?.play('Sad');
      step = 'message';
      input().value = draft.message;
      input().focus();
    }
  };

  const answer = (value: string) => {
    if (step === 'name') {
      draft.name = value;
      line('you', value);
      merlinSays(`Nice to meet you, ${value}! What would you like to say? If you’d like a reply, include your email or phone number in the message.`);
      prompt('message');
    } else if (step === 'message') {
      draft.message = value;
      line('you', value);
      void send();
    }
  };

  card.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = input().value.trim();
    if (step === 'sending' || step === 'done' || !value) return;
    answer(value);
  });

  card.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return hideCard();
    // Enter sends; Shift+Enter makes a new line in the message.
    if (e.key === 'Enter' && !e.shiftKey && (e.target as HTMLElement).id === 'merlin-chat-input') {
      e.preventDefault();
      card.querySelector<HTMLFormElement>('.merlin-chat-form')?.requestSubmit();
    }
  });

  card.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.merlin-ask-close')) return hideCard();
    if (target.closest('[data-restart]')) return showAsk();
    if (target.closest('[data-joke]')) return tellJoke();
    if (target.closest('[data-punchline]')) return revealPunchline();
    if (target.closest('[data-away]')) return dismiss();
    const focus = target.closest<HTMLButtonElement>('[data-focus]');
    if (focus) return chooseFocus(focus);
    const topic = target.closest<HTMLButtonElement>('[data-ask]')?.dataset.ask;
    if (isTopic(topic)) openTopic(topic);
  });

  addEventListener('resize', placeCard);

  const summon = async () => {
    const a = await load();
    const el = agentEl()!;
    // Appear where the hat was, in the bottom-right corner.
    el.style.left = `${Math.max(8, innerWidth - 128 - 16)}px`;
    el.style.top = `${Math.max(8, innerHeight - 128 - 16)}px`;
    setVisible(true);
    a.show();
    return a;
  };

  // clippyjs's own hide() can leave its animation queue stuck when an animation is running, and
  // he never shows again. So he plays Hide, then is disposed; the next summon builds a fresh one.
  const dismiss = () => {
    hideCard();
    setVisible(false);
    const leaving = agent;
    agent = undefined;
    loading = undefined;
    if (!leaving) return;
    leaving.stop();
    if (!leaving.play('Hide', 3000, () => leaving.dispose())) leaving.dispose();
  };

  const summonAndAsk = async () => {
    const a = await summon();
    a.play('Wave');
    setTimeout(showAsk, 900);
  };

  hat.addEventListener('click', () => void summonAndAsk());

  // Whichever chooser opened the topic, Merlin answers and points at the first section; for a
  // message he comes out (if hidden) and starts the chat.
  const reactions: Record<Topic, string> = {
    professional: 'Explain',
    personal: 'Think',
    family: 'Pleased',
    adventure: 'DoMagic1',
    message: 'Write',
  };

  document.addEventListener('topic:open', async (e) => {
    const { topic, target } = (e as CustomEvent<{ topic: Topic; target: HTMLElement | null }>).detail;
    if (topic === 'message') {
      if (visible) agent?.stop();
      else await summon();
      showChat();
      return;
    }
    if (!visible || !agent) return;
    agent.stop();
    say(TOPICS[topic].reply);
    agent.play(reactions[topic]);
    if (target) {
      // Point once the smooth scroll has settled.
      setTimeout(() => {
        const r = target.getBoundingClientRect();
        agent?.gestureAt(r.left + 40, r.top + 24);
      }, 700);
    }
  });

  // A card in parts (the homepage's Spirituality card) asks, the first time it opens, which part
  // the visitor came for: he comes out if hidden and asks, and the answer narrows the card.
  let focusCard = '';
  document.addEventListener('merlin:ask-focus', async (e) => {
    const { card: cardId, question, options } = (e as CustomEvent<{ card: string; question: string; options: { id: string; label: string }[] }>).detail;
    focusCard = cardId;
    const ask = () => {
      frame(
        'Merlin asks which part you came for',
        `<p class="merlin-say">${esc(question)}</p>
        <ul class="merlin-options">
          ${options.map((o) => option(`data-focus="${esc(o.id)}" data-track="merlin:focus:${esc(o.id)}"`, o.label)).join('')}
          ${option('data-focus="" data-track="merlin:focus:all"', 'All of it', 'is-aside')}
        </ul>`,
      );
      live.textContent = `Merlin asks: ${question}`;
      card.querySelector<HTMLButtonElement>('.merlin-option')?.focus({ preventScroll: true });
    };
    if (visible && agent) {
      agent.stop();
      agent.play('Think');
      ask();
    } else {
      const a = await summon();
      a.play('Wave');
      setTimeout(ask, 900);
    }
  });

  const chooseFocus = (button: HTMLButtonElement) => {
    const id = button.dataset.focus ?? '';
    document.dispatchEvent(new CustomEvent('merlin:focus', { detail: { card: focusCard, id } }));
    say(id ? `${button.textContent!.replace('→', '').trim()} it is.` : 'All of it, then.');
    agent?.stop();
    agent?.play('Pleased');
    // His work done, he goes back to his hat, unless the visitor has moved on to something else.
    const said = card.innerHTML;
    setTimeout(() => {
      if (visible && !card.hidden && card.innerHTML === said) dismiss();
    }, 2200);
  };

  // Point at every click outside Merlin and his controls.
  const marker = (x: number, y: number) => {
    const dot = document.createElement('span');
    dot.className = 'merlin-target vivify popIn';
    dot.style.left = `${x}px`;
    dot.style.top = `${y}px`;
    document.body.appendChild(dot);
    setTimeout(() => dot.classList.replace('popIn', 'fadeOut'), 700);
    setTimeout(() => dot.remove(), 1500);
  };

  document.addEventListener('click', (e) => {
    if (!visible || !agent) return;
    const target = e.target as HTMLElement;
    if (target.closest('[data-merlin-ui], [data-merlin-agent]')) return;
    marker(e.pageX, e.pageY);
    agent.stop();
    agent.gestureAt(e.clientX, e.clientY);
  });

  // A click on Merlin (not a drag) brings the question back; after a drag the card follows him.
  let downAt: [number, number] | undefined;
  document.addEventListener('mousedown', (e) => {
    if ((e.target as HTMLElement).closest('[data-merlin-agent]')) downAt = [e.clientX, e.clientY];
  });
  document.addEventListener('mouseup', (e) => {
    if (!downAt) return;
    const moved = Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 4;
    downAt = undefined;
    if (moved) setTimeout(placeCard, 20);
    else if (card.hidden) showAsk();
  });
</script>

<style is:global>
  .merlin-hat {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 10003;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.25));
    transition: transform 0.2s;
  }

  .merlin-hat[hidden] {
    display: none;
  }

  .merlin-hat img {
    display: block;
    width: 64px;
    height: auto;
  }

  .merlin-hat:hover,
  .merlin-hat:focus-visible {
    transform: rotate(-8deg) scale(1.08);
  }

  .merlin-hat:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius, 3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .merlin-hat {
      transition: none;
    }
  }

  /* Merlin's card, in the site's system: raised paper, a hairline, one shadow because it floats.
     He says things in Fraunces; the visitor answers in the sans. */
  .merlin-ask {
    position: fixed;
    z-index: 10002;
    width: min(21rem, calc(100vw - 16px));
    padding: var(--s3) var(--s4) var(--s4);
    background: var(--bg-raised);
    color: var(--fg);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .merlin-ask[hidden] {
    display: none;
  }

  .merlin-ask.is-in {
    animation: merlin-in var(--fast) var(--ease);
  }

  @keyframes merlin-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .merlin-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s2);
  }

  /* His name, with a square of Beach: the last trace of the yellow balloon. */
  .merlin-name {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .merlin-name::before {
    content: '';
    width: 0.6em;
    height: 0.6em;
    background: var(--beach);
  }

  .merlin-ask .merlin-ask-close {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin: -0.25rem -0.4rem 0 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1;
  }

  .merlin-ask .merlin-ask-close:hover,
  .merlin-ask .merlin-ask-close:focus-visible {
    color: var(--fg);
  }

  .merlin-say {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
  }

  .merlin-say.is-muted {
    color: var(--muted);
    font-size: var(--text-base);
  }

  .merlin-punchline {
    margin-top: var(--s2);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  /* ---- Options: rows on hairlines ------------------------------------------------------ */

  .merlin-options {
    list-style: none;
    margin: var(--s3) 0 0;
    padding: 0;
  }

  .merlin-options li + li {
    border-top: var(--hairline);
  }

  .merlin-option {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    padding: var(--s2) 0;
    border: 0;
    background: none;
    color: var(--fg);
    font-weight: 500;
    text-align: left;
    transition: color var(--fast) var(--ease);
  }

  .merlin-option .arrow {
    color: var(--faint);
    transition: transform var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .merlin-option:hover,
  .merlin-option:focus-visible {
    color: var(--accent-text);
  }

  .merlin-option:hover .arrow,
  .merlin-option:focus-visible .arrow {
    color: var(--accent-text);
    transform: translateX(0.2em);
  }

  .merlin-option:focus-visible {
    outline-offset: 0;
  }

  .merlin-options li:has(.is-aside) {
    margin-top: var(--s2);
    border-top-color: var(--rule-strong);
  }

  .merlin-option.is-aside {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--muted);
  }

  .merlin-foot {
    margin-top: var(--s3);
    padding-top: var(--s2);
    border-top: var(--hairline);
    text-align: right;
  }

  .merlin-ask .merlin-away {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: var(--text-xs);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.18em;
  }

  .merlin-ask .merlin-away:hover,
  .merlin-ask .merlin-away:focus-visible {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }

  /* ---- The message chat ---------------------------------------------------------------- */

  .merlin-chat-log {
    display: grid;
    gap: var(--s2);
    max-height: 15rem;
    overflow-y: auto;
  }

