---
// Merlin, the original Microsoft Agent character, played from his own sprite sheet
// and frame data via clippyjs. Vivify supplies the CSS effects around him.
import '../styles/vivify-subset.css';

const moves = [
  ['Wave', 'Wave'],
  ['Greet', 'Greet'],
  ['DoMagic1', 'Magic'],
  ['Congratulate', 'Congratulate'],
  ['Think', 'Think'],
  ['Read', 'Read'],
  ['Searching', 'Search'],
  ['Surprised', 'Surprised'],
  ['Confused', 'Confused'],
  ['Announce', 'Announce'],
];
---

<div class="merlin-ui" data-merlin-ui>
  <button type="button" class="merlin-toggle" data-merlin-toggle aria-pressed="false">Summon Merlin</button>
  <div class="merlin-moves" data-merlin-moves hidden>
    {
      moves.map(([anim, label]) => (
        <button type="button" data-anim={anim}>
          {label}
        </button>
      ))
    }
  </div>
  <p class="merlin-hint">Click anywhere and he’ll point. Click him to ask again.</p>
  <p class="sr-only" aria-live="polite" data-merlin-live></p>
</div>

<script>
  import { initAgent } from 'clippyjs';
  import MerlinLoaders from 'clippyjs/agents/merlin';
  import { TOPICS, isTopic, openTopic, type Topic } from '../scripts/topics';

  type Agent = Awaited<ReturnType<typeof initAgent>>;

  const STORAGE_KEY = 'merlin:dismissed';
  const ui = document.querySelector<HTMLElement>('[data-merlin-ui]')!;
  const toggle = ui.querySelector<HTMLButtonElement>('[data-merlin-toggle]')!;
  const movesEl = ui.querySelector<HTMLElement>('[data-merlin-moves]')!;
  const live = ui.querySelector<HTMLElement>('[data-merlin-live]')!;

  let agent: Agent | undefined;
  let loading: Promise<Agent> | undefined;
  let visible = false;

  const load = () =>
    (loading ??= initAgent({
      agent: MerlinLoaders.agent,
      // The sprite sheet ships as a cacheable PNG instead of a 1.4 MB base64 module.
      map: async () => ({ default: '/merlin/map.png' }),
      // Silent: no sounds on a web page unless asked for.
      sound: async () => ({ default: {} }),
    } as Parameters<typeof initAgent>[0]).then((a) => {
      agent = a;
      const el = (a as unknown as { _el: HTMLElement })._el;
      el.setAttribute('role', 'img');
      el.setAttribute('aria-label', 'Merlin the wizard');
      el.dataset.merlinAgent = '';
      return a;
    }));

  const say = (text: string) => {
    agent?.speak(text);
    live.textContent = text;
  };

  const setVisible = (on: boolean) => {
    visible = on;
    toggle.setAttribute('aria-pressed', String(on));
    toggle.textContent = on ? 'Dismiss Merlin' : 'Summon Merlin';
    movesEl.hidden = !on;
    if (on) movesEl.classList.add('vivify', 'fadeInBottom');
    try {
      on ? localStorage.removeItem(STORAGE_KEY) : localStorage.setItem(STORAGE_KEY, '1');
    } catch {}
  };

  // Merlin's question: a balloon-styled card beside him with one button per topic.
  const agentEl = () => (agent as unknown as { _el: HTMLElement } | undefined)?._el;

  const ask = document.createElement('div');
  ask.className = 'merlin-ask';
  ask.dataset.merlinUi = '';
  ask.setAttribute('role', 'dialog');
  ask.setAttribute('aria-label', 'Merlin asks what you are interested in');
  ask.hidden = true;
  ask.innerHTML = `
    <button type="button" class="merlin-ask-close" aria-label="Close">×</button>
    <p>Hi! What are you interested in?</p>
    <div class="merlin-ask-options">
      ${Object.entries(TOPICS)
        .map(([key, { label }]) => `<button type="button" data-ask="${key}">${label}</button>`)
        .join('')}
    </div>`;
  document.body.appendChild(ask);

  const placeAsk = () => {
    const el = agentEl();
    if (!el || ask.hidden) return;
    const r = el.getBoundingClientRect();
    const w = ask.offsetWidth;
    const h = ask.offsetHeight;
    const left = Math.min(Math.max(8, r.right - w), innerWidth - w - 8);
    const above = r.top - h - 8;
    ask.style.left = `${left}px`;
    ask.style.top = `${above >= 8 ? above : Math.min(r.bottom + 8, innerHeight - h - 8)}px`;
  };

  const showAsk = () => {
    agent?.closeBalloon();
    ask.hidden = false;
    ask.classList.remove('popIn');
    void ask.offsetWidth;
    ask.classList.add('vivify', 'popIn');
    placeAsk();
    live.textContent = 'Merlin asks: what are you interested in?';
  };

  const hideAsk = () => {
    ask.hidden = true;
  };

  ask.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.merlin-ask-close')) return hideAsk();
    const topic = target.closest<HTMLButtonElement>('[data-ask]')?.dataset.ask;
    if (isTopic(topic)) openTopic(topic);
  });

  addEventListener('resize', placeAsk);

  // Whichever chooser opened the topic, Merlin answers and points at the first section.
  const reactions: Record<Topic, string> = {
    professional: 'Explain',
    personal: 'Think',
    family: 'Pleased',
    adventure: 'DoMagic1',
    message: 'Write',
  };

  document.addEventListener('topic:open', (e) => {
    const { topic, target } = (e as CustomEvent<{ topic: Topic; target: HTMLElement | null }>).detail;
    hideAsk();
    if (!visible || !agent) return;
    agent.stop();
    say(TOPICS[topic].reply);
    agent.play(reactions[topic]);
    if (target) {
      // Point once the smooth scroll has settled.
      setTimeout(() => {
        const r = target.getBoundingClientRect();
        agent?.gestureAt(r.left + 40, r.top + 24);
      }, 700);
    }
  });

  const summon = async (greet = true) => {
    const a = await load();
    setVisible(true);
    a.show();
    if (greet) {
      a.play('Wave');
      setTimeout(showAsk, 900);
    }
  };

  const dismiss = () => {
    hideAsk();
    agent?.stop();
    agent?.hide();
    setVisible(false);
  };

  // A click on Merlin (not a drag) asks again; letting go after a drag moves the card with him.
  let downAt: [number, number] | undefined;
  document.addEventListener('mousedown', (e) => {
    if ((e.target as HTMLElement).closest('[data-merlin-agent]')) downAt = [e.clientX, e.clientY];
  });
  document.addEventListener('mouseup', (e) => {
    if (!downAt) return;
    const moved = Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 4;
    downAt = undefined;
    if (moved) setTimeout(placeAsk, 20);
    else ask.hidden ? showAsk() : hideAsk();
  });

  toggle.addEventListener('click', () => (visible ? dismiss() : summon()));

  movesEl.addEventListener('click', (e) => {
    const anim = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-anim]')?.dataset.anim;
    if (!anim || !agent) return;
    agent.stop();
    agent.play(anim);
  });

  // Point at every click outside Merlin and his controls.
  const marker = (x: number, y: number) => {
    const dot = document.createElement('span');
    dot.className = 'merlin-target vivify popIn';
    dot.style.left = `${x}px`;
    dot.style.top = `${y}px`;
    document.body.appendChild(dot);
    setTimeout(() => dot.classList.replace('popIn', 'fadeOut'), 700);
    setTimeout(() => dot.remove(), 1500);
  };

  document.addEventListener('click', (e) => {
    if (!visible || !agent) return;
    const target = e.target as HTMLElement;
    // Topic choosers get Merlin's answer (topic:open) instead of a point.
    if (target.closest('[data-merlin-ui], [data-merlin-agent], [data-topic]')) return;
    marker(e.pageX, e.pageY);
    agent.stop();
    agent.gestureAt(e.clientX, e.clientY);
  });

  // Appear on his own once the page is idle, unless dismissed before or motion is reduced.
  let dismissed = false;
  try {
    dismissed = localStorage.getItem(STORAGE_KEY) === '1';
  } catch {}
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!dismissed && !reduced) {
    const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1200));
    addEventListener('load', () => idle(() => summon()), { once: true });
  }
</script>

<style is:global>
  .merlin-ui {
    margin-top: 1.25rem;
  }

  .merlin-ui button {
    font: inherit;
    font-size: 0.8125rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }

  .merlin-ui button:hover,
  .merlin-ui button:focus-visible {
    border-color: currentColor;
  }

  .merlin-toggle {
    font-weight: 600;
  }

  .merlin-moves {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .merlin-moves[hidden] {
    display: none;
  }

  .text .merlin-hint {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Styled after Merlin's own speech balloon. */
  .merlin-ask {
    position: fixed;
    z-index: 10002;
    width: min(18rem, calc(100vw - 16px));
    padding: 0.75rem 0.85rem 0.85rem;
    background: #ffc;
    color: #000;
    border: 1px solid #000;
    border-radius: 6px;
    font: 0.875rem/1.4 'Microsoft Sans Serif', Tahoma, system-ui, sans-serif;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.15);
  }

  .merlin-ask[hidden] {
    display: none;
  }

  .merlin-ask p {
    margin: 0 1.5rem 0.6rem 0;
    font-weight: 600;
  }

  .merlin-ask-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .merlin-ask button {
    font: inherit;
    color: #000;
    background: #fff;
    border: 1px solid #000;
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  .merlin-ask button:hover,
  .merlin-ask button:focus-visible {
    background: #000;
    color: #ffc;
  }

  .merlin-ask .merlin-ask-close {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    line-height: 1;
    border: none;
    background: transparent;
    font-size: 1.1rem;
  }

  .merlin-target {
    position: absolute;
    z-index: 10000;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border: 2px solid #4338ca;
    border-radius: 50%;
    background: rgb(67 56 202 / 0.15);
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
