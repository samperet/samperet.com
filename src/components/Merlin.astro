---
// Merlin, the original Microsoft Agent character, played from his own sprite sheet and frame
// data via clippyjs. He waits behind a wizard-hat button in the corner; summoned, he asks what
// the visitor is looking for: typed (a place he takes them to, or a question answered through
// Claude at /api/ask), or one of the topics (src/scripts/topics.ts); he also takes a message for
// Sam (/api/message) and tells jokes. Everything he says is in one card styled by the design
// system; Vivify supplies the click marker.
import '../styles/vivify-subset.css';
import { PLACES } from '../lib/knowledge';

// The places he can take a visitor, for instant matches without a round trip.
const places = JSON.stringify(PLACES).replace(/</g, '\\u003c');
---

<p class="sr-only" aria-live="polite" data-merlin-ui data-merlin-live></p>
<script is:inline type="application/json" id="merlin-places" set:html={places}></script>

<script>
  import { initAgent } from 'clippyjs';
  import MerlinLoaders from 'clippyjs/agents/merlin';
  import { TOPICS, isTopic, openTopic, type Topic } from '../scripts/topics';
  import { sessionId } from '../scripts/track';

  type Agent = Awaited<ReturnType<typeof initAgent>>;

  const live = document.querySelector<HTMLElement>('[data-merlin-live]')!;

  let agent: Agent | undefined;
  let loading: Promise<Agent> | undefined;
  let visible = false;

  const agentEl = () => (agent as unknown as { _el: HTMLElement } | undefined)?._el;

  const load = () =>
    (loading ??= initAgent({
      agent: MerlinLoaders.agent,
      // The sprite sheet ships as a cacheable PNG instead of a 1.4 MB base64 module.
      map: async () => ({ default: '/merlin/map.png' }),
      // Silent: no sounds on a web page unless asked for.
      sound: async () => ({ default: {} }),
    } as Parameters<typeof initAgent>[0]).then((a) => {
      agent = a;
      const el = agentEl()!;
      el.setAttribute('role', 'img');
      el.setAttribute('aria-label', 'Merlin the wizard');
      el.dataset.merlinAgent = '';
      el.dataset.track = 'merlin:character';
      return a;
    }));

  // The wizard hat: Merlin's hiding place, bottom right, on every visit.
  const hat = document.createElement('button');
  hat.type = 'button';
  hat.className = 'merlin-hat';
  hat.dataset.merlinUi = '';
  hat.dataset.track = 'merlin:hat';
  hat.setAttribute('aria-label', 'Summon Merlin');
  hat.innerHTML = '<img src="/merlin/hat.webp" alt="" width="64" height="63" />';
  document.body.appendChild(hat);

  const setVisible = (on: boolean) => {
    visible = on;
    // The hat is where he hides: it disappears while he's out and comes back when he leaves.
    hat.hidden = on;
  };

  // Merlin's card: one panel beside him for everything he says, asks and takes down. It follows
  // the site's design system (/branding/); his own yellow clippyjs balloon is never used.
  const card = document.createElement('div');
  card.className = 'merlin-ask';
  card.dataset.merlinUi = '';
  card.setAttribute('role', 'dialog');
  card.hidden = true;
  document.body.appendChild(card);

  const placeCard = () => {
    const el = agentEl();
    if (!el || card.hidden) return;
    const r = el.getBoundingClientRect();
    const w = card.offsetWidth;
    const h = card.offsetHeight;
    const left = Math.min(Math.max(8, r.right - w), innerWidth - w - 8);
    const above = r.top - h - 12;
    card.style.left = `${left}px`;
    card.style.top = `${above >= 8 ? above : Math.min(r.bottom + 12, innerHeight - h - 8)}px`;
  };

  // The card fades up once when it opens, because the visitor asked for it; after that its
  // contents change in place.
  const popCard = () => {
    agent?.closeBalloon();
    const opening = card.hidden;
    card.hidden = false;
    if (opening) {
      card.classList.remove('is-in');
      void card.offsetWidth;
      card.classList.add('is-in');
    }
    placeCard();
  };

  const hideCard = () => {
    card.hidden = true;
  };

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => `&${({ '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot' } as Record<string, string>)[c]};`);

  // Every view is the same frame: the body, then a foot with a way to send him back to his hat
  // and the close button beside it.
  const frame = (label: string, body: string) => {
    card.setAttribute('aria-label', label);
    card.innerHTML = `
      <div class="merlin-body">${body}</div>
      <footer class="merlin-foot">
        <button type="button" class="merlin-away" data-away data-track="merlin:away" aria-label="Silencio: send Merlin back to his hat">Silencio</button>
        <button type="button" class="merlin-ask-close" aria-label="Close">×</button>
      </footer>`;
    popCard();
  };

  // A choice is a row: label on the left, an arrow that steps right on hover. Never a pill.
  const option = (attrs: string, label: string, kind = '') =>
    `<li><button type="button" class="merlin-option ${kind}" ${attrs}><span>${esc(label)}</span><span class="arrow" aria-hidden="true">→</span></button></li>`;

  // His menu: a line to type into first (a question, or the name of a place), then the topics.
  const finePointer = () => matchMedia('(pointer: fine)').matches;
  const askForm = (placeholder: string, back: boolean) => `
    <form class="merlin-chat-form merlin-ask-form">
      <label class="sr-only" for="merlin-ask-input">Your question or request</label>
      <textarea id="merlin-ask-input" rows="${back ? 2 : 1}" maxlength="500" required placeholder="${placeholder}"></textarea>
      <div class="merlin-chat-actions">
        ${back ? '<button type="button" class="merlin-back" data-restart>Back to the menu</button>' : '<span class="merlin-hint">Enter to ask</span>'}
        <button type="submit" class="btn btn-primary merlin-send" data-track="merlin:ask:submit">Ask</button>
      </div>
    </form>`;

  const showAsk = () => {
    frame(
      'Merlin asks what you are looking for',
      `<p class="merlin-say">What are you looking for?</p>
      ${askForm('Ask me anything, or name a place', false)}
      <ul class="merlin-options">
        ${Object.entries(TOPICS)
          .map(([key, { label }]) => option(`data-ask="${key}" data-track="merlin:topic:${key}"`, label))
          .join('')}
        ${option('data-joke data-track="merlin:joke"', 'Tell me a joke', 'is-aside')}
      </ul>`,
    );
    live.textContent = 'Merlin asks: what are you looking for?';
    if (finePointer()) askInput().focus({ preventScroll: true });
  };

  // What he says after a choice, in the card rather than his old balloon.
  const say = (text: string) => {
    frame(
      'Merlin',
      `<p class="merlin-say">${esc(text)}</p>
      <ul class="merlin-options">${option('data-restart', 'Something else')}</ul>`,
    );
    live.textContent = text;
  };

  // A few jokes, told setup first; the punchline waits for the visitor. They come round in a
  // shuffled order so nobody hears the same one twice in a row.
  const JOKES = [
    { setup: 'What’s a wizard’s favorite subject in school?', prompt: 'I give up', punchline: 'Spelling!' },
    { setup: 'What do you call a wizard from outer space?', prompt: 'Tell me', punchline: 'A flying sorcerer.' },
    { setup: 'How many wizards does it take to change a light bulb?', prompt: 'How many?', punchline: 'Depends what you want it changed into.' },
    { setup: 'Why do programmers prefer dark mode?', prompt: 'Why?', punchline: 'Because light attracts bugs.' },
    { setup: 'Why did the programmer quit his job?', prompt: 'Why?', punchline: 'He didn’t get arrays.' },
    { setup: 'There are 10 kinds of people in the world…', prompt: 'Go on', punchline: 'Those who understand binary, and those who don’t.' },
  ];
  let jokeOrder: number[] = [];
  let lastJoke = -1;
  const nextJoke = () => {
    if (!jokeOrder.length) {
      jokeOrder = JOKES.map((_, i) => i).sort(() => Math.random() - 0.5);
      if (jokeOrder[0] === lastJoke) jokeOrder.push(jokeOrder.shift()!);
    }
    return (lastJoke = jokeOrder.shift()!);
  };

  const tellJoke = () => {
    const i = nextJoke();
    const joke = JOKES[i];
    frame(
      'Merlin tells a joke',
      `<p class="merlin-say">${esc(joke.setup)}</p>
      <ul class="merlin-options">${option(`data-punchline data-track="merlin:joke:${i}:reveal"`, joke.prompt)}</ul>`,
    );
    live.textContent = joke.setup;
    agent?.stop();
    agent?.play('Explain');
    card.querySelector<HTMLButtonElement>('[data-punchline]')!.focus({ preventScroll: true });
  };

  const revealPunchline = () => {
    const joke = JOKES[lastJoke];
    frame(
      'Merlin tells a joke',
      `<p class="merlin-say is-muted">${esc(joke.setup)}</p>
      <p class="merlin-punchline">${esc(joke.punchline)}</p>
      <ul class="merlin-options">
        ${option('data-joke data-track="merlin:joke:another"', 'Another one')}
        ${option('data-restart', 'Back to the menu')}
      </ul>`,
    );
    live.textContent = joke.punchline;
    agent?.stop();
    agent?.play(['Pleased', 'Congratulate', 'Surprised'][Math.floor(Math.random() * 3)]);
    card.querySelector<HTMLButtonElement>('[data-joke]')!.focus({ preventScroll: true });
  };

  // The message chat: name, then the message, with a reminder to include a way to reply.
  type Step = 'name' | 'message' | 'sending' | 'done';
  let step: Step = 'name';
  const draft = { name: '', message: '' };

  const showChat = () => {
    step = 'name';
    draft.name = draft.message = '';
    frame(
      'Send Sam a message through Merlin',
      `<div class="merlin-chat-log" aria-live="polite"></div>
      <form class="merlin-chat-form">
        <label class="sr-only" for="merlin-chat-input">Your reply</label>
        <textarea id="merlin-chat-input" rows="1" maxlength="4000" required placeholder="Your name"></textarea>
        <input class="merlin-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="merlin-chat-actions">
          <span class="merlin-hint">Enter to send</span>
          <button type="submit" class="btn btn-primary merlin-send" data-track="merlin:message:submit">Send</button>
        </div>
      </form>`,
    );
    merlinSays('Happy to carry a message to Sam. What’s your name?');
    agent?.play('Write');
    input().focus();
  };

  const log = () => card.querySelector<HTMLElement>('.merlin-chat-log')!;
  const input = () => card.querySelector<HTMLTextAreaElement>('#merlin-chat-input')!;

  // The log keeps to its newest line; once it scrolls, its top edge fades out.
  const scrollLog = () => {
    const el = log();
    el.scrollTop = el.scrollHeight;
    el.classList.toggle('is-scrolled', el.scrollTop > 0);
  };
  card.addEventListener(
    'scroll',
    (e) => {
      const el = e.target as HTMLElement;
      if (el.classList?.contains('merlin-chat-log')) el.classList.toggle('is-scrolled', el.scrollTop > 0);
    },
    true,
  );

  const line = (who: 'merlin' | 'you', text: string) => {
    const p = document.createElement('p');
    p.className = `merlin-chat-${who}`;
    p.textContent = text;
    log().appendChild(p);
    scrollLog();
    placeCard();
  };
  const merlinSays = (text: string) => line('merlin', text);

  // Typed questions and requests. A short request that names a place ("photos", "career",
  // "heartwise") goes there at once, from the places the build gives this page (PLACES in
  // src/lib/knowledge.ts). Anything else goes to Claude (/api/ask), whose reply also says where
  // to take the visitor. A place on this page opens as he speaks; a place on another page gets a
  // "Take me there" button, and the conversation carries on when they arrive (it is kept in
  // sessionStorage for the visit, and the last few turns go along with each question). Links
  // inside an answer: only the site's own paths and a few known sites.
  type Turn = { role: 'user' | 'assistant'; text: string };
  type Place = { path: string; title: string; within?: string; words?: string };
  const PLACES: Place[] = JSON.parse(document.getElementById('merlin-places')?.textContent || '[]');
  const STORE = 'merlin:chat';
  const saved: { convo?: Turn[]; resume?: { path: string; title: string } } = (() => {
    try {
      return JSON.parse(sessionStorage.getItem(STORE) || '{}');
    } catch {
      return {};
    }
  })();
  const convo: Turn[] = Array.isArray(saved.convo) ? saved.convo.slice(-12) : [];
  const keep = (resume?: { path: string; title: string }) => {
    try {
      sessionStorage.setItem(STORE, JSON.stringify({ convo: convo.slice(-12), resume }));
    } catch {
      /* private mode: the conversation lasts as long as the page */
    }
  };
  let asking = false;
  const SUGGESTIONS = ['What does Sam do?', 'Show me photos from Airbnb', 'How do I join the men’s group?'];
  const LINKABLE = /^(?:\/(?!\/)|https:\/\/(?:[a-z0-9-]+\.)*(?:samperet\.com|getheartwise\.com|intelligentembodiment\.com|samasangha\.org|jayaandfiona\.com|openlibrary\.org|substack\.com|acadialps\.com|fuseanalytics\.com)(?:[\/?#]|$)|https:\/\/(?:www\.)?(?:github\.com\/samperet|linkedin\.com\/in\/samperet)\b)/i;
  const askInput = () => card.querySelector<HTMLTextAreaElement>('#merlin-ask-input')!;

  const answerLine = (text: string) => {
    const p = document.createElement('p');
    p.className = 'merlin-chat-merlin';
    const clean = text.replace(/\*\*([^*]+)\*\*/g, '$1');
    let last = 0;
    for (const m of clean.matchAll(/\[([^\]]+)\]\(([^)\s]+)\)/g)) {
      p.append(clean.slice(last, m.index));
      if (LINKABLE.test(m[2])) {
        const a = document.createElement('a');
        a.href = m[2];
        a.textContent = m[1];
        a.dataset.track = 'merlin:ask:link';
        if (/^https?:/.test(m[2]) && !/^https:\/\/samperet\.com/.test(m[2])) a.target = '_blank';
        p.append(a);
      } else p.append(m[1]);
      last = m.index! + m[0].length;
    }
    p.append(clean.slice(last));
    log().appendChild(p);
    scrollLog();
    placeCard();
    return p;
  };

  // A choice under an answer (to another page, or to the message form): a row with an arrow,
  // like his menu, so the card's one button stays the one that sends.
  const answerButton = (p: HTMLElement, label: string, attrs: Record<string, string>, href?: string, arrow = '→') => {
    const el = document.createElement(href ? 'a' : 'button');
    el.className = 'merlin-option merlin-go';
    if (href) (el as HTMLAnchorElement).href = href;
    else (el as HTMLButtonElement).type = 'button';
    Object.assign(el.dataset, attrs);
    el.innerHTML = `<span>${esc(label)}</span><span class="arrow" aria-hidden="true">${arrow}</span>`;
    p.after(el);
    scrollLog();
    placeCard();
    return el;
  };

  // The best place for a short request, or none: every word must belong to the place (its title,
  // other names, or the card it sits in); titles that hold the words win, then the fewest extras.
  const norm = (t: string) => t.toLowerCase().replace(/['’]/g, '').replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').trim();
  const FILLER = new Set('show me take to go open the a an please page card section see i want would like can you let lets look at find view bring up get hey hi merlin and of in on for my sams sam'.split(' '));
  const quickPlace = (q: string) => {
    const words = norm(q).split(' ').filter((w) => w && !FILLER.has(w));
    if (!words.length || words.length > 3) return undefined;
    let best: Place | undefined;
    let bestHits = -1;
    let bestExtra = Infinity;
    for (const place of PLACES) {
      const own = norm(place.title).split(' ').filter((w) => w && !FILLER.has(w));
      const ownSet = new Set(own);
      const hay = new Set([...own, ...norm(place.words ?? '').split(' '), ...norm(place.within ?? '').split(' ')]);
      const within = (set: Set<string>, w: string) => set.has(w) || set.has(`${w}s`) || set.has(w.replace(/s$/, ''));
      if (!words.every((w) => within(hay, w))) continue;
      const hits = words.filter((w) => within(ownSet, w)).length;
      const extra = own.filter((w) => !words.includes(w)).length + (place.within ? 1 : 0);
      if (hits > bestHits || (hits === bestHits && extra < bestExtra)) {
        best = place;
        bestHits = hits;
        bestExtra = extra;
      }
    }
    return best;
  };

  // How he names a place he opens: the photo groups and career chapters say where they are.
  const hereIs = (place: { title: string; within?: string }) => {
    const title = place.title.replace(/^Get /, '');
    if (place.within === 'Photos') return `Here are the photos from ${title}.`;
    if (place.within === 'Career') return `Here’s ${title}, on Sam’s career page.`;
    return `Here’s ${title}.`;
  };

  // Takes the visitor to a place: on this page at once (a homepage card opens through its #hash),
  // elsewhere through a button under his answer.
  const goHere = (url: URL) => {
    if (url.hash) {
      history.replaceState(null, '', url.hash);
      dispatchEvent(new HashChangeEvent('hashchange'));
      if (location.pathname !== '/') document.getElementById(decodeURIComponent(url.hash.slice(1)))?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(placeCard, 500);
  };
  const takeTo = (place: { path: string; title: string }, p: HTMLElement) => {
    const url = new URL(place.path, location.href);
    if (url.origin === location.origin && url.pathname === location.pathname) return goHere(url);
    const away = url.origin !== location.origin;
    const button = answerButton(p, 'Take me there', { track: 'merlin:go' }, place.path, away ? '↗' : '→');
    button.addEventListener('click', () => keep(away ? undefined : { path: place.path, title: place.title }));
    button.focus({ preventScroll: true });
  };

  const showQuestions = (first?: string) => {
    frame(
      'Ask Merlin about Sam and this site',
      `<div class="merlin-chat-log" aria-live="polite"></div>
      ${convo.length || first ? '' : `<ul class="merlin-options merlin-suggest">${SUGGESTIONS.map((q) => option('data-suggest data-track="merlin:ask:suggested"', q)).join('')}</ul>`}
      ${askForm('Ask about Sam or the site', true)}`,
    );
    if (!convo.length && !first) merlinSays('Ask me anything about Sam or this site, or name a place, and I’ll take you there.');
    for (const turn of convo) turn.role === 'user' ? line('you', turn.text) : answerLine(turn.text);
    if (first) void ask(first);
    else if (finePointer()) askInput().focus();
  };

  // Where the visitor is: the path, and the card open on the homepage, if any.
  const whereAmI = () => {
    const open = [...document.querySelectorAll<HTMLElement>('details.tile[open]')].pop();
    return location.pathname + (open?.id ? `#${open.id}` : '');
  };

  const ask = async (question: string) => {
    if (asking) return;
    card.querySelector('.merlin-suggest')?.remove();
    line('you', question);

    const place = quickPlace(question);
    if (place) {
      const text = hereIs(place);
      convo.push({ role: 'user', text: question }, { role: 'assistant', text });
      keep();
      takeTo(place, answerLine(text));
      live.textContent = text;
      agent?.stop();
      agent?.play('DoMagic1');
      return;
    }

    asking = true;
    const pending = answerLine('Consulting the crystal ball…');
    pending.classList.add('is-pending');
    const send = card.querySelector<HTMLButtonElement>('.merlin-send');
    if (send) send.disabled = true;
    agent?.stop();
    agent?.play('Think');
    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, history: convo.slice(-6), page: whereAmI(), session: sessionId() }),
      });
      const result = await res.json().catch(() => ({}));
      pending.remove();
      if (!res.ok || !result.ok) throw new Error(result.error || 'My magic fizzled. Try again, or send Sam a message through me.');
      convo.push({ role: 'user', text: question }, { role: 'assistant', text: result.answer });
      keep();
      const p = answerLine(result.answer);
      live.textContent = result.answer;
      agent?.play('Explain');
      if (result.message) answerButton(p, 'Write to Sam', { toMessage: '', track: 'merlin:ask:to-message' });
      if (result.go) takeTo(result.go, p);
    } catch (err) {
      pending.remove();
      // A copy of the site anywhere but samperet.com (the review copy, a saved page) can't reach
      // his crystal ball: he says so, and points to the real site.
      if (!/(^|\.)samperet\.com$|\.vercel\.app$|^localhost$|^127\.0\.0\.1$/.test(location.hostname)) {
        const p = answerLine('I can only answer questions on samperet.com itself.');
        answerButton(p, 'Ask me there', { track: 'merlin:ask:offsite' }, 'https://samperet.com/', '↗');
        asking = false;
        if (send) send.disabled = false;
        return;
      }
      const p = answerLine(err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'My magic fizzled. Try again, or send Sam a message through me.');
      // Still somewhere to go: the closest place by name, if there is one.
      const near = quickPlace(question.split(/\s+/).slice(-3).join(' '));
      if (near) takeTo(near, p);
      answerButton(p, 'Send Sam a message', { toMessage: '' });
      agent?.play('Sad');
    } finally {
      asking = false;
      if (send) send.disabled = false;
      if (finePointer()) card.querySelector<HTMLTextAreaElement>('#merlin-ask-input')?.focus({ preventScroll: true });
    }
  };

  const prompt = (next: Step) => {
    step = next;
    const field = input();
    field.value = '';
    field.rows = next === 'message' ? 4 : 1;
    field.placeholder = next === 'message' ? 'Your message, and how to reach you' : 'Your name';
    card.querySelector('.merlin-hint')!.textContent = next === 'message' ? 'Enter to send · Shift+Enter for a new line' : 'Enter to send';
    field.focus();
    placeCard();
  };

  const send = async () => {
    step = 'sending';
    merlinSays('Sending it by owl…');
    agent?.play('DoMagic1');
    try {
      const res = await fetch('/api/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...draft,
          website: card.querySelector<HTMLInputElement>('.merlin-hp')!.value,
          session: sessionId(),
        }),
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok || !result.ok) throw new Error(result.error);
      step = 'done';
      merlinSays('Delivered! Sam will read it soon.');
      agent?.play('Congratulate');
      card.querySelector('.merlin-chat-form')!.outerHTML = `<ul class="merlin-options">${option('data-restart', 'Back to the menu')}</ul>`;
      placeCard();
    } catch (err) {
      merlinSays(`My magic fizzled${err instanceof Error && err.message ? `: ${err.message}` : '.'} Press Send to try again.`);
      agent?.play('Sad');
      step = 'message';
      input().value = draft.message;
      input().focus();
    }
  };

  const answer = (value: string) => {
    if (step === 'name') {
      draft.name = value;
      line('you', value);
      merlinSays(`Nice to meet you, ${value}! What would you like to say? If you’d like a reply, include your email or phone number in the message.`);
      prompt('message');
    } else if (step === 'message') {
      draft.message = value;
      line('you', value);
      void send();
    }
  };

  card.addEventListener('submit', (e) => {
    e.preventDefault();
    if ((e.target as HTMLElement).classList.contains('merlin-ask-form')) {
      const question = askInput().value.trim();
      if (!question || asking) return;
      askInput().value = '';
      if (card.querySelector('.merlin-chat-log')) void ask(question);
      else showQuestions(question); // typed into his menu: the chat opens with it
      return;
    }
    const value = input().value.trim();
    if (step === 'sending' || step === 'done' || !value) return;
    answer(value);
  });

  card.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return hideCard();
    // Enter sends; Shift+Enter makes a new line in the message.
    if (e.key === 'Enter' && !e.shiftKey && ['merlin-chat-input', 'merlin-ask-input'].includes((e.target as HTMLElement).id)) {
      e.preventDefault();
      (e.target as HTMLElement).closest<HTMLFormElement>('form')?.requestSubmit();
    }
  });

  card.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.merlin-ask-close')) return hideCard();
    if (target.closest('[data-restart]')) return showAsk();
    if (target.closest('[data-question]')) return showQuestions();
    const suggested = target.closest<HTMLButtonElement>('[data-suggest]');
    if (suggested) return void ask(suggested.textContent!.replace('→', '').trim());
    if (target.closest('[data-to-message]')) return showChat();
    if (target.closest('[data-joke]')) return tellJoke();
    if (target.closest('[data-punchline]')) return revealPunchline();
    if (target.closest('[data-away]')) return dismiss();
    const focus = target.closest<HTMLButtonElement>('[data-focus]');
    if (focus) return chooseFocus(focus);
    const topic = target.closest<HTMLButtonElement>('[data-ask]')?.dataset.ask;
    if (isTopic(topic)) openTopic(topic);
  });

  addEventListener('resize', placeCard);

  const summon = async () => {
    const a = await load();
    const el = agentEl()!;
    // Appear where the hat was, in the bottom-right corner.
    el.style.left = `${Math.max(8, innerWidth - 128 - 16)}px`;
    el.style.top = `${Math.max(8, innerHeight - 128 - 16)}px`;
    setVisible(true);
    a.show();
    return a;
  };

  // clippyjs's own hide() can leave its animation queue stuck when an animation is running, and
  // he never shows again. So he plays Hide, then is disposed; the next summon builds a fresh one.
  const dismiss = () => {
    hideCard();
    setVisible(false);
    const leaving = agent;
    agent = undefined;
    loading = undefined;
    if (!leaving) return;
    leaving.stop();
    if (!leaving.play('Hide', 3000, () => leaving.dispose())) leaving.dispose();
  };

  const summonAndAsk = async () => {
    const a = await summon();
    a.play('Wave');
    setTimeout(showAsk, 900);
  };

  hat.addEventListener('click', () => void summonAndAsk());

  // Whichever chooser opened the topic, Merlin answers and points at the first section; for a
  // message he comes out (if hidden) and starts the chat.
  const reactions: Record<Topic, string> = {
    professional: 'Explain',
    personal: 'Think',
    family: 'Pleased',
    adventure: 'DoMagic1',
    message: 'Write',
  };

  document.addEventListener('topic:open', async (e) => {
    const { topic, target } = (e as CustomEvent<{ topic: Topic; target: HTMLElement | null }>).detail;
    if (topic === 'message') {
      if (visible) agent?.stop();
      else await summon();
      showChat();
      return;
    }
    if (!visible || !agent) return;
    agent.stop();
    say(TOPICS[topic].reply);
    agent.play(reactions[topic]);
    if (target) {
      // Point once the smooth scroll has settled.
      setTimeout(() => {
        const r = target.getBoundingClientRect();
        agent?.gestureAt(r.left + 40, r.top + 24);
      }, 700);
    }
  });

  // A card in parts (the homepage's Spirituality card) asks, the first time it opens, which part
  // the visitor came for: he comes out if hidden and asks, and the answer narrows the card.
  let focusCard = '';
  document.addEventListener('merlin:ask-focus', async (e) => {
    const { card: cardId, question, options } = (e as CustomEvent<{ card: string; question: string; options: { id: string; label: string }[] }>).detail;
    focusCard = cardId;
    const ask = () => {
      frame(
        'Merlin asks which part you came for',
        `<p class="merlin-say">${esc(question)}</p>
        <ul class="merlin-options">
          ${options.map((o) => option(`data-focus="${esc(o.id)}" data-track="merlin:focus:${esc(o.id)}"`, o.label)).join('')}
          ${option('data-focus="" data-track="merlin:focus:all"', 'All of it', 'is-aside')}
        </ul>`,
      );
      live.textContent = `Merlin asks: ${question}`;
      card.querySelector<HTMLButtonElement>('.merlin-option')?.focus({ preventScroll: true });
    };
    if (visible && agent) {
      agent.stop();
      agent.play('Think');
      ask();
    } else {
      const a = await summon();
      a.play('Wave');
      setTimeout(ask, 900);
    }
  });

  const chooseFocus = (button: HTMLButtonElement) => {
    const id = button.dataset.focus ?? '';
    document.dispatchEvent(new CustomEvent('merlin:focus', { detail: { card: focusCard, id } }));
    say(id ? `${button.textContent!.replace('→', '').trim()} it is.` : 'All of it, then.');
    agent?.stop();
    agent?.play('Pleased');
    // His work done, he goes back to his hat, unless the visitor has moved on to something else.
    const said = card.innerHTML;
    setTimeout(() => {
      if (visible && !card.hidden && card.innerHTML === said) dismiss();
    }, 2200);
  };

  // Point at every click outside Merlin and his controls.
  const marker = (x: number, y: number) => {
    const dot = document.createElement('span');
    dot.className = 'merlin-target vivify popIn';
    dot.style.left = `${x}px`;
    dot.style.top = `${y}px`;
    document.body.appendChild(dot);
    setTimeout(() => dot.classList.replace('popIn', 'fadeOut'), 700);
    setTimeout(() => dot.remove(), 1500);
  };

  document.addEventListener('click', (e) => {
    if (!visible || !agent) return;
    const target = e.target as HTMLElement;
    if (target.closest('[data-merlin-ui], [data-merlin-agent]')) return;
    marker(e.pageX, e.pageY);
    agent.stop();
    agent.gestureAt(e.clientX, e.clientY);
  });

  // A click on Merlin (not a drag) brings the question back; after a drag the card follows him.
  let downAt: [number, number] | undefined;
  document.addEventListener('mousedown', (e) => {
    if ((e.target as HTMLElement).closest('[data-merlin-agent]')) downAt = [e.clientX, e.clientY];
  });
  document.addEventListener('mouseup', (e) => {
    if (!downAt) return;
    const moved = Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 4;
    downAt = undefined;
    if (moved) setTimeout(placeCard, 20);
    else if (card.hidden) showAsk();
  });

  // Arriving from his "Take me there": he comes out again with the conversation.
  if (saved.resume && new URL(saved.resume.path, location.href).pathname === location.pathname) {
    const { title } = saved.resume;
    keep();
    void summon().then((a) => {
      a.play('Wave');
      setTimeout(() => {
        showQuestions();
        merlinSays(`Here we are: ${title}.`);
      }, 900);
    });
  }
</script>

