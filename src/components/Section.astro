---
// One homepage tile. Closed, it is a picture (or a block of palette colour) with its title over
// it; opened, it spans the whole grid and its story unfolds below the title. A tile with
// `children` holds smaller tiles, and opens for any topic one of its children has. A tile with
// `link` doesn't unfold: it is a link straight to that page. A tile with `parts` is in sections,
// each rendered by this component too (`part`), and can narrow to one of them.

import type { Photo } from '../data/photos';
import Gallery from './Gallery.astro';
import Glimmer from './Glimmer.astro';
import Memories from './Memories.astro';
import Shelf from './Shelf.astro';

export type { Photo };

export type SectionData = {
  name: string;
  topics?: string[]; // which of Merlin's topics open the card (src/scripts/topics.ts)
  line?: string; // one line under the title; a tile may go without
  // The tile's face: a picture, or a palette colour when there is none, with only the title on
  // it. `kind` ("Book", "Project") and `line` describe the tile but aren't shown. A part has none.
  tile?: { kind?: string; src?: string; alt?: string; color?: string; position?: string };
  link?: string; // the page the tile opens directly, in place of unfolding
  // With `link` set to its photo: a told story, played over the photo in the viewer.
  story?: { title: string; audio: string; captions: string };
  body?: string[];
  href?: string;
  // Extra links under the text, and an optional button that opens Merlin's message chat.
  links?: { label: string; href: string }[];
  message?: string;
  // Interests (see src/data/books.ts): a shelf of the books tagged with any of them closes the
  // card, and 'all' shelves every book. A card with parts takes its parts' interests; on a part
  // they say which books stay when the card narrows to it.
  interests?: string[] | 'all';
  // A memories archive: recordings, each with a play button and its transcript to read.
  memories?: { title: string; audio: string; duration: string; transcript: string[] }[];
  embed?: string;
  // How the embed is described to screen readers, and its shape (width / height), when they
  // differ from a live site's.
  embedTitle?: string;
  embedRatio?: string;
  embedAllow?: string; // browser features the embed may use, e.g. clipboard-write
  embedLast?: boolean; // the embed goes at the foot of the card, after everything else
  photos?: Photo[];
  // A linked cover image (a book, a project page): opens its own page, not the viewer.
  cover?: { src: string; alt: string; href: string; label: string; width: number; height: number };
  children?: SectionData[];
  // On a smaller card: a line shown just above it in its parent, starting a new row of cards.
  intro?: string;
  // Big buttons at the foot of the card, in order, each with an optional line above it.
  cta?: { text?: string; label: string; href: string }[];
  // Parts of one card, each under its own heading, with a row of their names at the top that
  // narrows the card to one. With `ask`, Merlin pops up the first time the card opens and asks
  // that question, the parts' names his answers.
  parts?: SectionData[];
  ask?: string;
  id?: string; // the anchor, when not the name's slug
  // A pattern hidden behind the open card, glimmering around the mouse when it is shaken (Glimmer.astro).
  glimmer?: string;
};

type Props = { section: SectionData; child?: boolean; part?: boolean };

const { section, child = false, part = false } = Astro.props;
const { name, tile = {}, link, story, href, links = [], message, memories = [], embed, embedTitle, embedRatio, embedAllow, embedLast = false, body = [], photos = [], cover, children = [], cta = [], parts = [], ask, glimmer } = section;
// Smaller cards sit in rows; a card with an `intro` starts a new row, with its line above.
const rows: { intro?: string; cards: SectionData[] }[] = [];
for (const c of children) {
  if (c.intro || rows.length === 0) rows.push({ intro: c.intro, cards: [c] });
  else rows[rows.length - 1].cards.push(c);
}
// The live site or app a card embeds, wherever the card puts it.
const frame = embed && {
  class: 'embed',
  src: embed,
  title: embedTitle ?? `${name}, live site`,
  style: embedRatio ? `aspect-ratio: ${embedRatio}` : undefined,
  allow: embedAllow,
  loading: 'lazy' as const,
  referrerpolicy: 'strict-origin-when-cross-origin' as const,
  sandbox: 'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox',
};

// Body text may carry inline links written as [words](https://…).
const LINK = /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g;
const inline = (para: string) => {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  for (const m of para.matchAll(LINK)) {
    if (m.index! > last) parts.push({ text: para.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < para.length) parts.push({ text: para.slice(last) });
  return parts;
};

const slug = (value: string) =>
  value.toLowerCase().replace(/['’]/g, '').replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const idOf = (s: SectionData) => s.id ?? slug(s.name);

const topicsOf = (s: SectionData): string[] => [...(s.topics ?? []), ...[...(s.children ?? []), ...(s.parts ?? [])].flatMap(topicsOf)];
const topics = [...new Set(topicsOf(section))];

// The card's shelf: its own interests, or its parts'. A part has none of its own.
const own = section.interests;
const shelf = part ? undefined : (own ?? [...new Set(parts.flatMap((p) => (p.interests === 'all' ? [] : (p.interests ?? []))))]);
const partInterests = Array.isArray(own) ? own.join(' ') : '';

const Heading = child ? 'h4' : 'h3';
const host = href && new URL(href).hostname.replace(/^www\./, '');
const id = idOf(section);
// A card unfolds; a part is a plain section of the card it belongs to.
const Tag = part ? 'section' : 'details';
const attrs = part
  ? { class: 'part', id, 'data-part': id, 'data-title': name, 'data-interests': partInterests, 'aria-labelledby': `${id}-title` }
  : {
      class: ['item', 'tile', child && 'child', children.length > 0 && 'parent', !tile.src && 'is-color'].filter(Boolean).join(' '),
      id,
      'data-topics': topics.join(' '),
      'data-merlin-asks': ask,
      style: tile.color ? `--tile-color: ${tile.color}` : undefined,
    };
---

{link ? (
  <a
    class:list={['item', 'tile', 'tile-link', { child, 'is-color': !tile.src }]}
    id={id}
    href={link}
    data-topics={topics.join(' ')}
    data-track={`tile:go:${id}`}
    data-story-tile={story ? '' : undefined}
    data-story-title={story?.title}
    data-story-audio={story?.audio}
    data-story-captions={story?.captions}
    style={tile.color ? `--tile-color: ${tile.color}` : undefined}
  >
    <span class="tile-face">
      {tile.src && (
        <img
          class="face"
          src={tile.src}
          alt={tile.alt ?? ''}
          loading="lazy"
          decoding="async"
          style={tile.position ? `object-position: ${tile.position}` : undefined}
        />
      )}
      <span class="caption">
        <Heading>{name}</Heading>
      </span>
      <span class="go-mark" aria-hidden="true">{story ? '▶' : link.startsWith('http') ? '↗' : '→'}</span>
    </span>
  </a>
) : (
<Tag {...attrs}>
  {part ? (
    <h4 class="part-title" id={`${id}-title`}>{name}</h4>
  ) : (
    <summary>
      {tile.src && (
        <img
          class="face"
          src={tile.src}
          alt={tile.alt ?? ''}
          loading="lazy"
          decoding="async"
          style={tile.position ? `object-position: ${tile.position}` : undefined}
        />
      )}
      <span class="caption">
        <Heading>{name}</Heading>
      </span>
      <span class="toggle-mark" aria-hidden="true"></span>
    </summary>
  )}
  {glimmer && !part && <Glimmer src={glimmer} />}
  <div class="body">
    {parts.length > 1 && (
      <nav class="part-nav" aria-label={`Show part of ${name}`} data-part-nav hidden>
        <button type="button" data-focus="" aria-pressed="true" data-track={`part:${id}:all`}>All</button>
        {parts.map((p) => (
          <button type="button" data-focus={idOf(p)} aria-pressed="false" data-track={`part:${id}:${idOf(p)}`}>
            {p.name}
          </button>
        ))}
      </nav>
    )}
    {body.length > 0 && (
      <div class="text">
        {body.map((para) => <p>{inline(para).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>)}
      </div>
    )}
    {(host || links.length > 0 || message) && (
      <p class="actions">
        {host && (
          <a class="arrow-link" href={href} data-track={`tile:visit:${id}`}>
            {host} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
        {links.map((l) => (
          <a class="arrow-link" href={l.href} data-track={`tile:link:${id}`}>
            {l.label} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
        {message && (
          <button type="button" class="btn btn-primary" data-message data-track={`tile:message:${id}`}>
            {message}
          </button>
        )}
      </p>
    )}
    {memories.length > 0 && <Memories memories={memories} />}
    {embed && !embedLast && <iframe {...frame} />}
    {cover && (
      <a class="cover" href={cover.href}>
        <img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
        <span class="badge">{cover.label} <span aria-hidden="true">→</span></span>
      </a>
    )}
    {photos.length > 0 && <Gallery photos={photos} />}
    {rows.map((row) => (
      <>
        {row.intro && <p class="children-intro">{row.intro}</p>}
        <div class="tiles children">
          {row.cards.map((c) => <Astro.self section={c} child />)}
        </div>
      </>
    ))}
    {parts.map((p) => <Astro.self section={p} part />)}
    {embed && embedLast && <iframe {...frame} />}
    {cta.length > 0 && (
      <div class="cta">
        {cta.map((c) => (
          <>
            {c.text && <p>{c.text}</p>}
            <a class="btn btn-accent cta-btn" href={c.href} data-track={`tile:cta:${id}`}>
              {c.label} <span aria-hidden="true">{c.href.startsWith('http') ? '↗' : '→'}</span>
            </a>
          </>
        ))}
      </div>
    )}
    {shelf && (shelf === 'all' || shelf.length > 0) && <Shelf interests={shelf} heading={shelf === 'all' ? false : undefined} />}
  </div>
</Tag>
)}

