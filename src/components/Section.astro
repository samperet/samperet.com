---
// One homepage tile. Closed, it is a picture (or a block of palette colour) with its title and
// one line over it; opened, it spans the whole grid and its story unfolds below the picture. A
// tile with `children` holds smaller tiles, and opens for any topic one of its children has. A
// tile with `link` doesn't unfold: it is a link straight to that page.

// A photo may carry Sam's own caption, shown under it in the viewer, or a story: audio told
// over it, with WebVTT captions as subtitles (played by PhotoViewer.astro).
export type Photo = {
  src: string;
  alt: string;
  caption?: string;
  story?: { title: string; audio: string; captions: string };
};

export type SectionData = {
  name: string;
  topics: string[];
  line: string;
  // The tile's face: a picture, or a palette colour when there is none. `kind` is the small
  // label above the title ("Book", "Project").
  tile: { kind: string; src?: string; alt?: string; color?: string; position?: string };
  link?: string; // the page the tile opens directly, in place of unfolding
  body?: string[];
  href?: string;
  // Extra links under the text, and an optional button that opens Merlin's message chat.
  links?: { label: string; href: string }[];
  message?: string;
  // Recommended reading: each cover a little book that opens a touch on hover, linking out.
  books?: { title: string; author: string; cover: string; href: string; width: number; height: number }[];
  // A memories archive: recordings, each with a play button and its transcript to read.
  memories?: { title: string; audio: string; duration: string; transcript: string[] }[];
  embed?: string;
  // How the embed is described to screen readers, and its shape (width / height), when they
  // differ from a live site's.
  embedTitle?: string;
  embedRatio?: string;
  embedAllow?: string; // browser features the embed may use, e.g. clipboard-write
  photos?: Photo[];
  // A linked cover image (a book, a project page): opens its own page, not the viewer.
  cover?: { src: string; alt: string; href: string; label: string; width: number; height: number };
  children?: SectionData[];
};

type Props = { section: SectionData; child?: boolean };

const { section, child = false } = Astro.props;
const { name, line, tile, link, href, links = [], message, books = [], memories = [], embed, embedTitle, embedRatio, embedAllow, body = [], photos = [], cover, children = [] } = section;

// Body text may carry inline links written as [words](https://…).
const LINK = /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g;
const inline = (para: string) => {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  for (const m of para.matchAll(LINK)) {
    if (m.index! > last) parts.push({ text: para.slice(last, m.index) });
    parts.push({ text: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  if (last < para.length) parts.push({ text: para.slice(last) });
  return parts;
};

const slug = (value: string) =>
  value.toLowerCase().replace(/['’]/g, '').replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const topicsOf = (s: SectionData): string[] => [...s.topics, ...(s.children ?? []).flatMap(topicsOf)];
const topics = [...new Set(topicsOf(section))];

const Heading = child ? 'h4' : 'h3';
const host = href && new URL(href).hostname.replace(/^www\./, '');
const id = slug(name);
---

{link ? (
  <a
    class:list={['item', 'tile', 'tile-link', { child, 'is-color': !tile.src }]}
    id={id}
    href={link}
    data-topics={topics.join(' ')}
    data-track={`tile:go:${id}`}
    style={tile.color ? `--tile-color: ${tile.color}` : undefined}
  >
    <span class="tile-face">
      {tile.src && (
        <img
          class="face"
          src={tile.src}
          alt={tile.alt ?? ''}
          loading="lazy"
          decoding="async"
          style={tile.position ? `object-position: ${tile.position}` : undefined}
        />
      )}
      <span class="caption">
        <span class="kind">{tile.kind}</span>
        <Heading>{name}</Heading>
        <span class="line">{line}</span>
      </span>
      <span class="go-mark" aria-hidden="true">→</span>
    </span>
  </a>
) : (
<details
  class:list={['item', 'tile', { child, parent: children.length > 0, 'is-color': !tile.src }]}
  id={id}
  data-topics={topics.join(' ')}
  style={tile.color ? `--tile-color: ${tile.color}` : undefined}
>
  <summary>
    {tile.src && (
      <img
        class="face"
        src={tile.src}
        alt={tile.alt ?? ''}
        loading="lazy"
        decoding="async"
        style={tile.position ? `object-position: ${tile.position}` : undefined}
      />
    )}
    <span class="caption">
      <span class="kind">{tile.kind}</span>
      <Heading>{name}</Heading>
      <span class="line">{line}</span>
    </span>
    <span class="toggle-mark" aria-hidden="true"></span>
  </summary>
  <div class="body">
    {body.length > 0 && (
      <div class="text">
        {body.map((para) => <p>{inline(para).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>)}
      </div>
    )}
    {(host || links.length > 0 || message) && (
      <p class="actions">
        {host && (
          <a class="arrow-link" href={href} data-track={`tile:visit:${id}`}>
            {host} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
        {links.map((l) => (
          <a class="arrow-link" href={l.href} data-track={`tile:link:${id}`}>
            {l.label} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
        {message && (
          <button type="button" class="btn btn-primary" data-message data-track={`tile:message:${id}`}>
            {message}
          </button>
        )}
      </p>
    )}
    {memories.length > 0 && (
      <div class="memories">
        <h4 class="eyebrow">Memories archive</h4>
        <ul>
          {memories.map((m) => (
            <li class="memory" data-memory={m.audio}>
              <button type="button" class="memory-play" aria-label={`Play ${m.title}`} data-track={`memory:${m.title}`}>
                <span class="memory-icon" aria-hidden="true"></span>
              </button>
              <div class="memory-main">
                <div class="memory-head">
                  <span class="memory-title">{m.title}</span>
                  <span class="memory-time" data-memory-time>{m.duration}</span>
                </div>
                <div class="memory-track" aria-hidden="true"><span data-memory-bar></span></div>
                <details class="memory-transcript">
                  <summary>Transcript</summary>
                  {m.transcript.map((line) => <p>{line}</p>)}
                </details>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
    {books.length > 0 && (
      <div class="reading">
        <h4 class="eyebrow">Recommended reading</h4>
        <ul class="shelf">
          {books.map((book) => (
            <li>
              <a class="book-link" href={book.href} target="_blank" rel="noopener" data-track={`book:${book.title}`}>
                <span class="book3d" style={`aspect-ratio: ${book.width} / ${book.height}`}>
                  <span class="book-pages" aria-hidden="true"></span>
                  <span class="book-cover">
                    <img src={book.cover} alt={`${book.title}, cover`} width={book.width} height={book.height} loading="lazy" decoding="async" />
                  </span>
                </span>
                <span class="book-title">{book.title}</span>
                <span class="book-author">{book.author}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {embed && (
      <iframe
        class="embed"
        src={embed}
        title={embedTitle ?? `${name}, live site`}
        style={embedRatio ? `aspect-ratio: ${embedRatio}` : undefined}
        allow={embedAllow}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
      />
    )}
    {cover && (
      <a class="cover" href={cover.href}>
        <img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
        <span class="badge">{cover.label} <span aria-hidden="true">→</span></span>
      </a>
    )}
    {photos.length > 0 && (
      <div class="photos">
        {photos.map(({ src, alt, caption, story }) => (
          <a
            href={src}
            class:list={{ 'has-story': story }}
            data-caption={caption}
            data-story-title={story?.title}
            data-story-audio={story?.audio}
            data-story-captions={story?.captions}
          >
            <img src={src} alt={alt} loading="lazy" decoding="async" />
            {story && (
              <span class="badge">
                <span aria-hidden="true">▶</span> {story.title}
              </span>
            )}
          </a>
        ))}
      </div>
    )}
    {children.length > 0 && (
      <div class="tiles children">
        {children.map((c) => <Astro.self section={c} child />)}
      </div>
    )}
  </div>
</details>
)}

<script>
  import { clock, pickSource } from '../scripts/narration';

  // One memory plays at a time; its row shows the time left and how far along it is.
  let current: { audio: HTMLAudioElement; row: HTMLElement } | undefined;
  for (const row of document.querySelectorAll<HTMLElement>('[data-memory]')) {
    const button = row.querySelector<HTMLButtonElement>('.memory-play')!;
    const bar = row.querySelector<HTMLElement>('[data-memory-bar]')!;
    const time = row.querySelector<HTMLElement>('[data-memory-time]')!;
    const total = time.textContent;
    let audio: HTMLAudioElement | undefined;
    const show = (playing: boolean) => {
      row.classList.toggle('playing', playing);
      button.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} ${row.querySelector('.memory-title')!.textContent}`);
    };
    button.addEventListener('click', () => {
      if (!audio) {
        audio = new Audio();
        audio.src = pickSource(audio, row.dataset.memory!);
        audio.addEventListener('timeupdate', () => {
          if (audio!.duration) bar.style.width = `${(audio!.currentTime / audio!.duration) * 100}%`;
          time.textContent = clock(audio!.currentTime);
        });
        audio.addEventListener('play', () => show(true));
        audio.addEventListener('pause', () => show(false));
        audio.addEventListener('ended', () => {
          bar.style.width = '0';
          time.textContent = total;
        });
      }
      if (current && current.audio !== audio) current.audio.pause();
      current = { audio, row };
      if (audio.paused) void audio.play().catch(() => show(false));
      else audio.pause();
    });
  }
</script>
