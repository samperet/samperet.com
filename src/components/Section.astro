---
// One collapsible homepage row. A row with `children` is a parent: its body holds the child
// rows, and it opens for any topic one of its children belongs to.
import Merlin from './Merlin.astro';

export type SectionData = {
  name: string;
  topics: string[];
  line: string;
  body?: string[];
  href?: string;
  embed?: string;
  merlin?: boolean;
  photos?: { src: string; alt: string }[];
  children?: SectionData[];
};

type Props = { section: SectionData; child?: boolean };

const { section, child = false } = Astro.props;
const { name, line, href, embed, body = [], merlin, photos = [], children = [] } = section;

const slug = (value: string) =>
  value.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const topicsOf = (s: SectionData): string[] => [...s.topics, ...(s.children ?? []).flatMap(topicsOf)];
const topics = [...new Set(topicsOf(section))];

const Heading = child ? 'h4' : 'h3';
---

<details class:list={['item', { child, parent: children.length > 0 }]} id={slug(name)} data-topics={topics.join(' ')}>
  <summary>
    <Heading>{href ? <a href={href}>{name}</a> : name}</Heading>
    <p class="line">{line}</p>
    <span class="chevron" aria-hidden="true" />
  </summary>
  <div class="body">
    {(body.length > 0 || merlin) && (
      <div class="text">
        {body.map((para) => <p>{para}</p>)}
        {merlin && <Merlin />}
      </div>
    )}
    {embed && (
      <iframe
        class="embed"
        src={embed}
        title={`${name}, live site`}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
      />
    )}
    {photos.length > 0 && (
      <div class="photos">
        {photos.map(({ src, alt }) => (
          <a href={src}>
            <img src={src} alt={alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    )}
    {children.length > 0 && (
      <div class="children">
        {children.map((c) => <Astro.self section={c} child />)}
      </div>
    )}
  </div>
</details>
