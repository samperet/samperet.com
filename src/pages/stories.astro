---
// Stories: the picture books and the told stories, each a tile. Books open their flipbook pages;
// the bear shark opens the photo viewer and plays Sam telling it (PhotoViewer.astro).
import Base from '../layouts/Base.astro';

type Story = {
  id: string;
  name: string;
  kind: string;
  line: string;
  src: string;
  position?: string;
  href: string;
  // A told story plays over its photo in the viewer instead of opening a page.
  told?: { title: string; audio: string; captions: string; alt: string };
};

const stories: Story[] = [
  {
    id: 'foreside-fiasco',
    name: 'Foreside Fiasco',
    kind: 'Picture book · Read aloud',
    line: 'An unfortunate true story.',
    src: '/books/foreside-fiasco/cover-560.webp',
    position: 'center 35%',
    href: '/foreside-fiasco/',
  },
  {
    id: 'golden-berry',
    name: 'The Golden Berry',
    kind: 'Picture book · By Jaya',
    line: 'Little Red Riding Hood and The Golden Berry, by Jaya Elnora Peret.',
    src: '/books/golden-berry/cover-640.webp',
    position: 'center 30%',
    href: '/golden-berry/',
  },
  {
    id: 'bear-shark',
    name: 'The Bear Shark',
    kind: 'Story · Audio',
    line: 'How a 12-foot bear shark got into the building.',
    src: '/photos/airbnb-bearshark.jpg',
    href: '/photos/airbnb-bearshark.jpg',
    told: {
      title: 'The story of the bear shark',
      audio: '/stories/bear-shark.m4a',
      captions: '/stories/bear-shark.vtt',
      alt: 'A bear-shark sculpture, half polar bear and half shark, suspended from the ceiling of an Airbnb office',
    },
  },
];

const description = 'Stories by Sam Peret and family: Foreside Fiasco, read aloud; The Golden Berry, by Jaya Elnora Peret; and the bear shark, told.';
---

<Base title="Stories · Samperet.com" description={description} path="/stories/">
  <main class="wrap-wide stories-page">
    <a class="arrow-link home-btn" href="/" data-track="nav:home"><span class="arrow" aria-hidden="true">←</span> Home</a>
    <header class="stories-head">
      <h1>Stories</h1>
      <p class="lede">Picture books and stories, to read or to listen to.</p>
    </header>

    <ul class="story-tiles">
      {
        stories.map((s) => {
          const face = (
            <>
              <img class="face" src={s.src} alt={s.told?.alt ?? ''} loading="lazy" decoding="async" style={s.position ? `object-position: ${s.position}` : undefined} />
              <span class="caption">
                <span class="kind">{s.kind}</span>
                <h2>{s.name}</h2>
                <span class="line">{s.line}</span>
              </span>
              <span class="go" aria-hidden="true">{s.told ? '▶' : '→'}</span>
            </>
          );
          return (
            <li id={s.id}>
              {s.told ? (
                // Inside .photos so the photo viewer picks it up and plays the story.
                <div class="photos">
                  <a class="story-tile" href={s.href} data-story-title={s.told.title} data-story-audio={s.told.audio} data-story-captions={s.told.captions} data-track={`stories:${s.id}`}>
                    {face}
                  </a>
                </div>
              ) : (
                <a class="story-tile" href={s.href} data-track={`stories:${s.id}`}>
                  {face}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </main>

  <script>
    import { startTracking } from '../scripts/track';

    startTracking();
  </script>
</Base>

<style is:global>
  .stories-page {
    padding: var(--s6) 0 var(--s9);
  }

  .stories-head {
    margin: var(--s7) 0 var(--s6);
  }

  .stories-head h1 {
    font-size: var(--text-display);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stories-head .lede {
    margin-top: var(--s3);
    font-size: clamp(1.125rem, 1rem + 1vw, 1.5rem);
  }

  .story-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--s4);
  }

  .story-tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--hof);
    color: #fff;
    text-decoration: none;
  }

  .story-tile .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    aspect-ratio: auto;
    transition: filter var(--fast) var(--ease);
  }

  .story-tile:hover .face,
  .story-tile:focus-visible .face {
    filter: brightness(0.92);
    outline: none;
  }

  .story-tile .caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--s1);
    padding: var(--s7) var(--s5) var(--s4);
    background: linear-gradient(to top, rgb(20 21 22 / 0.78), rgb(20 21 22 / 0.45) 55%, transparent);
  }

  .story-tile .kind {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .story-tile h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 1.9rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .story-tile .line {
    font-size: var(--text-sm);
    opacity: 0.9;
  }

  /* An arrow for a book, a play mark for a told story, in the corner. */
  .story-tile .go {
    position: absolute;
    top: var(--s3);
    right: var(--s3);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius);
    background: rgb(20 21 22 / 0.45);
    font-size: 0.9rem;
    transition: background var(--fast) var(--ease), transform var(--fast) var(--ease);
  }

  .story-tile:hover .go,
  .story-tile:focus-visible .go {
    background: var(--accent);
  }

  @media (max-width: 640px) {
    .story-tile .caption {
      padding: var(--s6) var(--s4) var(--s3);
    }
  }
</style>
