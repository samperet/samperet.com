---
// Career: the CV as a page. Three chapters, each with a few highlights. The four words on
// the tagline are the lens: choose one and the highlights that show it stay, the rest step
// back. Nothing moves on its own. Print gives a clean one-pager.
import Base from '../layouts/Base.astro';

type Skill = 'strategy' | 'relationships' | 'systems' | 'design';
type Highlight = { text: string; skills: Skill[] };
type Role = {
  id: string;
  name: string;
  full?: string;
  href?: string;
  summary: string;
  stat?: { value: string; label: string };
  highlights: Highlight[];
  photos?: { src: string; alt: string; story?: { title: string; audio: string; captions: string } }[];
};

const SKILLS: { key: Skill; label: string }[] = [
  { key: 'strategy', label: 'Strategy' },
  { key: 'relationships', label: 'Relationships' },
  { key: 'systems', label: 'Systems' },
  { key: 'design', label: 'Design' },
];

const roles: Role[] = [
  {
    id: 'alps',
    name: 'ALPS',
    full: 'Acadia Leadership Partners',
    href: 'https://acadialps.com',
    summary: 'A strategic sales channel built for C-suite conversations.',
    stat: { value: '220+', label: 'senior advisors recruited' },
    highlights: [
      { text: 'Recruited 220+ senior advisors, many of them former Big 4 consultants.', skills: ['relationships'] },
      { text: 'Built a strategic sales channel dedicated to C-suite conversations.', skills: ['strategy', 'relationships', 'systems'] },
    ],
  },
  {
    id: 'founders-wanted',
    name: 'Founders Wanted',
    summary: 'Turning stagnant intellectual property into companies.',
    highlights: [
      { text: 'Searched through thousands of pieces of stagnant intellectual property for the viable ones.', skills: ['strategy'] },
      { text: 'Commercialized them by injecting marketing, recruiting, and seed money.', skills: ['strategy', 'relationships'] },
      { text: 'Launched AI Parkinson’s detection, NASA-based rock blasting, and IoT consumer devices.', skills: ['strategy', 'systems'] },
    ],
  },
  {
    id: 'airbnb',
    name: 'Airbnb',
    summary: 'Early host, then a founding member of the Portland office.',
    stat: { value: '2,000', label: 'first hosts, and I was one of them' },
    highlights: [
      { text: 'One of the first 2,000 hosts. My host ID was too short to use as a badge number.', skills: ['relationships'] },
      { text: 'PDX founder: in the first batch of hires to open the Portland office.', skills: ['relationships', 'strategy'] },
      { text: 'Played a critical role in designing the customer service processes.', skills: ['systems', 'design'] },
      { text: 'Built the office itself, including Brian Chesky’s favorite table, inspired by Twin Peaks, and a honeybee room with custom laser-cut bee-nest chandeliers.', skills: ['design'] },
      { text: 'Got a 12-foot bear shark into the building with a guitar string and a car battery.', skills: ['systems', 'design'] },
    ],
    photos: [
      {
        src: '/photos/airbnb-bearshark.jpg',
        alt: 'A bear-shark sculpture, half polar bear and half shark, suspended from the ceiling of an Airbnb office',
        story: { title: 'The story of the bear shark', audio: '/stories/bear-shark.m4a', captions: '/stories/bear-shark.vtt' },
      },
      { src: '/photos/airbnb-wood-ball.jpg', alt: 'Selfie in safety glasses in a workshop, in front of a giant sphere made of patchwork wood' },
    ],
  },
];

const description = 'Sam Peret’s career: ALPS (Acadia Leadership Partners), Founders Wanted and Airbnb. Strategy, relationships, systems and design.';
---

<Base title="Career · Sam Peret" description={description} path="/career/" ogType="profile">
  <div class="wrap page">
    <aside class="side">
      <a class="back" href="/">← Samperet.com</a>
      <img
        class="portrait"
        src="/photos/sam-peret-full-1000.webp"
        srcset="/photos/sam-peret-full-560.webp 560w, /photos/sam-peret-full-1000.webp 1000w"
        sizes="(max-width: 900px) 60vw, 20rem"
        width="1000"
        height="1500"
        alt="Sam Peret, smiling, hands in pockets, in a dark pinstripe suit and open blue shirt"
        fetchpriority="high"
      />
      <nav class="toc" aria-label="Chapters">
        {roles.map((r) => <a href={`#${r.id}`} data-toc={r.id}>{r.name}</a>)}
      </nav>
    </aside>

    <main>
      <header class="head">
        <h1>Sam Peret</h1>
        <p class="lede">strategy, relationships, systems <span class="amp">&amp;</span> design.</p>
        <div class="actions">
          <button type="button" class="btn btn-primary" data-contact data-track="career:message">Send me a message</button>
          <button type="button" class="btn btn-quiet" data-print data-track="career:print">Print or save as PDF</button>
        </div>
      </header>

      <div class="lens" role="group" aria-label="Highlight by skill">
        <span class="eyebrow">Show me</span>
        {
          SKILLS.map((s) => (
            <button type="button" class="toggle" style={`--toggle-color: var(--skill-${s.key})`} data-skill={s.key} aria-pressed="false" data-track={`career:skill:${s.key}`}>
              {s.label}
            </button>
          ))
        }
      </div>

      <ol class="roles">
        {
          roles.map((r) => (
            <li class="role" id={r.id} data-skills={[...new Set(r.highlights.flatMap((h) => h.skills))].join(' ')}>
              <header class="role-head">
                <h2>{r.name}</h2>
                {r.full && <p class="full">{r.full}</p>}
                <p class="summary">{r.summary}</p>
              </header>
              {r.stat && (
                <p class="stat">
                  <span class="stat-value">{r.stat.value}</span>
                  <span class="stat-label">{r.stat.label}</span>
                </p>
              )}
              <ul class="highlights">
                {r.highlights.map((h) => (
                  <li data-skills={h.skills.join(' ')}>
                    <span class="text">{h.text}</span>
                    <span class="marks">{h.skills.map((s) => <span class={`mark mark-${s}`}>{s}</span>)}</span>
                  </li>
                ))}
              </ul>
              {r.photos && (
                <div class="photos">
                  {r.photos.map(({ src, alt, story }) => (
                    <a
                      href={src}
                      class:list={{ 'has-story': story }}
                      data-story-title={story?.title}
                      data-story-audio={story?.audio}
                      data-story-captions={story?.captions}
                    >
                      <img src={src} alt={alt} loading="lazy" decoding="async" />
                      {story && (
                        <span class="badge">
                          <span aria-hidden="true">▶</span> {story.title}
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              )}
              {r.href && (
                <a class="arrow-link visit" href={r.href} data-track={`career:visit:${r.id}`}>
                  {new URL(r.href).hostname.replace(/^www\./, '')} <span class="arrow" aria-hidden="true">↗</span>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </main>
  </div>

  <script>
    import { startTracking } from '../scripts/track';
    import { openTopic } from '../scripts/topics';

    startTracking();

    // The lens: one skill at a time. Its highlights keep their colour; the rest step back.
    const roles = document.querySelectorAll<HTMLElement>('.role');
    const toggles = document.querySelectorAll<HTMLButtonElement>('[data-skill]');
    let active: string | null = null;
    const apply = () => {
      document.body.classList.toggle('lensing', active !== null);
      for (const t of toggles) t.setAttribute('aria-pressed', String(t.dataset.skill === active));
      for (const role of roles) {
        role.classList.toggle('match', active !== null && (role.dataset.skills ?? '').split(' ').includes(active));
        for (const li of role.querySelectorAll<HTMLElement>('.highlights li'))
          li.classList.toggle('match', active !== null && (li.dataset.skills ?? '').split(' ').includes(active));
      }
    };
    for (const t of toggles)
      t.addEventListener('click', () => {
        active = active === t.dataset.skill ? null : t.dataset.skill!;
        apply();
      });

    // The side list marks the chapter in view.
    const toc = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
    if ('IntersectionObserver' in window) {
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries)
            if (entry.isIntersecting) for (const a of toc) a.classList.toggle('current', a.dataset.toc === entry.target.id);
        },
        { rootMargin: '-35% 0px -55% 0px' },
      );
      roles.forEach((r) => spy.observe(r));
    }

    document.querySelector('[data-contact]')!.addEventListener('click', () => openTopic('message'));
    document.querySelector('[data-print]')!.addEventListener('click', () => window.print());
    addEventListener('beforeprint', () => {
      active = null;
      apply();
    });
  </script>
</Base>

<style is:global>
  .page {
    display: grid;
    grid-template-columns: 20rem 1fr;
    gap: var(--s8);
    padding: var(--s6) 0 var(--s9);
  }

  .side {
    position: sticky;
    top: var(--s5);
    align-self: start;
    display: grid;
    gap: var(--s5);
  }

  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .back:hover,
  .back:focus-visible {
    color: var(--fg);
  }

  .portrait {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: #ddd8e8;
  }

  .toc {
    display: grid;
    gap: var(--s1);
  }

  .toc a {
    display: flex;
    gap: var(--s2);
    color: var(--muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .toc a::before {
    content: '';
    width: 1.25rem;
    border-top: 1px solid currentColor;
    transform: translateY(0.75em);
    transition: width var(--fast) var(--ease);
  }

  .toc a:hover,
  .toc a:focus-visible,
  .toc a.current {
    color: var(--fg);
  }

  .toc a.current::before {
    width: 2rem;
    border-color: var(--accent);
  }

  main {
    min-width: 0;
    padding-top: var(--s7);
  }

  .head h1 {
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .head .lede {
    margin-top: var(--s3);
    font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s5);
  }

  /* ---- The lens ------------------------------------------------------------------------ */

  .lens {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s3) var(--s5);
    margin: var(--s8) 0 var(--s2);
    padding-top: var(--s5);
    border-top: var(--hairline);
  }

  .lens .eyebrow {
    margin-right: var(--s2);
  }

  /* ---- Chapters ------------------------------------------------------------------------ */

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .role {
    padding: var(--s7) 0;
    border-top: var(--hairline);
    scroll-margin-top: var(--s5);
    transition: opacity var(--slow) var(--ease);
  }

  .role:first-child {
    border-top: 0;
    padding-top: var(--s6);
  }

  .lensing .role:not(.match) {
    opacity: 0.4;
  }

  .role-head h2 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .full {
    margin-top: var(--s1);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .summary {
    margin-top: var(--s3);
    font-size: var(--text-md);
    max-width: var(--measure);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    margin-top: var(--s5);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    color: var(--muted);
  }

  .highlights {
    list-style: none;
    margin: var(--s5) 0 0;
    padding: 0;
    max-width: var(--measure);
  }

  .highlights li {
    display: grid;
    gap: var(--s1);
    padding: var(--s3) 0 var(--s3) var(--s4);
    border-left: 2px solid var(--rule);
    transition: opacity var(--slow) var(--ease), border-color var(--slow) var(--ease);
  }

  .highlights li + li {
    margin-top: var(--s1);
  }

  .lensing .role.match .highlights li:not(.match) {
    opacity: 0.4;
  }

  .highlights li.match {
    border-left-color: var(--fg);
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--s2);
    margin-top: var(--s5);
    max-width: 40rem;
  }

  .photos a {
    position: relative;
    display: block;
  }

  .photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .photos a:hover img,
  .photos a:focus-visible img {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .photos .badge {
    position: absolute;
    left: var(--s3);
    bottom: var(--s3);
    max-width: calc(100% - var(--s6));
  }

  .visit {
    margin-top: var(--s5);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .page {
      grid-template-columns: 1fr;
      gap: var(--s5);
    }

    .side {
      position: static;
    }

    .portrait {
      width: min(60vw, 18rem);
    }

    .toc {
      display: none;
    }

    main {
      padding-top: 0;
    }
  }

  @media print {
    .back,
    .toc,
    .actions,
    .lens,
    .photos {
      display: none !important;
    }

    .page {
      grid-template-columns: 8rem 1fr;
      gap: var(--s5);
      width: 100%;
      padding: 0;
    }

    .side {
      position: static;
    }

    .role {
      opacity: 1 !important;
      break-inside: avoid;
      padding: var(--s4) 0;
    }

    .highlights li {
      opacity: 1 !important;
    }

    .visit::after {
      content: ' (' attr(href) ')';
      font-weight: 400;
    }
  }
</style>
