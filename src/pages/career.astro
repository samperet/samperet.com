---
// Career: an interactive CV. Filter by the four things on the homepage tagline and the
// highlights that show them light up; numbers count up as they scroll in; Print gives a
// clean one-pager. Every fact here comes from Sam; dates and titles are left out until he
// supplies them.
import PhotoViewer from '../components/PhotoViewer.astro';
import Merlin from '../components/Merlin.astro';

type Skill = 'strategy' | 'relationships' | 'systems' | 'design';
type Highlight = { text: string; skills: Skill[] };
type Role = {
  id: string;
  name: string;
  full?: string;
  href?: string;
  summary: string;
  stat?: { value: number; suffix?: string; label: string };
  highlights: Highlight[];
  tags?: string[];
  photos?: { src: string; alt: string; story?: { title: string; audio: string; captions: string } }[];
};

const SKILLS: { key: Skill; label: string }[] = [
  { key: 'strategy', label: 'Strategy' },
  { key: 'relationships', label: 'Relationships' },
  { key: 'systems', label: 'Systems' },
  { key: 'design', label: 'Design' },
];

const roles: Role[] = [
  {
    id: 'alps',
    name: 'ALPS',
    full: 'Acadia Leadership Partners',
    href: 'https://acadialps.com',
    summary: 'A strategic sales channel built for C-suite conversations.',
    stat: { value: 220, suffix: '+', label: 'senior advisors recruited' },
    highlights: [
      { text: 'Recruited 220+ senior advisors, many of them former Big 4 consultants.', skills: ['relationships'] },
      { text: 'Built a strategic sales channel dedicated to C-suite conversations.', skills: ['strategy', 'relationships', 'systems'] },
    ],
  },
  {
    id: 'founders-wanted',
    name: 'Founders Wanted',
    summary: 'Turning stagnant intellectual property into companies.',
    highlights: [
      { text: 'Searched through thousands of pieces of stagnant intellectual property for the viable ones.', skills: ['strategy'] },
      { text: 'Commercialized them by injecting marketing, recruiting, and seed money.', skills: ['strategy', 'relationships'] },
      { text: 'Launched AI Parkinson’s detection, NASA-based rock blasting, and IoT consumer devices.', skills: ['strategy', 'systems'] },
    ],
    tags: ['AI Parkinson’s detection', 'NASA-based rock blasting', 'IoT consumer devices'],
  },
  {
    id: 'airbnb',
    name: 'Airbnb',
    summary: 'Early host, then a founding member of the Portland office.',
    stat: { value: 2000, label: 'first hosts, and I was one' },
    highlights: [
      { text: 'One of the first 2,000 hosts. My host ID was too short to use as a badge number.', skills: ['relationships'] },
      { text: 'PDX founder: in the first batch of hires to open the Portland office.', skills: ['relationships', 'strategy'] },
      { text: 'Played a critical role in designing the customer service processes.', skills: ['systems', 'design'] },
      { text: 'Built the office itself, including Brian Chesky’s favorite table, inspired by Twin Peaks, and a honeybee room with custom laser-cut bee-nest chandeliers.', skills: ['design'] },
      { text: 'Got a 12-foot bear shark into the building with a guitar string and a car battery.', skills: ['systems', 'design'] },
    ],
    photos: [
      {
        src: '/photos/airbnb-bearshark.jpg',
        alt: 'A bear-shark sculpture, half polar bear and half shark, suspended from the ceiling of an Airbnb office',
        story: { title: 'The story of the bear shark', audio: '/stories/bear-shark.m4a', captions: '/stories/bear-shark.vtt' },
      },
      { src: '/photos/airbnb-wood-ball.jpg', alt: 'Selfie in safety glasses in a workshop, in front of a giant sphere made of patchwork wood' },
    ],
  },
];

const description = 'Sam Peret’s career: ALPS (Acadia Leadership Partners), Founders Wanted and Airbnb. Strategy, relationships, systems and design.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Career · Sam Peret</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/career/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Sam Peret · Career" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL('/career/', Astro.site)} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <div class="page">
      <aside class="side">
        <a class="back" href="/">← Samperet.com</a>
        <img
          class="portrait"
          src="/photos/sam-peret-full-1000.webp"
          srcset="/photos/sam-peret-full-560.webp 560w, /photos/sam-peret-full-1000.webp 1000w"
          sizes="(max-width: 860px) 60vw, 22rem"
          width="1000"
          height="1500"
          alt="Sam Peret, smiling, hands in pockets, in a dark pinstripe suit and open blue shirt"
          fetchpriority="high"
        />
        <nav class="toc" aria-label="Roles">
          {roles.map((r) => <a href={`#${r.id}`} data-toc={r.id}>{r.name}</a>)}
        </nav>
      </aside>

      <main>
        <header class="head">
          <h1>Sam Peret</h1>
          <p class="lede">Strategy, relationships, systems &amp; design.</p>
          <div class="actions">
            <button type="button" class="primary" data-contact data-track="career:message">Send me a message</button>
            <button type="button" data-print data-track="career:print">Print / save as PDF</button>
          </div>
        </header>

        <div class="filters" role="group" aria-label="Highlight by skill">
          <span class="filters-label">Show me</span>
          {SKILLS.map((s) => <button type="button" data-skill={s.key} aria-pressed="false" data-track={`career:skill:${s.key}`}>{s.label}</button>)}
        </div>

        <ol class="roles">
          {
            roles.map((r) => (
              <li class="role" id={r.id} data-skills={[...new Set(r.highlights.flatMap((h) => h.skills))].join(' ')}>
                <details open>
                  <summary>
                    <span class="dot" aria-hidden="true" />
                    <span class="role-head">
                      <h2>{r.name}</h2>
                      {r.full && <span class="full">{r.full}</span>}
                      <span class="summary">{r.summary}</span>
                    </span>
                    <span class="chevron" aria-hidden="true" />
                  </summary>
                  <div class="role-body">
                    {r.stat && (
                      <p class="stat">
                        <span class="stat-value" data-count={r.stat.value} data-suffix={r.stat.suffix ?? ''}>
                          {r.stat.value.toLocaleString('en-US')}{r.stat.suffix}
                        </span>
                        <span class="stat-label">{r.stat.label}</span>
                      </p>
                    )}
                    <ul class="highlights">
                      {r.highlights.map((h) => (
                        <li data-skills={h.skills.join(' ')}>
                          {h.text}
                          <span class="skill-tags">{h.skills.map((s) => <span class={`tag tag-${s}`}>{s}</span>)}</span>
                        </li>
                      ))}
                    </ul>
                    {r.tags && <p class="tags">{r.tags.map((t) => <span>{t}</span>)}</p>}
                    {r.photos && (
                      <div class="photos">
                        {r.photos.map(({ src, alt, story }) => (
                          <a
                            href={src}
                            class:list={{ 'has-story': story }}
                            data-story-title={story?.title}
                            data-story-audio={story?.audio}
                            data-story-captions={story?.captions}
                          >
                            <img src={src} alt={alt} loading="lazy" decoding="async" />
                            {story && (
                              <span class="story-badge">
                                <span aria-hidden="true">▶</span> {story.title}
                              </span>
                            )}
                          </a>
                        ))}
                      </div>
                    )}
                    {r.href && (
                      <a class="visit" href={r.href} data-track={`career:visit:${r.id}`}>
                        Visit {new URL(r.href).hostname.replace(/^www\./, '')} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
      </main>
    </div>

    <PhotoViewer />
    <Merlin />

    <script>
      import { startTracking } from '../scripts/track';
      import { openTopic } from '../scripts/topics';

      startTracking();

      // Skill filter: one at a time; the chosen skill lights up its highlights and dims the rest.
      const roles = document.querySelectorAll<HTMLElement>('.role');
      const chips = document.querySelectorAll<HTMLButtonElement>('[data-skill]');
      let active: string | null = null;
      const applyFilter = () => {
        document.body.classList.toggle('filtering', active !== null);
        for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.skill === active));
        for (const role of roles) {
          const has = active !== null && (role.dataset.skills ?? '').split(' ').includes(active);
          role.classList.toggle('match', has);
          if (has) role.querySelector('details')!.open = true;
          for (const li of role.querySelectorAll<HTMLElement>('.highlights li'))
            li.classList.toggle('match', active !== null && (li.dataset.skills ?? '').split(' ').includes(active));
        }
      };
      for (const chip of chips)
        chip.addEventListener('click', () => {
          active = active === chip.dataset.skill ? null : chip.dataset.skill!;
          applyFilter();
        });

      // Numbers count up the first time they scroll into view.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      if (!reduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              io.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const end = Number(el.dataset.count);
              const suffix = el.dataset.suffix ?? '';
              const t0 = performance.now();
              const step = (now: number) => {
                const k = Math.min((now - t0) / 1200, 1);
                const eased = 1 - Math.pow(1 - k, 3);
                el.textContent = `${Math.round(end * eased).toLocaleString('en-US')}${k === 1 ? suffix : ''}`;
                if (k < 1) requestAnimationFrame(step);
              };
              el.textContent = '0';
              requestAnimationFrame(step);
            }
          },
          { threshold: 0.6 },
        );
        counters.forEach((c) => io.observe(c));
      }

      // The side list marks the role in view.
      const toc = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
      if ('IntersectionObserver' in window) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries)
              if (entry.isIntersecting)
                for (const a of toc) a.classList.toggle('current', a.dataset.toc === entry.target.id);
          },
          { rootMargin: '-40% 0px -55% 0px' },
        );
        roles.forEach((r) => spy.observe(r));
      }

      document.querySelector('[data-contact]')!.addEventListener('click', () => openTopic('message'));

      // Print everything open, filters off.
      document.querySelector('[data-print]')!.addEventListener('click', () => window.print());
      addEventListener('beforeprint', () => {
        active = null;
        applyFilter();
        roles.forEach((r) => (r.querySelector('details')!.open = true));
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #111111;
    --muted: #57534e;
    --rule: #e7e5e4;
    --strategy: #1d4ed8;
    --relationships: #be185d;
    --systems: #047857;
    --design: #b45309;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0c0c;
      --fg: #f5f5f4;
      --muted: #a8a29e;
      --rule: #292524;
      --strategy: #93c5fd;
      --relationships: #f9a8d4;
      --systems: #6ee7b7;
      --design: #fcd34d;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  .page {
    display: grid;
    grid-template-columns: 22rem 1fr;
    gap: 4rem;
    width: min(72rem, 100% - 2rem);
    margin: 0 auto;
    padding: 2rem 0 6rem;
  }

  .side {
    position: sticky;
    top: 1.5rem;
    align-self: start;
    display: grid;
    gap: 1.25rem;
  }

  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--fg);
    text-decoration: underline;
  }

  .portrait {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    background: #ddd8e8;
  }

  .toc {
    display: grid;
    gap: 0.15rem;
    border-left: 2px solid var(--rule);
  }

  .toc a {
    padding: 0.3rem 0 0.3rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .toc a:hover,
  .toc a:focus-visible,
  .toc a.current {
    color: var(--fg);
    border-left-color: var(--fg);
  }

  main {
    min-width: 0;
    padding-top: 2.25rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .lede {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  button {
    font: inherit;
    cursor: pointer;
  }

  .actions button,
  .filters button {
    font-size: 0.875rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.45rem 1rem;
  }

  .actions button:hover,
  .actions button:focus-visible,
  .filters button:hover,
  .filters button:focus-visible {
    border-color: currentColor;
  }

  .actions .primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    font-weight: 600;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .filters-label {
    color: var(--muted);
    font-size: 0.875rem;
    margin-right: 0.25rem;
  }

  .filters button::before {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    vertical-align: 0.05em;
  }

  .filters [data-skill='strategy']::before { background: var(--strategy); }
  .filters [data-skill='relationships']::before { background: var(--relationships); }
  .filters [data-skill='systems']::before { background: var(--systems); }
  .filters [data-skill='design']::before { background: var(--design); }

  .filters button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* The timeline rail */
  .roles::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 2rem;
    bottom: 2rem;
    width: 2px;
    background: var(--rule);
  }

  .role {
    position: relative;
    scroll-margin-top: 1.5rem;
    transition: opacity 0.25s;
  }

  .filtering .role:not(.match) {
    opacity: 0.35;
  }

  .role summary {
    display: grid;
    grid-template-columns: 1rem 1fr 1.5rem;
    gap: 1.25rem;
    align-items: start;
    padding: 1.75rem 0 1rem;
    cursor: pointer;
    list-style: none;
  }

  .role summary::-webkit-details-marker {
    display: none;
  }

  .role summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .dot {
    width: 1rem;
    height: 1rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--fg);
    position: relative;
    z-index: 1;
  }

  .role-head {
    display: grid;
    gap: 0.15rem;
  }

  .role h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .full {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .summary {
    margin-top: 0.35rem;
    font-size: 1.0625rem;
  }

  .chevron {
    justify-self: end;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.85rem;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }

  details[open] > summary .chevron {
    transform: translateY(0.25rem) rotate(-135deg);
  }

  .role-body {
    padding: 0 0 2rem 2.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .stat-value {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-label {
    color: var(--muted);
  }

  .highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .highlights li {
    position: relative;
    padding: 0.55rem 0.75rem 0.55rem 1rem;
    border-left: 3px solid var(--rule);
    border-radius: 0 6px 6px 0;
    transition: background 0.2s, border-color 0.2s, opacity 0.2s;
  }

  .filtering .role.match .highlights li:not(.match) {
    opacity: 0.45;
  }

  .highlights li.match {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    border-left-color: var(--fg);
  }

  .skill-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-left: 0.4rem;
    vertical-align: 0.1em;
  }

  .tag {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tag-strategy { color: var(--strategy); }
  .tag-relationships { color: var(--relationships); }
  .tag-systems { color: var(--systems); }
  .tag-design { color: var(--design); }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
  }

  .tags span {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    font-size: 0.875rem;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .photos a {
    position: relative;
    display: block;
  }

  .photos img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
  }

  .story-badge {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    max-width: calc(100% - 1.2rem);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.65);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .visit {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--fg);
    font-size: 0.9375rem;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 860px) {
    .page {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .side {
      position: static;
    }

    .portrait {
      width: min(60vw, 18rem);
    }

    .toc {
      display: none;
    }

    main {
      padding-top: 0;
    }
  }

  @media (max-width: 520px) {
    .role-body {
      padding-left: 0;
    }

    .roles::before {
      display: none;
    }

    .role summary {
      grid-template-columns: 1fr 1.5rem;
    }

    .dot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .role,
    .highlights li,
    .chevron {
      transition: none;
    }
  }

  @media print {
    :root {
      --bg: #fff;
      --fg: #000;
      --muted: #444;
      --rule: #ccc;
    }

    .back,
    .toc,
    .actions,
    .filters,
    .photos,
    .chevron,
    .merlin-hat,
    .viewer {
      display: none !important;
    }

    .page {
      grid-template-columns: 9rem 1fr;
      gap: 2rem;
      width: 100%;
      padding: 0;
    }

    .side {
      position: static;
    }

    .role {
      opacity: 1 !important;
      break-inside: avoid;
    }

    .highlights li {
      padding: 0.2rem 0 0.2rem 0.75rem;
      background: none !important;
    }

    .visit::after {
      content: ' (' attr(href) ')';
    }
  }
</style>
