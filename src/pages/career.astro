type Example = { href: string; src: string; full: string; alt: string; name: string; note: string };
const initiatives: { title: string; items: string[]; example?: Example }[] = [
  {
    title: 'Enterprise AI adoption & solution discovery',
    items: [
      'Work with emerging AI companies and enterprise stakeholders to evaluate practical applications of generative AI, intelligent automation, and enterprise knowledge systems.',
      'Explore AI-powered onboarding, knowledge delivery, and interactive experiences that help users understand unfamiliar technologies and complex business processes.',
      'Develop approaches for making sophisticated technology accessible to nontechnical audiences through conversational interfaces, interactive presentations, and guided workflows.',
      'Collaborate with technical and commercial stakeholders to identify implementation considerations, enterprise constraints, and opportunities for adoption.',
    ],
  },
  {
    title: 'Digital systems & prototyping',
    items: [
      'Design and prototype web-based applications, interactive experiences, and workflow tools.',
      'Use modern AI-assisted development workflows to accelerate experimentation and translate product concepts into working prototypes.',
      'Explore integrations among web applications, AI systems, business processes, and internal knowledge resources.',
      'Apply a practical, user-centered approach to system design, prioritizing clarity, usability, and maintainability.',
    ],
    example: {
      href: 'https://www.fuseanalytics.com',
      src: '/work/fuseanalytics-800.webp',
      full: '/work/fuseanalytics.webp',
      alt: 'The fuseanalytics.com homepage: “Retire your legacy enterprise apps. Keep the data.”, with a product screenshot and a Book a demo button',
      name: 'fuseanalytics.com',
      note: 'An example of this work: the site for an HCM and payroll data-archiving company, built with AI-assisted development. Retention, turnover and M&A tools, a demo request that lands in the sales pipeline, and an AI assistant that hands a conversation to the team when a visitor asks for a person.',
    },
  },
];

const education: { school: string; degree: string; dates: string; place?: string; logo?: Logo; notes: string[] }[] = [
  {
    school: 'Southern New Hampshire University',
    logo: LOGOS.snhu,
    degree: 'Bachelor of Science, Business Administration',
    dates: 'May 2008',
    place: 'Manchester, New Hampshire',
    notes: ['Three-Year Honors Program', 'Vice President, Student Government', 'President, Audio Visual Club'],
  },
  {
    school: 'altMBA',
    logo: LOGOS.altmba,
    degree: 'Seth Godin’s altMBA Program',
    dates: 'July 2016',
    notes: ['Early participant in an intensive leadership and business development program emphasizing decision-making, creative problem-solving, communication, and organizational change.'],
  },
];

const boards = [
  { org: 'FuzionFit', role: 'Board Member', years: '2011–2020' },
  { org: 'Portsmouth Public Media', role: 'Vice President & Board Member', years: '2010–2011' },
  { org: 'Zev Yoga', role: 'Board Member', years: '2009–2015' },
  { org: 'Harambe Entrepreneur Alliance', role: 'Board Member', years: '2008–2012' },
];

const toc = [
  { id: 'summary', name: 'Summary' },
  { id: 'competencies', name: 'Competencies' },
  { id: 'experience', name: 'Experience' },
  ...roles.map((r) => ({ id: r.id, name: r.name, sub: true })),
  { id: 'initiatives', name: 'Technology & AI' },
  { id: 'education', name: 'Education' },
  { id: 'community', name: 'Community' },
  { id: 'boards', name: 'Boards' },
  { id: 'awards', name: 'Awards' },
];

const description =
  'Samuel Peret: technology and operations leader. Enterprise AI, zero-to-one team building. ALPS, Founders Wanted, Airbnb, Cloud Nurv, Whaleback Systems.';
---

<Base title="Career · Samuel Peret" description={description} path="/career/" ogType="profile">
  <div class="wrap page">
    <aside class="side">
      <a class="arrow-link home-btn" href="/" data-track="nav:home"><span class="arrow" aria-hidden="true">←</span> Home</a>
      <img
        class="portrait"
        src="/photos/sam-peret-full-1000.webp"
        srcset="/photos/sam-peret-full-560.webp 560w, /photos/sam-peret-full-1000.webp 1000w"
        sizes="(max-width: 900px) 60vw, 20rem"
        width="1000"
        height="1500"
        alt="Sam Peret, smiling, hands in pockets, in a dark pinstripe suit and open blue shirt"
        fetchpriority="high"
      />
      <nav class="toc" aria-label="On this page">
        {toc.map((t) => <a href={`#${t.id}`} data-toc={t.id} class:list={{ sub: t.sub }}>{t.name}</a>)}
      </nav>
    </aside>

    <main>
      <header class="head">
        <h1>Samuel Peret</h1>
        <p class="lede">Technology <span class="amp">&amp;</span> operations leader · enterprise AI · zero-to-one team building</p>
        <p class="contact">
          <a href={`tel:+1${contact.phone.replace(/\D/g, '')}`}>{contact.phone}</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href={contact.linkedin} rel="me">linkedin.com/in/samperet</a>
          <span class="sep" aria-hidden="true">·</span>
          <a class="github" href={contact.github} rel="me" data-track="career:github">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            github.com/samperet
          </a>
        </p>
        <div class="actions">
          <button type="button" class="btn btn-primary" data-contact data-track="career:message">Send me a message</button>
        </div>
      </header>

      <section id="summary" class="block" data-spy>
        <h2 class="block-title">Summary</h2>
        <div class="measure prose">
          {summary.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section id="competencies" class="block" data-spy>
        <h2 class="block-title">Core competencies</h2>
        <dl class="competencies">
          {competencies.map((c) => (
            <div class="competency">
              <dt><span class={`mark mark-${c.skill}`}>{c.skill}</span>{c.name}</dt>
              <dd>{c.items}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="experience" class="block" data-spy>
        <h2 class="block-title">Experience</h2>
        <div class="lens" role="group" aria-label="Highlight by skill">
          <span class="eyebrow">Show me</span>
          {
            SKILLS.map((s) => (
              <button type="button" class="toggle" style={`--toggle-color: var(--skill-${s.key})`} data-skill={s.key} aria-pressed="false" data-track={`career:skill:${s.key}`}>
                {s.label}
              </button>
            ))
          }
        </div>

        <ol class="roles">
          {
            roles.map((r) => {
              const all = [...r.highlights, ...(r.groups ?? []).flatMap((g) => g.highlights), ...(r.projects ?? [])];
              const list = (hs: Highlight[]) => (
                <ul class="highlights">
                  {hs.map((h) => (
                    <li data-skills={h.skills.join(' ')}>
                      <span class="text">{h.text}</span>
                      <span class="marks">{h.skills.map((s) => <span class={`mark mark-${s}`}>{s}</span>)}</span>
                    </li>
                  ))}
                </ul>
              );
              return (
                <li class="role" id={r.id} data-spy data-skills={[...new Set(all.flatMap((h) => h.skills))].join(' ')}>
                  <header class="role-head">
                    <div class="name-row">
                      <h3>{r.name}</h3>
                      {r.logo && <img class="logo" src={r.logo.src} width={r.logo.width} height={r.logo.height} alt="" />}
                    </div>
                    {r.full && <p class="full">{r.full}</p>}
                    <p class="meta">
                      <span class="title">{r.title}</span>
                      <span class="when">{r.dates}{r.place && ` · ${r.place}`}</span>
                    </p>
                    <p class="summary">{r.summary}</p>
                  </header>
                  {r.stat && (
                    <p class="stat">
                      <span class="stat-value">{r.stat.value}</span>
                      <span class="stat-label">{r.stat.label}</span>
                    </p>
                  )}
                  {r.highlights.length > 0 && list(r.highlights)}
                  {r.projects && (
                    <div class="projects">
                      <h4 class="eyebrow">Special projects</h4>
                      <ul>
                        {r.projects.map((pr) => (
                          <li class="project" data-skills={pr.skills.join(' ')}>
                            <img class="project-logo" src={pr.logo.src} width={pr.logo.width} height={pr.logo.height} alt={`${pr.partner} logo`} loading="lazy" decoding="async" />
                            <div>
                              <p class="project-title">{pr.title}</p>
                              <p class="project-text">{pr.text}</p>
                              <span class="marks">{pr.skills.map((sk) => <span class={`mark mark-${sk}`}>{sk}</span>)}</span>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {r.groups?.map((g) => (
                    <div class="group">
                      <h4>{g.title}</h4>
                      {list(g.highlights)}
                    </div>
                  ))}
                  {r.photos && (
                    <div class:list={['photos', { strip: r.strip }]}>
                      {r.photos.map(({ src, thumb, width, height, alt, story }) => (
                        <a
                          href={src}
                          class:list={{ 'has-story': story }}
                          data-story-title={story?.title}
                          data-story-audio={story?.audio}
                          data-story-captions={story?.captions}
                        >
                          <img src={thumb ?? src} alt={alt} width={width} height={height} style={width && height ? `aspect-ratio: ${width} / ${height}` : undefined} loading="lazy" decoding="async" />
                          {story && (
                            <span class="badge">
                              <span aria-hidden="true">▶</span> {story.title}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                  )}
                  {r.href && (
                    <a class="arrow-link visit" href={r.href} data-track={`career:visit:${r.id}`}>
                      {new URL(r.href).hostname.replace(/^www\./, '')} <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                  )}
                </li>
              );
            })
          }
        </ol>
      </section>

      <section id="initiatives" class="block" data-spy>
        <h2 class="block-title">Technology &amp; AI initiatives</h2>
        <div class="initiatives">
          {initiatives.map((i) => (
            <div class="initiative">
              <h3>{i.title}</h3>
              <ul class="plain">
                {i.items.map((t) => <li>{t}</li>)}
              </ul>
              {i.example && (
                <figure class="example">
                  <a href={i.example.href} data-track="career:example">
                    <img src={i.example.src} alt={i.example.alt} width="800" height="500" loading="lazy" decoding="async" />
                  </a>
                  <figcaption>
                    <a class="arrow-link" href={i.example.href} data-track="career:example">
                      {i.example.name} <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                    <p>{i.example.note}</p>
                  </figcaption>
                </figure>
              )}
            </div>
          ))}
        </div>
      </section>

      <section id="education" class="block" data-spy>
        <h2 class="block-title">Education</h2>
        <ul class="entries">
          {education.map((e) => (
            <li class="entry">
              <div class="name-row">
                <h3>{e.school}</h3>
