---
// Foreside Fiasco, the picture book, with Sam reading it: "Read it to me" plays the original
// recording with subtitles and turns the pages on cue (see Flipbook.astro).
import Flipbook, { type Book } from '../components/Flipbook.astro';

const dir = '/books/foreside-fiasco';
const book: Book = {
  title: 'Foreside Fiasco',
  byline: 'An unfortunate true story',
  description: 'Foreside Fiasco, an unfortunate true story: a picture book by Sam Peret, read aloud by the author with the pages turning on cue.',
  path: '/foreside-fiasco/',
  pages: 26,
  dir,
  pdf: '/books/foreside-fiasco.pdf',
  // Page proportions from the PDF (landscape letter).
  width: 1400,
  height: 1082,
  narration: { audio: `${dir}/narration.m4a`, captions: `${dir}/narration.vtt`, timing: `${dir}/narration.json` },
};
---

<Flipbook book={book} />
