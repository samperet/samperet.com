---
// Foreside Fiasco, the picture book, as a page-turning flipbook. Pages are images rendered
// from the PDF (public/books/foreside-fiasco/); page-flip animates the turns. Without
// JavaScript the pages simply stack, and the PDF is always there to download.
import Base from '../layouts/Base.astro';

const book = {
  title: 'Foreside Fiasco',
  byline: 'An unfortunate true story',
  pages: 26,
  dir: '/books/foreside-fiasco',
  pdf: '/books/foreside-fiasco.pdf',
  // Page proportions from the PDF (landscape letter).
  width: 1400,
  height: 1082,
};
// Sam reading the book: the original recording, subtitles, and when each verse starts (narration.json,
// timed by tools/story/align_book.py). "Read it to me" plays it and turns the pages on cue.
const narration = {
  audio: `${book.dir}/narration.m4a`,
  captions: `${book.dir}/narration.vtt`,
  timing: `${book.dir}/narration.json`,
};
const pageList = Array.from({ length: book.pages }, (_, i) => i + 1);
const pad = (n: number) => String(n).padStart(2, '0');
const description = 'Foreside Fiasco, an unfortunate true story: a picture book by Sam Peret, read aloud by the author with the pages turning on cue.';
---

<Base title="Foreside Fiasco · Samperet.com" description={description} path="/foreside-fiasco/" ogType="book" ogImage={`${book.dir}/01.webp`}>
    <header class="top">
      <a class="arrow-link home-btn" href="/" data-track="nav:home"><span class="arrow" aria-hidden="true">←</span> Home</a>
      <div>
        <h1>{book.title}</h1>
        <p class="byline">{book.byline}</p>
      </div>
    </header>

    <main>
      <div class="stage" data-stage>
        <div class="book" data-book data-pages={book.pages} data-width={book.width} data-height={book.height}>
          {
            pageList.map((n) => (
              <div class="page" data-density={n === 1 || n === book.pages ? 'hard' : 'soft'}>
                <img
                  src={`${book.dir}/${pad(n)}.webp`}
                  alt={n === 1 ? `${book.title}, cover` : `Page ${n}`}
                  width={book.width}
                  height={book.height}
                  loading={n <= 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                />
              </div>
            ))
          }
        </div>
      </div>

      <p class="subtitle" data-subtitle aria-live="polite" hidden></p>

      <div class="controls" data-controls hidden>
        <button
          type="button"
          class="read"
          data-read
          data-track="book:read-to-me"
          data-audio={narration.audio}
          data-captions={narration.captions}
          data-timing={narration.timing}
          aria-pressed="false"
        >
          <span class="read-icon" aria-hidden="true"></span>
          <span data-read-label>Read it to me</span>
        </button>
        <div class="progress" data-progress hidden>
          <div class="progress-track" data-seek><div class="progress-bar" data-bar></div></div>
          <span class="time" data-time>0:00</span>
        </div>
        <button type="button" data-prev data-track="book:prev" aria-label="Previous page">‹</button>
        <span class="counter" data-counter aria-live="polite">Cover</span>
        <button type="button" data-next data-track="book:next" aria-label="Next page">›</button>
        <span class="spacer"></span>
        <button type="button" data-fullscreen data-track="book:fullscreen">Full screen</button>
        <a href={book.pdf} download data-track="book:pdf">Download PDF</a>
      </div>
      <noscript><p class="hint">Pages are shown in order below. <a href={book.pdf}>Download the PDF</a> to read it as a book.</p></noscript>
    </main>

    <script>
      import { PageFlip } from 'page-flip';
      import { startTracking } from '../scripts/track';
      import { type Cue, cueAt, clock, loadCues, pickSource } from '../scripts/narration';

      startTracking();

      const stage = document.querySelector<HTMLElement>('[data-stage]')!;
      const bookEl = document.querySelector<HTMLElement>('[data-book]')!;
      const controls = document.querySelector<HTMLElement>('[data-controls]')!;
      const counter = document.querySelector<HTMLElement>('[data-counter]')!;
      const total = Number(bookEl.dataset.pages);
      const W = Number(bookEl.dataset.width);
      const H = Number(bookEl.dataset.height);

      const flip = new PageFlip(bookEl, {
        width: W,
        height: H,
        size: 'stretch',
        minWidth: 240,
        maxWidth: 1400,
        minHeight: 186,
        maxHeight: 1082,
        showCover: true,
        usePortrait: true,
        autoSize: true,
        mobileScrollSupport: false,
        flippingTime: 900,
        maxShadowOpacity: 0.45,
        showPageCorners: true,
      });
      flip.loadFromHTML(bookEl.querySelectorAll('.page'));
      document.documentElement.classList.add('flip-ready');
      controls.hidden = false;

      const label = () => {
        const i = flip.getCurrentPageIndex();
        if (i === 0) return 'Cover';
        if (i >= total - 1) return 'Back cover';
        const landscape = flip.getOrientation() === 'landscape';
        // With the cover alone, spreads pair odd indexes with the next page: show "2–3 of 26".
        const left = landscape ? (i % 2 === 1 ? i : i - 1) : i;
        const right = landscape ? Math.min(left + 1, total - 1) : left;
        return landscape && right !== left ? `${left + 1}–${right + 1} of ${total}` : `${left + 1} of ${total}`;
      };
      const update = () => (counter.textContent = label());
      flip.on('flip', update);
      flip.on('changeOrientation', update);
      update();

      document.querySelector('[data-prev]')!.addEventListener('click', () => flip.flipPrev());
      document.querySelector('[data-next]')!.addEventListener('click', () => flip.flipNext());
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'PageDown') flip.flipNext();
        if (e.key === 'ArrowLeft' || e.key === 'PageUp') flip.flipPrev();
      });

      // ---- Read it to me -----------------------------------------------------------------
      // The narration's timing lists when the title, the dedication and each verse begin. The
      // book follows the audio: shortly before each moment it turns to that page (the verse and
      // its painting as a spread; on a phone the verse first, then the painting halfway through).
      // Turning a page by hand pauses the reading; pressing play again brings the book back.

      type Timing = {
        intro: { page: number; start: number }[];
        verses: { page: number; start: number; art: number; end: number }[];
      };
      type Turn = { at: number; landscape: number; portrait: number };

      const readButton = document.querySelector<HTMLButtonElement>('[data-read]')!;
      const readLabel = readButton.querySelector<HTMLElement>('[data-read-label]')!;
      const progress = document.querySelector<HTMLElement>('[data-progress]')!;
      const bar = document.querySelector<HTMLElement>('[data-bar]')!;
      const time = document.querySelector<HTMLElement>('[data-time]')!;
      const subtitle = document.querySelector<HTMLElement>('[data-subtitle]')!;

      const audio = new Audio();
      audio.preload = 'none';
      let cues: Cue[] = [];
      let turns: Turn[] = [];
      let loaded: Promise<void> | undefined;
      const LEAD = 0.7; // start a turn this long before the words, so the page lands as they begin

      const load = () =>
        (loaded ??= (async () => {
          audio.src = pickSource(audio, readButton.dataset.audio!);
          const [timing, loadedCues] = await Promise.all([
            fetch(readButton.dataset.timing!).then((r) => r.json() as Promise<Timing>),
            loadCues(readButton.dataset.captions!),
          ]);
          cues = loadedCues;
          // Pages in the timing file count from 1; page-flip counts from 0.
          turns = [
            { at: 0, landscape: 0, portrait: 0 },
            ...timing.intro.filter((p) => p.page > 1).map((p) => ({ at: p.start, landscape: p.page - 1, portrait: p.page - 1 })),
            ...timing.verses.flatMap((v) => [
              { at: v.start, landscape: v.page - 1, portrait: v.page - 1 },
              { at: v.art, landscape: v.page - 1, portrait: v.page },
            ]),
          ];
          const last = timing.verses[timing.verses.length - 1];
          // After the last line, turn to "The End" (the page after the last painting).
          turns.push({ at: last.end + 1.2, landscape: last.page + 1, portrait: last.page + 1 });
        })());

      const landscape = () => flip.getOrientation() === 'landscape';
      // The page index that is showing, as a spread's first page when two show at once.
      const showing = (i: number) => (landscape() ? (i === 0 ? 0 : i % 2 === 1 ? i : i - 1) : i);
      const wantedAt = (t: number) => {
        let want = 0;
        for (const turn of turns) if (turn.at - LEAD <= t) want = landscape() ? turn.landscape : turn.portrait;
        return want;
      };

      let busy = false; // page-flip is mid-turn
      let ours = false; // the turn in progress is the narration's, not the reader's
      flip.on('changeState', (e) => {
        busy = e.data !== 'read';
      });
      flip.on('flip', () => {
        if (ours) ours = false;
        else if (!audio.paused) audio.pause(); // the reader turned a page: let them explore
      });

      const follow = (jump = false) => {
        if (busy || !turns.length) return;
        const want = wantedAt(audio.currentTime);
        const now = flip.getCurrentPageIndex();
        if (showing(want) === showing(now)) return;
        ours = true;
        // One spread away animates; further (after a seek or a wander) goes straight there.
        if (!jump && Math.abs(showing(want) - showing(now)) <= (landscape() ? 2 : 1)) flip.flip(want);
        else {
          flip.turnToPage(want);
          ours = false;
          update();
        }
      };

      const setReading = (on: boolean) => {
        readButton.setAttribute('aria-pressed', String(on));
        readButton.classList.toggle('playing', on);
        readLabel.textContent = on ? 'Pause' : audio.ended ? 'Read it again' : audio.currentTime > 0 ? 'Keep reading' : 'Read it to me';
      };

      audio.addEventListener('play', () => {
        setReading(true);
        follow(true);
      });
      audio.addEventListener('pause', () => setReading(false));
      audio.addEventListener('ended', () => {
        setReading(false);
        subtitle.textContent = '';
      });
      audio.addEventListener('timeupdate', () => {
        const t = audio.currentTime;
        const text = cueAt(cues, t);
        if (subtitle.textContent !== text) subtitle.textContent = text;
        if (audio.duration) bar.style.width = `${(t / audio.duration) * 100}%`;
        time.textContent = clock(t);
        if (!audio.paused) follow();
      });

      readButton.addEventListener('click', async () => {
        await load();
        progress.hidden = false;
        subtitle.hidden = false;
        if (!audio.paused) return audio.pause();
        if (audio.ended) audio.currentTime = 0;
        audio.play().catch(() => setReading(false));
      });

      document.querySelector('[data-seek]')!.addEventListener('click', (e) => {
        const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
        if (!audio.duration) return;
        audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
        follow(true);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === ' ' && !(e.target as HTMLElement).closest('button, a, input, textarea')) {
          e.preventDefault();
          readButton.click();
        }
      });

      flip.on('changeOrientation', () => follow(true));

      const fs = document.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
      if (!document.fullscreenEnabled) fs.hidden = true;
      fs.addEventListener('click', () => {
        if (document.fullscreenElement) void document.exitFullscreen();
        else void stage.requestFullscreen().catch(() => {});
      });
      document.addEventListener('fullscreenchange', () => {
        fs.textContent = document.fullscreenElement ? 'Exit full screen' : 'Full screen';
        // Give the stage its new size, then let the book refit.
        setTimeout(() => flip.update(), 50);
      });
    </script>
</Base>

<style is:global>
  :root {
    --stage: #e9e7e1;
  }

  .top {
    display: grid;
    gap: 0.75rem;
    width: min(80rem, 100% - 2rem);
    margin: 0 auto;
    padding: 1.5rem 0 1rem;
  }


  h1 {
    font-size: var(--text-2xl);
  }

  .byline {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  main {
    width: min(80rem, 100% - 2rem);
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  /* The stage is the grey table the book lies on; full screen fills it. */
  .stage {
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--stage);
  }

  .stage:fullscreen {
    padding: 2rem;
    border-radius: 0;
  }

  .book {
    width: 100%;
    max-width: 1400px;
  }

  /* Before page-flip takes over (and without JavaScript) pages stack with a gap. */
  html:not(.flip-ready) .book {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .page {
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
  }

  html:not(.flip-ready) .page {
    border-radius: var(--radius-lg);
  }

  .page img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* A faint fold line where the two pages meet. */
  .flip-ready .page[data-density='soft']:nth-child(even) img {
    box-shadow: inset -24px 0 24px -24px rgb(0 0 0 / 0.25);
  }

  .flip-ready .page[data-density='soft']:nth-child(odd) img {
    box-shadow: inset 24px 0 24px -24px rgb(0 0 0 / 0.25);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .controls[hidden] {
    display: none;
  }

  .controls button,
  .controls a {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    text-decoration: none;
  }

  .controls [data-prev],
  .controls [data-next] {
    width: 2.5rem;
    padding: 0.25rem 0 0.35rem;
    font-size: 1.5rem;
    line-height: 1;
    text-align: center;
  }

  .controls button:hover,
  .controls button:focus-visible,
  .controls a:hover,
  .controls a:focus-visible {
    border-color: currentColor;
  }

  .counter {
    min-width: 7rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .spacer {
    flex: 1;
  }

  .subtitle {
    min-height: 1.5em;
    margin: 0.85rem auto 0;
    max-width: 44rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    line-height: 1.4;
    font-style: italic;
  }

  .subtitle[hidden] {
    display: none;
  }

  .controls .read {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1.05rem 0.45rem 0.8rem;
    font-weight: 600;
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  .controls .read:hover,
  .controls .read:focus-visible {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .read-icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.4rem 0 0.4rem 0.65rem;
    border-color: transparent transparent transparent currentColor;
  }

  .read.playing .read-icon {
    width: 0.6rem;
    height: 0.75rem;
    border-width: 0 0.2rem;
    border-color: currentColor;
  }

  .progress {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 10rem;
    min-width: 8rem;
  }

  .progress[hidden] {
    display: none;
  }

  .progress-track {
    position: relative;
    flex: 1;
    height: 0.85rem;
    cursor: pointer;
  }

  .progress-track::before,
  .progress-bar {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 2px;
  }

  .progress-track::before {
    right: 0;
    background: var(--rule);
  }

  .progress-bar {
    width: 0;
    background: var(--accent);
  }

  .time {
    min-width: 2.4rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .hint {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

</style>
