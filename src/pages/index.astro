---
import { Font } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section, { type SectionData, type Photo } from '../components/Section.astro';
import { ALPS_PHOTOS, AIRBNB_PHOTOS } from '../data/photos';
import { sections, projects } from '../data/home';

const title = 'Samperet.com';
const description = 'Strategy, relationships, systems & design.';

// The footer's cards: every recommended book (src/data/books.ts), and every photo on the site,
// gathered by the card or career chapter it appears in, each photo once.
const slug = (value: string) => value.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const seen = new Set<string>();
const photoParts: SectionData[] = [];
const gather = (name: string, photos: Photo[] = []) => {
  const fresh = photos.filter((p) => !seen.has(p.src) && seen.add(p.src));
  if (fresh.length) photoParts.push({ name, id: `photos-${slug(name)}`, photos: fresh });
};
for (const s of sections) {
  gather(s.name, s.photos);
  for (const part of s.parts ?? []) gather(part.name, part.photos);
}
gather('ALPS', ALPS_PHOTOS);
gather('Airbnb', AIRBNB_PHOTOS);

const footerCards: SectionData[] = [
  { name: 'Recommended Books', tile: { color: 'var(--hackberry)' }, interests: 'all' },
  {
    name: 'Photos',
    tile: { src: '/travel/lava-flow-big-island.webp', alt: 'Two men throwing shakas at night in front of glowing red lava on the Big Island of Hawaiʻi' },
    parts: photoParts,
  },
];
---

<Base title={title} description={description} path="/">
  <Font slot="head" cssVariable="--font-oswald" />
  <main class="wrap-wide">
    <header class="hero">
      <h1 class="wordmark">Samperet<span class="dot">.</span>com</h1>
      <p class="lede tagline">strategy, relationships, systems <span class="amp">&amp;</span> design.</p>
      <nav class="hero-links" aria-label="Pages">
        <a class="arrow-link" href="/career/" data-track="nav:career">Career <span class="arrow" aria-hidden="true">→</span></a>
      </nav>
      <a class="arrow-link home-btn tile-home" href="/" data-home data-track="nav:home-tile"><span class="arrow" aria-hidden="true">←</span> Home</a>
    </header>

    <div class="tiles grid">
      {sections.map((section) => <Section section={section} />)}
    </div>

    <section class="projects" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      <div class="tiles grid small">
        {projects.map((section) => <Section section={section} />)}
      </div>
    </section>
  </main>

  <div slot="footer" class="tiles grid small footer-cards">
    {footerCards.map((section) => <Section section={section} />)}
  </div>

  <script>
    import { startTracking } from '../scripts/track';
    import { openTopic } from '../scripts/topics';

    startTracking();

    // Each closed tile's title is fitted to its card: the largest size at which it fills the
    // card's width without spilling or breaking a word, and covers no more than the lower three
    // fifths of the card. Refitted when the cards change size, a card opens or closes (its
    // children appear), and once the display face has loaded.
    const fitTitle = (title: HTMLElement) => {
      const face = title.closest<HTMLElement>('summary, .tile-face')!;
      if (!title.checkVisibility() || !face.clientHeight) return; // inside a closed card for now
      const padding = title.parentElement!.offsetHeight - title.offsetHeight;
      const maxHeight = face.clientHeight * 0.6 - padding;
      let lo = 14;
      let hi = Math.max(lo, Math.min(face.clientHeight * 0.42, 150));
      for (let i = 0; i < 12; i++) {
        const mid = (lo + hi) / 2;
        title.style.setProperty('--fit', `${mid}px`);
        if (title.scrollWidth <= title.clientWidth + 1 && title.offsetHeight <= maxHeight) lo = mid;
        else hi = mid;
      }
      title.style.setProperty('--fit', `${Math.floor(lo)}px`);
    };
    let fitQueued = false;
    const fitAll = () => {
      if (fitQueued) return;
      fitQueued = true;
      requestAnimationFrame(() => {
        fitQueued = false;
        for (const title of document.querySelectorAll<HTMLElement>('.tile:not([open]) > summary :is(h3, h4), .tile-link > .tile-face :is(h3, h4)'))
          fitTitle(title);
      });
    };
    const faces = new ResizeObserver(fitAll);
    for (const face of document.querySelectorAll('.tile > summary, .tile-link > .tile-face')) faces.observe(face);
    for (const tile of document.querySelectorAll('details.tile')) tile.addEventListener('toggle', fitAll);
    void document.fonts.ready.then(fitAll);
    fitAll();

    // Opening a tile shows it alone, like a page of its own: close its open siblings and go to
    // the top, where the header has shrunk to the wordmark, Career and a Home button.
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const summary of document.querySelectorAll<HTMLElement>('.tile > summary')) {
      summary.addEventListener('click', () => {
        const tile = summary.parentElement as HTMLDetailsElement;
        if (tile.open) return; // closing: the grid comes back by itself
        for (const sib of tile.parentElement!.children)
          if (sib !== tile && sib instanceof HTMLDetailsElement) sib.open = false;
        requestAnimationFrame(() => scrollTo({ top: 0, behavior: reduced() ? 'auto' : 'smooth' }));
      });
    }

    // Home dismisses the open card and brings back the grid.
    const grid = document.querySelector<HTMLElement>('.tiles')!;
    document.querySelector('[data-home]')!.addEventListener('click', (e) => {
      e.preventDefault();
      for (const t of document.querySelectorAll<HTMLDetailsElement>('.tile[open]')) t.open = false;
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      requestAnimationFrame(() => {
        scrollTo({ top: grid.getBoundingClientRect().top + scrollY - 24, behavior: reduced() ? 'auto' : 'smooth' });
        grid.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
      });
    });

    // Escape closes the innermost open tile.
    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || document.querySelector('dialog[open], .merlin-ask:not([hidden])')) return;
      const open = [...document.querySelectorAll<HTMLDetailsElement>('.tile[open]')].pop();
      if (open) {
        open.open = false;
        open.querySelector('summary')?.focus();
      }
    });

    // "Ask about setting it up" and the like open Merlin's message chat.
    for (const b of document.querySelectorAll('[data-message]')) b.addEventListener('click', () => openTopic('message'));

    // A card in parts (Yoga, Sufism, Get HeartWise) narrows to one: from the row of the parts'
    // names at its top, or Merlin's question the first time it opens. Its shelf keeps only the
    // books for that part's interests, and steps out when none are left. Closing it resets it.
    const partsOf = (card: HTMLElement) => card.querySelectorAll<HTMLElement>(':scope > .body > [data-part]');
    const narrow = (card: HTMLElement, id: string) => {
      for (const b of card.querySelectorAll<HTMLButtonElement>(':scope > .body > [data-part-nav] [data-focus]'))
        b.setAttribute('aria-pressed', String(b.dataset.focus === id));
      let interests: string[] | null = null;
      for (const part of partsOf(card)) {
        part.hidden = id !== '' && part.dataset.part !== id;
        if (part.dataset.part === id) interests = (part.dataset.interests ?? '').split(' ').filter(Boolean);
      }
      const shelf = card.querySelector<HTMLElement>(':scope > .body > [data-shelf]');
      if (!shelf) return;
      let shown = 0;
      for (const book of shelf.querySelectorAll<HTMLElement>('li[data-tags]')) {
        book.hidden = interests !== null && !book.dataset.tags!.split(' ').some((tag) => interests!.includes(tag));
        if (!book.hidden) shown++;
      }
      shelf.hidden = shown === 0;
    };
    const asked = new WeakSet<HTMLElement>();
    const askMerlin = (card: HTMLElement) => {
      if (asked.has(card) || !card.dataset.merlinAsks) return;
      asked.add(card);
      const options = [...partsOf(card)].map((part) => ({ id: part.dataset.part!, label: part.dataset.title! }));
      document.dispatchEvent(new CustomEvent('merlin:ask-focus', { detail: { card: card.id, question: card.dataset.merlinAsks, options } }));
    };
    for (const nav of document.querySelectorAll<HTMLElement>('[data-part-nav]')) {
      const card = nav.closest<HTMLDetailsElement>('details')!;
      nav.hidden = false;
      nav.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-focus]');
        if (!b) return;
        asked.add(card); // chosen already: Merlin needn't ask
        narrow(card, b.dataset.focus!);
      });
      card.addEventListener('toggle', () => {
        if (!card.open) narrow(card, '');
      });
      card.querySelector(':scope > summary')!.addEventListener('click', () => {
        if (!card.open) setTimeout(() => askMerlin(card), 400);
      });
    }
    document.addEventListener('merlin:focus', (e) => {
      const { card, id } = (e as CustomEvent<{ card: string; id: string }>).detail;
      const el = document.getElementById(card);
      if (!(el instanceof HTMLDetailsElement)) return;
      narrow(el, id);
      if (el.open) scrollTo({ top: 0, behavior: reduced() ? 'auto' : 'smooth' });
    });

    // Open the section a #hash points at, e.g. a shared link to #travel, closing any other.
    // Links shared before tiles were renamed still land on the right one. A part (#heartwise)
    // opens its card narrowed to it.
    const RENAMED: Record<string, string> = {
      adventure: 'travel-and-adventure',
      'emergency-first-response-efforts': 'travel-and-adventure',
      travel: 'travel-and-adventure',
      'humanitarian-relief': 'travel-and-adventure',
      samasanga: 'samasangha',
      'consciousness-yoga-and-self-development': 'yoga-spirituality-and-personal-development',
      'common-pastures-portal': 'communityos',
      'jayaandfiona-com': 'family',
      'foreside-fiasco': 'stories',
      'golden-berry': 'stories',
      'bear-shark': 'stories',
    };
    // Tiles that became pages of their own.
    const MOVED: Record<string, string> = { 'mens-group': '/mens-group/', 'mens-work': '/mens-group/' };
    const fromHash = () => {
      const id = location.hash.slice(1);
      if (MOVED[id]) return location.replace(MOVED[id]);
      const target = id && document.getElementById(RENAMED[id] ?? id);
      if (!target || !target.closest('details.tile')) return;
      for (const open of document.querySelectorAll<HTMLDetailsElement>('details.tile[open]')) if (!open.contains(target)) open.open = false;
      // Open the card and every card it sits inside.
      for (let el = target.closest('details'); el; el = el.parentElement?.closest('details') ?? null) {
        if (el.dataset.merlinAsks && target !== el) asked.add(el);
        el.open = true;
      }
      if (target.dataset.part) narrow(target.closest('details')!, target.dataset.part);
      else if (target.dataset.merlinAsks) setTimeout(() => askMerlin(target), 400);
      requestAnimationFrame(() => scrollTo({ top: 0, behavior: 'auto' }));
    };
    addEventListener('hashchange', fromHash);
    fromHash();
  </script>
</Base>

<style is:global>
  main {
    padding-bottom: var(--s4); /* the footer keeps its own distance */
  }

  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: var(--s8) 0;
  }

  .wordmark {
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .wordmark .dot {
    color: var(--dot);
  }

  .tagline {
    margin-top: var(--s4);
    max-width: 30ch;
    font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
  }

  .hero .arrow-link {
    font-size: var(--text-md);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s6);
    margin-top: var(--s6);
  }

  .hero .tile-home {
    margin-top: var(--s6);
  }

  /* While a card is open the page reads as that card's own page: the header shrinks and a Home
     link dismisses the card. */
  .tile-home {
    display: none;
    margin-top: var(--s4);
  }

  body:has(.tile[open]) .tile-home {
    display: inline-flex;
  }

  /* …and Career steps aside, so Home is the one way out. */
  body:has(.tile[open]) .hero-links {
    display: none;
  }

  body:has(.tile[open]) .hero {
    min-height: 0;
    padding: var(--s7) 0 var(--s6);
  }

  /* ---- Tiles ------------------------------------------------------------------------- */

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--s4);
    align-items: start;
  }

  /* Projects: smaller cards under their own heading. */
  .projects {
    display: grid;
    gap: var(--s4);
    margin-top: var(--s8);
  }

  .projects > h2 {
    font-size: var(--text-xl);
  }

  .tiles.small {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--s3);
  }

  /* With a card open, only it shows: the other grids and the Projects heading step out too. */
  body:has(.tile[open]) .grid:not(:has(> .tile[open])),
  body:has(.tile[open]) .projects > h2 {
    display: none;
  }

  body:has(.tile[open]) .projects {
    margin-top: 0;
  }

  /* The footer's cards (Recommended Books, Photos) are reached by the footer's text links and
     show only while open: in the footer, straight under the header, like a page of their own. */
  .footer-cards:not(:has(> .tile[open])) {
    display: none;
  }

  body:has(.footer-cards > .tile[open]) main {
    padding-bottom: 0;
  }

  body:has(.footer-cards > .tile[open]) .site-footer {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 640px) {
    .tiles.small {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tile {
    position: relative;
    min-width: 0;
    scroll-margin-top: var(--s5);
  }

  /* An open tile takes the whole row; its picture becomes a banner and the story follows. */
  .tile[open] {
    grid-column: 1 / -1;
  }

  /* While a tile is open, only it shows: its siblings step out until it closes. */
  .tiles:has(> .tile[open]) > .tile:not([open]) {
    display: none;
  }

  .tile > summary,
  .tile-link > .tile-face {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--tile-color, var(--hof));
    color: #fff;
    cursor: pointer;
    list-style: none;
  }

  /* An open tile reads as a page: no picture across the top, no kind or line, just its title. */
  .tile[open] > summary {
    aspect-ratio: auto;
    min-height: 2.5rem;
    overflow: visible;
    border-radius: 0;
    background: none;
    color: var(--fg);
  }

  .tile[open] > summary .face,
  .tile[open] > summary .kind,
  .tile[open] > summary .line {
    display: none;
  }

  .tile[open] > summary .caption {
    position: static;
    padding: 0;
    background: none;
  }

  .tile[open] > summary h3 {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }

  .tile.child[open] > summary h4 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .tile > summary::-webkit-details-marker {
    display: none;
  }

  .tile > summary:focus-visible,
  .tile-link:focus-visible {
    outline-offset: 3px;
  }

  /* A tile that is a link: the whole picture goes to its page. */
  .tile-link {
    display: block;
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
  }

  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter var(--fast) var(--ease);
  }

  .tile > summary:hover .face,
  .tile-link:hover .face {
    filter: brightness(0.92);
  }

  /* Words sit on a soft shade at the foot of the picture. */
  /* A plain block, so a long word can't stretch the title wider than the card. */
  .caption {
    position: absolute;
    inset: auto 0 0 0;
    display: block;
    padding: var(--s6) var(--s5) var(--s4);
    background: linear-gradient(to top, rgb(20 21 22 / 0.8), rgb(20 21 22 / 0.5) 60%, transparent);
  }

  .tile.is-color .caption {
    background: none;
  }

  /* The title is the whole face: as big as the card allows. The script sets --fit to the
     largest size at which it fills the card's width, breaks no word and keeps to the lower
     three fifths of the card; until then (and without script) it scales with the card. */
  .tile > summary,
  .tile-link > .tile-face {
    container-type: inline-size;
  }

  .tile h3,
  .tile h4 {
    font-size: var(--fit, clamp(1.75rem, 10cqi, 4.5rem));
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: normal;
  }

  /* No mark in the corner, open or closed: Home closes an open card. */
  .toggle-mark {
    display: none;
  }

  .toggle-mark {
    position: absolute;
    top: var(--s3);
    right: var(--s3);
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius);
    background: rgb(20 21 22 / 0.45);
    transition: background var(--fast) var(--ease);
  }

  .toggle-mark::before,
  .toggle-mark::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.85rem;
    height: 2px;
    background: #fff;
    transform: translate(-50%, -50%);
    transition: transform var(--fast) var(--ease);
  }

  .toggle-mark::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .tile > summary:hover .toggle-mark,
  .tile > summary:focus-visible .toggle-mark {
    background: var(--accent);
  }

  /* On a link tile, an arrow in the corner where the plus would be. */
  .go-mark {
    position: absolute;
    top: var(--s3);
    right: var(--s3);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius);
    background: rgb(20 21 22 / 0.45);
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    transition: background var(--fast) var(--ease), transform var(--fast) var(--ease);
  }

  .tile-link:hover .go-mark,
  .tile-link:focus-visible .go-mark {
    background: var(--accent);
    transform: translateX(0.15em);
  }

  .tile[open] > summary .toggle-mark {
    background: var(--accent);
  }

  .tile[open] > summary .toggle-mark::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .tile[open] > summary .toggle-mark::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .tile .body {
    display: grid;
    gap: var(--s4);
    padding: var(--s5) 0 var(--s7);
  }

  .tile .text {
    max-width: var(--measure);
  }

  .text p {
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s5);
  }

  .tile .children {
    margin-top: var(--s2);
  }

  .tile .children .body {
    padding-bottom: var(--s5);
  }

  .cover {
    position: relative;
    display: block;
    width: min(100%, 28rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .cover img {
    width: 100%;
    height: auto;
  }

  /* A justified gallery: every photo whole, at its own shape. Each one starts at the row
     height (--row) and grows in proportion to its width, so a row fills the width and its
     photos share one height; the filler after the last photo keeps a short last row from
     stretching. */
  .photos {
    --row: 11rem;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .photos::after {
    content: '';
    flex: 1000 1 0;
  }

  .photos img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .photos a {
    position: relative;
    display: block;
    flex: var(--ratio, 1.333) 1 calc(var(--ratio, 1.333) * var(--row));
  }

  .photos a:hover img,
  .photos a:focus-visible img {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .photos .badge,
  .cover .badge {
    position: absolute;
    left: var(--s3);
    bottom: var(--s3);
    max-width: calc(100% - var(--s6));
  }

  /* ---- Memories archive: a recording per row, its transcript folded beneath ---------- */

  .memories .eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }

  .memories ul {
    list-style: none;
    margin: var(--s3) 0 0;
    padding: 0;
    max-width: var(--measure);
  }

  .memory {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s4);
    align-items: start;
    padding: var(--s3) 0;
    border-top: var(--hairline);
  }

  .memory:last-child {
    border-bottom: var(--hairline);
  }

  .memory-play {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    transition: background var(--fast) var(--ease);
  }

  .memory-play:hover,
  .memory-play:focus-visible {
    background: var(--accent-strong);
  }

  .memory-icon {
    width: 0;
    height: 0;
    margin-left: 0.15rem;
    border-style: solid;
    border-width: 0.45rem 0 0.45rem 0.7rem;
    border-color: transparent transparent transparent currentColor;
  }

  .memory.playing .memory-icon {
    width: 0.65rem;
    height: 0.8rem;
    margin-left: 0;
    border-width: 0 0.22rem;
    border-color: currentColor;
  }

  .memory-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s3);
  }

  .memory-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 500;
  }

  .memory-time {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .memory-track {
    position: relative;
    height: 3px;
    margin: var(--s2) 0;
    border-radius: 2px;
    background: var(--rule);
  }

  .memory-track span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 2px;
    background: var(--accent);
  }

  .memory-transcript summary {
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .memory-transcript summary:hover {
    color: var(--fg);
  }

  .memory-transcript p {
    margin-top: var(--s2);
    font-family: var(--font-display);
    font-style: italic;
    color: var(--muted);
  }

