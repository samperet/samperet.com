---
import Base from '../layouts/Base.astro';
import Section, { type SectionData } from '../components/Section.astro';

const title = 'Samperet.com';
const description = 'Strategy, relationships, systems & design.';

// Copy is deliberately thin — edit freely. Each section is a tile: `tile` is its face, `body` the
// longer text that unfolds when it opens;
// `topics` decides which of Merlin's questions (see scripts/topics.ts) opens the section.
// The professional chapters (ALPS, Founders Wanted, Airbnb) live on /career/.
const sections: SectionData[] = [
  {
    name: 'Travel & Adventure',
    topics: ['adventure', 'personal'],
    line: 'Places, adventures and disaster relief that shaped how I see things.',
    tile: { kind: 'Travel & adventure', src: '/travel/camel.webp', position: 'center 60%' },
    embed: '/globe/index.html',
    embedTitle: 'A globe tracing my travels: drag to turn it',
    embedRatio: '16 / 10',
    body: [
      'Japan, Nepal, Hong Kong, Shenzhen, Malaysia, the Philippines, Germany, Switzerland, France, Spain, Italy, the Czech Republic, Amsterdam, Moldova, Ukraine, and Mexico, plus multiple drives across the USA.',
      'I’ve also lived in Maui, Australia, and India.',
      'Went to New Orleans after Hurricane Katrina, and to Tacloban, Philippines, after Typhoon Haiyan.',
      'In Tacloban we were the first Americans to arrive, and paved the way for the relief efforts that followed by converting a ransacked hospital into a distribution warehouse.',
    ],
    photos: [
      { src: '/travel/australia-pinnacles.jpg', alt: 'Tree pose on a limestone pillar in the Pinnacles desert, Western Australia' },
      { src: '/travel/pinnacle-perch.webp', alt: 'Sitting on top of a limestone pinnacle in the Pinnacles desert' },
      { src: '/travel/india-cafe.jpg', alt: 'Working on a laptop in a beach café in India, under a hand-painted menu board' },
      { src: '/travel/temple-floor.webp', alt: 'Sitting on the stone floor of an old pillared temple in India, legs stretched out in the shade' },
      { src: '/travel/temple-niche.webp', alt: 'Two friends sitting in a niche of a carved stone temple façade in India' },
      { src: '/travel/nepal-stupa.jpg', alt: 'Sitting cross-legged on a brick wall beside a stupa in Nepal' },
      { src: '/travel/camel.webp', alt: 'Riding a decorated camel with two young men in a desert valley, the camel stretching up to eat from a tree' },
      { src: '/travel/train-window.webp', alt: 'In a captain’s hat in a train compartment, talking with a fellow traveler through the open window' },
      { src: '/travel/high-desert.webp', alt: 'A windswept selfie in a paisley shirt and bandana on a wide high-desert plain, hills behind' },
      { src: '/travel/coast-selfie.webp', alt: 'A selfie with a companion on a grassy headland above the sea, sea stacks behind' },
      { src: '/travel/white-sand.webp', alt: 'A faded print: shirtless in jeans on a wide white beach, a shirt over one shoulder' },
      { src: '/travel/two-hats.webp', alt: 'Two travellers in wide-brimmed hats, grinning, on an overgrown trail' },
      { src: '/travel/cliff-jump.webp', alt: 'Leaping from a sea cliff into the water' },
      { src: '/travel/mast-top.webp', alt: 'Sitting out at the end of a wooden boom, high against a clear blue sky' },
      { src: '/travel/paramotor-sky.webp', alt: 'A paramotor under a yellow wing, high in a clear blue sky' },
      { src: '/travel/paramotor-snow.webp', alt: 'Strapped into a paramotor on the snow, propeller cage behind, about to take off' },
      { src: '/photos/tacloban-hospital.jpg', alt: 'The relief team on the steps of R.T. Romualdez Hospital in Tacloban' },
      { src: '/photos/tacloban-c130.jpg', alt: 'The team in scrubs with backpacks beside a C-130 on a rain-soaked runway' },
      { src: '/photos/new-orleans-katrina.jpg', alt: 'Volunteers with a resident beside a storm-damaged house marked FEMA in New Orleans' },
    ],
  },
  {
    name: 'Yoga, Spirituality & Personal Development',
    topics: ['personal'],
    line: 'Yogi, Sufi, group leader, lifelong student.',
    tile: { kind: 'Practice', src: '/photos/acro-sunset.webp', alt: 'Acro yoga silhouetted against the sunset on a beach', position: 'center 40%' },
    body: [
      'Yoga has been a pillar in my life since I was 18 years old. Beyond the physical benefits of asana, yoga has provided a foundation of community, health, and spiritual growth.',
      'With a focus on Patanjali’s eight-limbed path to enlightenment, I’m currently enrolled in eighth series Ashtanga, aka parenting.',
      'I pay homage to the many teachers who have crossed my path, given generously of their wisdom, and paved the path for what is to come.',
      'During a six-month pilgrimage through India, I stumbled upon a Sufi community in Rajasthan. That planted the seed for what would later lead me to my life partner, Mackensie, and my initiation into the Ruhaniat lineage of Sufism, where I received my spiritual name. You can hear more about this in [the podcast](https://mcleanp.substack.com/p/day-447-the-family-of-things?utm_source=substack&utm_medium=web&utm_content=embedded-post), hosted by a dear brother of mine through the ManKind Project (MKP).',
      'MKP has also played a pivotal role in my development since my initiation in 2012: I have joined and built men’s circles, participated in and facilitated trainings, and cultivated a fascination with circle dynamics that would later lead to my work with Heart iQ.',
      'I built [samasangha.org](https://samasangha.org) for my Sufi teachers, and [intelligentembodiment.com](https://www.intelligentembodiment.com) for Mackensie.',
    ],
    books: [
      {
        title: 'How Yoga Works',
        author: 'Geshe Michael Roach & Christie McNally',
        cover: '/reading/how-yoga-works.webp',
        href: 'https://openlibrary.org/works/OL490414W',
        width: 328,
        height: 500,
      },
      {
        title: 'Death: An Inside Story',
        author: 'Sadhguru',
        cover: '/reading/death-an-inside-story.webp',
        href: 'https://openlibrary.org/works/OL22292279W',
        width: 230,
        height: 360,
      },
      {
        title: 'The Magus of Java',
        author: 'Kosta Danaos',
        cover: '/reading/the-magus-of-java.webp',
        href: 'https://openlibrary.org/works/OL7796870W',
        width: 317,
        height: 475,
      },
    ],
    photos: [
      { src: '/photos/yoga-squat.webp', alt: 'A deep squat on a mat on a stone patio, a dog lying alongside' },
      { src: '/photos/acro-balance.webp', alt: 'Acro yoga under the palms: balancing on a partner’s feet, hands joined' },
      { src: '/photos/acro-sunset.webp', alt: 'Acro yoga silhouetted against the sunset on a beach' },
      { src: '/travel/sunset-beach-friends.webp', alt: 'Laughing with a friend on a wide beach at sunset, the tide out' },
      { src: '/travel/shore-circle.webp', alt: 'A yoga group seated cross-legged on the sand as a wave breaks on the rocks behind them' },
      { src: '/travel/pinnacles-handstand.webp', alt: 'A handstand on the sand among the limestone pillars of the Pinnacles' },
    ],
    children: [
      {
        name: 'Intelligent Embodiment',
        topics: ['family', 'personal'],
        line: 'Awake in the body.',
        tile: { kind: 'My partner’s work', src: '/tiles/intelligent-embodiment.webp', position: 'center 30%' },
        body: [
          'My life partner, Mackensie Grant, practises intuitive massage and bodywork in Charlotte, Vermont. Specializing with women, she draws on craniosacral therapy, polarity therapy and Temple Lomi, and three decades of yoga, qigong and teaching. Her sessions meet physical tension and pain, and often lead to insight about its deeper roots.',
          'I designed and built intelligentembodiment.com for her.',
        ],
        href: 'https://www.intelligentembodiment.com',
      },
    ],
  },
  {
    name: 'HeartWise',
    topics: ['personal'],
    line: 'Exquisite circles of healing and transformation, since 2016.',
    tile: { kind: 'Circles', src: '/photos/heartwise-circle.webp', alt: 'A HeartWise circle: some thirty people piled together, smiling, on the floor of a studio after a workshop' },
    body: [
      'HeartWise is where I bring Heart iQ to people. Heart iQ starts from a simple observation: some parts of us only appear in the presence of other people. Most personal growth happens alone, reading and reflecting, yet the places shaped in relationship stay hidden in solitude and return when someone comes close. A circle that is held well enough, for long enough, becomes a place to be met rather than to perform or be fixed, and the group can reach places together that none of us could reach alone.',
      'I have been leading exquisite circles of healing and transformation since 2016.',
    ],
    links: [
      { label: 'getheartwise.com', href: 'https://www.getheartwise.com' },
      { label: 'heartiq.org', href: 'https://heartiq.org' },
    ],
    photos: [
      { src: '/photos/heartwise-circle.webp', alt: 'A HeartWise circle: some thirty people piled together, smiling, on the floor of a studio after a workshop' },
      { src: '/photos/heartwise-group.webp', alt: 'A HeartWise group standing together under the beams of a timber hall after a workshop' },
      { src: '/photos/heartwise-rug-circle.webp', alt: 'A circle on a patterned rug in a bright room, snow outside, one person standing to speak' },
      { src: '/photos/heartwise-embrace.webp', alt: 'A HeartWise circle in a heap of hugs on a living-room floor' },
    ],
  },
  {
    name: 'CommunityOS',
    topics: ['personal'],
    line: 'A free portal for communities that organize in circles.',
    tile: { kind: 'Project · Open source', src: '/tiles/common-pastures.webp', position: 'center 70%' },
    body: [
      'A community portal for groups that organize with circles, as in sociocracy: a directory of members and the circles they serve on, with open seats; proposals a circle consents to at a meeting, with who was there; shared documents, a forum, a calendar, a loan library and the skills neighbors offer.',
      'I built it for the Common Pastures community, and any other community is free to use it. If you’d like help setting it up for yours, reach out.',
    ],
    links: [{ label: 'The code on GitHub', href: 'https://github.com/samperet/CommonPasturesPortal' }],
    message: 'Ask about setting it up',
  },
  {
    name: 'Percentage Allocator',
    topics: ['personal'],
    line: 'Split any amount across line items, always adding up to 100%.',
    tile: { kind: 'App · Open source', src: '/tiles/percentcalc.webp', position: 'center top' },
    body: [
      'A small calculator for dividing a total: drag a slider and the other items rebalance, lock an item to hold its share, link items so they move together, and share the result as a link. It installs on a phone like an app and works offline.',
    ],
    links: [
      { label: 'Open the app', href: 'https://samperet.com/percentcalc/' },
      { label: 'The code on GitHub', href: 'https://github.com/samperet/percentcalc' },
    ],
    embed: '/percentcalc/index.html',
    embedTitle: 'Percentage Allocator, a calculator for splitting an amount',
    embedRatio: '4 / 3',
    embedAllow: 'clipboard-write',
  },
  {
    name: 'Family',
    topics: ['family'],
    line: 'Jaya, Fiona, Mackensie and the things we make together.',
    tile: { kind: 'Family', src: '/photos/family-beach.webp', alt: 'The family on the beach, the girls riding on our shoulders and waving', position: 'center 30%' },
    photos: [
      { src: '/photos/family-beach.webp', alt: 'The family on the beach, the girls riding on our shoulders and waving' },
      { src: '/photos/jaya-and-fiona.webp', alt: 'Jaya and Fiona in red dresses, side by side' },
    ],
    memories: [
      {
        title: 'Take a nap',
        audio: '/memories/take-a-nap.m4a',
        duration: '0:38',
        transcript: [
          '“Because I don’t have any stories when my nap comes up.”',
          '“Are you going to take a nap every day?” “Every single day.”',
          '“What if you don’t want to take a nap? What should you tell yourself?”',
          '“I should tell myself I have a very short nap.”',
          '“Okay. Even if you don’t want to?” “Even if I don’t want to. Do it anyways.”',
          '“Give us one story.” “Deal.”',
        ],
      },
    ],
    children: [
      {
        name: 'jayaandfiona.com',
        topics: ['family'],
        line: 'Jaya and Fiona’s Fun Zone.',
        tile: { kind: 'Project · For my kids', src: '/tiles/jayaandfiona.webp', position: 'top' },
        href: 'https://jayaandfiona.com',
        embed: 'https://jayaandfiona.com/',
        body: [
          'Hosting experiences for my kids that make learning and communicating fun.',
          'Making things for them was my entrance to vibe coding, before the term was coined.',
        ],
      },
    ],
  },
];
---

<Base title={title} description={description} path="/">
  <main class="wrap-wide">
    <header class="hero">
      <h1 class="wordmark">Samperet<span class="dot">.</span>com</h1>
      <p class="lede tagline">strategy, relationships, systems <span class="amp">&amp;</span> design.</p>
      <nav class="hero-links" aria-label="Pages">
        <a class="arrow-link" href="/career/" data-track="nav:career">Career <span class="arrow" aria-hidden="true">→</span></a>
        <a class="arrow-link" href="/stories/" data-track="nav:stories">Stories <span class="arrow" aria-hidden="true">→</span></a>
      </nav>
      <a class="arrow-link home-btn tile-home" href="/" data-home data-track="nav:home-tile"><span class="arrow" aria-hidden="true">←</span> Home</a>
    </header>

    <div class="tiles">
      {sections.map((section) => <Section section={section} />)}
    </div>
  </main>

  <script>
    import { startTracking } from '../scripts/track';
    import { openTopic } from '../scripts/topics';

    startTracking();

    // Opening a tile shows it alone, like a page of its own: close its open siblings and go to
    // the top, where the header has shrunk to the wordmark, Career and a Home button.
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const summary of document.querySelectorAll<HTMLElement>('.tile > summary')) {
      summary.addEventListener('click', () => {
        const tile = summary.parentElement as HTMLDetailsElement;
        if (tile.open) return; // closing: the grid comes back by itself
        for (const sib of tile.parentElement!.children)
          if (sib !== tile && sib instanceof HTMLDetailsElement) sib.open = false;
        requestAnimationFrame(() => scrollTo({ top: 0, behavior: reduced() ? 'auto' : 'smooth' }));
      });
    }

    // Home dismisses the open card and brings back the grid.
    const grid = document.querySelector<HTMLElement>('.tiles')!;
    document.querySelector('[data-home]')!.addEventListener('click', (e) => {
      e.preventDefault();
      for (const t of document.querySelectorAll<HTMLDetailsElement>('.tile[open]')) t.open = false;
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      requestAnimationFrame(() => {
        scrollTo({ top: grid.getBoundingClientRect().top + scrollY - 24, behavior: reduced() ? 'auto' : 'smooth' });
        grid.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
      });
    });

    // Escape closes the innermost open tile.
    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || document.querySelector('dialog[open], .merlin-ask:not([hidden])')) return;
      const open = [...document.querySelectorAll<HTMLDetailsElement>('.tile[open]')].pop();
      if (open) {
        open.open = false;
        open.querySelector('summary')?.focus();
      }
    });

    // "Ask about setting it up" and the like open Merlin's message chat.
    for (const b of document.querySelectorAll('[data-message]')) b.addEventListener('click', () => openTopic('message'));

    // Open the section a #hash points at, e.g. a shared link to #travel.
    // Links shared before tiles were renamed still land on the right one.
    const RENAMED: Record<string, string> = {
      adventure: 'travel-and-adventure',
      'emergency-first-response-efforts': 'travel-and-adventure',
      travel: 'travel-and-adventure',
      'humanitarian-relief': 'travel-and-adventure',
      samasanga: 'yoga-spirituality-and-personal-development',
      samasangha: 'yoga-spirituality-and-personal-development',
      'consciousness-yoga-and-self-development': 'yoga-spirituality-and-personal-development',
      'common-pastures-portal': 'communityos',
    };
    // Tiles that became pages of their own.
    const MOVED: Record<string, string> = { 'foreside-fiasco': '/stories/' };
    const fromHash = () => {
      const id = location.hash.slice(1);
      if (MOVED[id]) return location.replace(MOVED[id]);
      const target = id && document.getElementById(RENAMED[id] ?? id);
      // Open the row and every row it sits inside.
      for (let el = target instanceof HTMLDetailsElement ? target : null; el; el = el.parentElement?.closest('details') ?? null) el.open = true;
    };
    addEventListener('hashchange', fromHash);
    fromHash();
  </script>
</Base>

<style is:global>
  main {
    padding-bottom: var(--s9);
  }

  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: var(--s8) 0;
  }

  .wordmark {
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .wordmark .dot {
    color: var(--dot);
  }

  .tagline {
    margin-top: var(--s4);
    max-width: 30ch;
    font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
  }

  .hero .arrow-link {
    font-size: var(--text-md);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s6);
    margin-top: var(--s6);
  }

  .hero .tile-home {
    margin-top: var(--s6);
  }

  /* While a card is open the page reads as that card's own page: the header shrinks and a Home
     link dismisses the card. */
  .tile-home {
    display: none;
    margin-top: var(--s4);
  }

  main:has(.tile[open]) .tile-home {
    display: inline-flex;
  }

  /* …and Career steps aside, so Home is the one way out. */
  main:has(.tile[open]) .hero-links {
    display: none;
  }

  main:has(.tile[open]) .hero {
    min-height: 0;
    padding: var(--s7) 0 var(--s6);
  }

  /* ---- Tiles ------------------------------------------------------------------------- */

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--s4);
    align-items: start;
  }

  .tile {
    position: relative;
    min-width: 0;
    scroll-margin-top: var(--s5);
  }

  /* An open tile takes the whole row; its picture becomes a banner and the story follows. */
  .tile[open] {
    grid-column: 1 / -1;
  }

  /* While a tile is open, only it shows: its siblings step out until it closes. */
  .tiles:has(> .tile[open]) > .tile:not([open]) {
    display: none;
  }

  .tile > summary {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--tile-color, var(--hof));
    color: #fff;
    cursor: pointer;
    list-style: none;
  }

  .tile[open] > summary {
    aspect-ratio: auto;
    height: clamp(12rem, 30vw, 20rem);
  }

  .tile > summary::-webkit-details-marker {
    display: none;
  }

  .tile > summary:focus-visible {
    outline-offset: 3px;
  }

  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter var(--fast) var(--ease);
  }

  .tile > summary:hover .face {
    filter: brightness(0.92);
  }

  /* Words sit on a soft shade at the foot of the picture. */
  .caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--s1);
    padding: var(--s7) var(--s5) var(--s4);
    background: linear-gradient(to top, rgb(20 21 22 / 0.78), rgb(20 21 22 / 0.45) 55%, transparent);
  }

  .tile.is-color .caption {
    background: none;
  }

  .kind {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .tile h3,
  .tile h4 {
    /* A step under --text-xl, so the longest names still sit inside the picture. */
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 1.9rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .tile.child h4 {
    font-size: var(--text-lg);
  }

  .caption .line {
    font-size: var(--text-sm);
    opacity: 0.9;
  }

  /* A plus in the corner that turns to a cross when the tile is open. */
  .toggle-mark {
    position: absolute;
    top: var(--s3);
    right: var(--s3);
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius);
    background: rgb(20 21 22 / 0.45);
    transition: background var(--fast) var(--ease);
  }

  .toggle-mark::before,
  .toggle-mark::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.85rem;
    height: 2px;
    background: #fff;
    transform: translate(-50%, -50%);
    transition: transform var(--fast) var(--ease);
  }

  .toggle-mark::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .tile > summary:hover .toggle-mark,
  .tile > summary:focus-visible .toggle-mark {
    background: var(--accent);
  }

  .tile[open] > summary .toggle-mark {
    background: var(--accent);
  }

  .tile[open] > summary .toggle-mark::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .tile[open] > summary .toggle-mark::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .tile .body {
    display: grid;
    gap: var(--s4);
    padding: var(--s5) 0 var(--s7);
  }

  .tile .text {
    max-width: var(--measure);
  }

  .text p {
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s5);
  }

  .tile .children {
    margin-top: var(--s2);
  }

  .tile .children .body {
    padding-bottom: var(--s5);
  }

  .cover {
    position: relative;
    display: block;
    width: min(100%, 28rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .cover img {
    width: 100%;
    height: auto;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--s2);
  }

  .photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .photos a {
    position: relative;
    display: block;
  }

  .photos a:hover img,
  .photos a:focus-visible img {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .photos .badge,
  .cover .badge {
    position: absolute;
    left: var(--s3);
    bottom: var(--s3);
    max-width: calc(100% - var(--s6));
  }

  /* ---- Memories archive: a recording per row, its transcript folded beneath ---------- */

  .memories .eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }

  .memories ul {
    list-style: none;
    margin: var(--s3) 0 0;
    padding: 0;
    max-width: var(--measure);
  }

  .memory {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s4);
    align-items: start;
    padding: var(--s3) 0;
    border-top: var(--hairline);
  }

  .memory:last-child {
    border-bottom: var(--hairline);
  }

  .memory-play {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    transition: background var(--fast) var(--ease);
  }

  .memory-play:hover,
  .memory-play:focus-visible {
    background: var(--accent-strong);
  }

  .memory-icon {
    width: 0;
    height: 0;
    margin-left: 0.15rem;
    border-style: solid;
    border-width: 0.45rem 0 0.45rem 0.7rem;
    border-color: transparent transparent transparent currentColor;
  }

