---
const title = 'Samperet.com';
const description = 'Strategy, relationships, systems, design, & code.';

// Copy is deliberately thin — edit freely.
const sections = [
  {
    name: 'Acadialps.com',
    line: 'Enterprise marketplace connecting innovative solutions, senior advisors, and enterprise customers.',
    href: 'https://acadialps.com',
  },
  { name: 'Founders Wanted', line: 'Looking for builders to start something with.' },
  { name: 'Automation', line: 'Systems that do the repetitive work.' },
  { name: 'Design', line: 'Clear interfaces, considered details.' },
  { name: 'jayaandfiona.com', line: "Jaya and Fiona's Fun Zone.", href: 'https://jayaandfiona.com' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <main>
      <header class="hero">
        <h1>Samperet.com</h1>
        <h2>strategy, relationships, systems, design, &amp; code.</h2>
      </header>

      {
        sections.map(({ name, line, href }) => (
          <section class="item">
            <h3>{href ? <a href={href}>{name}</a> : name}</h3>
            <p>{line}</p>
          </section>
        ))
      }
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #111111;
    --muted: #57534e;
    --rule: #e7e5e4;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0c0c;
      --fg: #f5f5f4;
      --muted: #a8a29e;
      --rule: #292524;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    width: 80%;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  @media (max-width: 640px) {
    main {
      width: auto;
      margin: 0 1rem;
    }
  }

  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  h2 {
    margin: 1.25rem 0 0;
    max-width: 32ch;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--muted);
    line-height: 1.4;
  }

  .item {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 2fr;
    gap: 0.5rem 2rem;
    align-items: baseline;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }

  .item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: 1fr;
    }
  }

  h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  h3 a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  h3 a:hover,
  h3 a:focus-visible {
    text-decoration-color: currentColor;
  }

  .item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
