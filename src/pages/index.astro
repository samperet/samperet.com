---
import Section, { type SectionData } from '../components/Section.astro';
import PhotoViewer from '../components/PhotoViewer.astro';

const title = 'Samperet.com';
const description = 'Strategy, relationships, systems & design.';

// Copy is deliberately thin — edit freely. `body` is the longer text under each row;
// `topics` decides which of Merlin's questions (see scripts/topics.ts) opens the section.
const sections: SectionData[] = [
  {
    name: 'Acadialps.com',
    topics: ['professional'],
    line: 'A strategic sales channel built for C-suite conversations.',
    href: 'https://acadialps.com',
    embed: 'https://www.acadialps.com/',
    body: [
      'Recruited 220+ senior advisors, many of them former Big 4 consultants, to build a strategic sales channel dedicated to C-suite conversations.',
    ],
  },
  {
    name: 'Founders Wanted',
    topics: ['professional'],
    line: 'Turning stagnant intellectual property into companies.',
    body: [
      'Searching through thousands of pieces of stagnant intellectual property, and commercializing the viable ones by injecting marketing, recruiting, and seed money.',
      'Projects successfully launched include AI Parkinson’s detection, NASA-based rock blasting, and IoT consumer devices.',
    ],
  },
  {
    name: 'Airbnb',
    topics: ['professional'],
    line: 'Early host, PDX founder.',
    body: [
      'One of the first 2,000 hosts to sign up. By the time I started working there, my host ID was too short to use as a badge number.',
      'A PDX founder, in the first batch of hires to open the Portland office. I played a critical role in designing the customer service processes and building the office itself, including Brian Chesky’s favorite table, inspired by Twin Peaks, and a honeybee room with custom laser-cut bee-nest chandeliers.',
    ],
    photos: [
      {
        src: '/photos/airbnb-bearshark.jpg',
        alt: 'A bear-shark sculpture, half polar bear and half shark, suspended from the ceiling of an Airbnb office',
        // Sam tells the story over the photo; the captions are the subtitles.
        story: { title: 'The story of the bear shark', audio: '/stories/bear-shark.m4a', captions: '/stories/bear-shark.vtt' },
      },
      { src: '/photos/airbnb-wood-ball.jpg', alt: 'Selfie in safety glasses in a workshop, in front of a giant sphere made of patchwork wood' },
    ],
  },
  {
    name: 'Automation',
    topics: ['professional'],
    line: 'Automating things since childhood.',
    merlin: true,
    body: [
      'I was automating things as a young child: building games in HyperCard, and later designing home automation routines in Xcode.',
    ],
  },
  {
    name: 'Design',
    topics: ['professional'],
    line: 'Deep attention to detail.',
    body: [
      'Aesthetic design, systems design, and onboarding UX design all capture my deep attention to detail.',
      'I enjoy elements of surprise and delight, context awareness, and memorable user experiences.',
    ],
  },
  {
    name: 'Consciousness, Yoga & Self Development',
    topics: ['personal'],
    line: 'Facilitator, group leader, lifelong student.',
    body: [
      'A facilitator of HeartIQ, a body of work from the Netherlands.',
      'Leading men’s groups through the ManKind Project since 2012.',
    ],
  },
  {
    name: 'Adventure',
    topics: ['adventure'],
    line: 'Relief work and travel, near and far.',
    children: [
      {
        name: 'Humanitarian Relief',
        topics: ['personal', 'adventure'],
        line: 'Showing up after disasters.',
        body: [
          'Went to New Orleans after Hurricane Katrina, and to Tacloban, Philippines, after Typhoon Haiyan.',
          'In Tacloban we were the first Americans to arrive, and paved the way for the relief efforts that followed by converting a ransacked hospital into a distribution warehouse.',
        ],
        photos: [
          { src: '/photos/tacloban-hospital.jpg', alt: 'The relief team on the steps of R.T. Romualdez Hospital in Tacloban' },
          { src: '/photos/tacloban-c130.jpg', alt: 'The team in scrubs with backpacks beside a C-130 on a rain-soaked runway' },
          { src: '/photos/new-orleans-katrina.jpg', alt: 'Volunteers with a resident beside a storm-damaged house marked FEMA in New Orleans' },
        ],
      },
      {
        name: 'Travel',
        topics: ['adventure'],
        line: 'Places that shaped how I see things.',
        body: [
          'Japan, Nepal, Hong Kong, Shenzhen, Malaysia, the Philippines, Germany, Switzerland, France, Spain, Italy, the Czech Republic, Amsterdam, Moldova, Ukraine, and Mexico, plus multiple drives across the USA.',
          'I’ve also lived in Maui, Australia, and India.',
        ],
        photos: [
          { src: '/travel/australia-pinnacles.jpg', alt: 'Tree pose on a limestone pillar in the Pinnacles desert, Western Australia' },
          { src: '/travel/india-cafe.jpg', alt: 'Working on a laptop in a beach café in India, under a hand-painted menu board' },
          { src: '/travel/nepal-stupa.jpg', alt: 'Sitting cross-legged on a brick wall beside a stupa in Nepal' },
        ],
      },
    ],
  },
  {
    name: 'Foreside Fiasco',
    topics: ['personal', 'family'],
    line: 'A picture book I wrote, illustrated by Cynthia Eiger.',
    body: [
      'Dedicated to Steve, Lurana and the Foreside Manor. Acadia Publishing, 2025.',
      'Read it page by page, or download the PDF.',
    ],
    cover: {
      src: '/books/foreside-fiasco/cover-560.webp',
      alt: 'Foreside Fiasco cover: a shingled house with green shutters under a summer sky',
      href: '/foreside-fiasco/',
      label: 'Read the book',
      width: 560,
      height: 433,
    },
  },
  {
    name: 'jayaandfiona.com',
    topics: ['family'],
    line: 'Jaya and Fiona’s Fun Zone.',
    href: 'https://jayaandfiona.com',
    embed: 'https://jayaandfiona.com/',
    body: [
      'Hosting experiences for my kids that make learning and communicating fun.',
      'Making things for them was my entrance to vibe coding, before the term was coined.',
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sam Peret" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <main>
      <header class="hero">
        <div class="hero-text">
          <h1>Samperet.com</h1>
          <h2>strategy, relationships, systems &amp; design.</h2>
        </div>
        <img
          class="portrait"
          src="/photos/sam-peret.webp"
          srcset="/photos/sam-peret-400.webp 400w, /photos/sam-peret.webp 800w"
          sizes="(max-width: 640px) 9rem, 18rem"
          width="800"
          height="1000"
          alt="Sam Peret, smiling, in a dark pinstripe jacket and open blue shirt"
          fetchpriority="high"
        />
      </header>

      {
        sections.map((section) => <Section section={section} />)
      }
    </main>

    <PhotoViewer />

    <script>
      import { startTracking } from '../scripts/track';

      startTracking();

      // Open the section a #hash points at, e.g. a shared link to #travel.
      const fromHash = () => {
        const target = location.hash && document.getElementById(location.hash.slice(1));
        // Open the row and every row it sits inside.
        for (let el = target instanceof HTMLDetailsElement ? target : null; el; el = el.parentElement?.closest('details') ?? null) el.open = true;
      };
      addEventListener('hashchange', fromHash);
      fromHash();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #111111;
    --muted: #57534e;
    --rule: #e7e5e4;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0c0c;
      --fg: #f5f5f4;
      --muted: #a8a29e;
      --rule: #292524;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    width: 80%;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  @media (max-width: 640px) {
    main {
      width: auto;
      margin: 0 1rem;
    }
  }

  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
    padding: 4rem 0;
  }

  .portrait {
    flex: none;
    width: 18rem;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      justify-content: center;
    }

    .portrait {
      width: 9rem;
      border-radius: 50%;
      aspect-ratio: 1;
      object-position: 50% 20%;
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  h2 {
    margin: 1.25rem 0 0;
    max-width: 32ch;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--muted);
    line-height: 1.4;
  }

  .item {
    border-top: 1px solid var(--rule);
  }

  .item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* Child rows sit inside their parent's body, indented under its heading. */
  .body .children {
    grid-column: 1 / -1;
  }

  .item.child:last-child {
    border-bottom: none;
  }

  .item.child summary {
    padding: 1.1rem 0;
  }

  .item.child summary h4 {
    padding-left: 1.25rem;
  }

  .item.parent > .body {
    padding-bottom: 0;
  }

  /* Heading and one-liner stay visible; everything else opens with the row. */
  summary,
  .body {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 2fr 1.5rem;
    gap: 0.5rem 2rem;
  }

  summary {
    align-items: baseline;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  summary .line {
    margin: 0;
    line-height: 1.5;
  }

  .chevron {
    justify-self: end;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: translateY(-0.2rem) rotate(45deg);
    transition: transform 0.2s;
  }

  .item[open] > summary .chevron {
    transform: translateY(0.1rem) rotate(-135deg);
  }

  .body {
    padding-bottom: 2rem;
  }

  .body .text {
    grid-column: 2;
  }

  .body .text:empty {
    display: none;
  }

  @media (max-width: 640px) {
    summary {
      grid-template-columns: 1fr 1.5rem;
    }

    summary .line {
      grid-column: 1;
    }

    .chevron {
      grid-row: 1;
      grid-column: 2;
    }

    .body {
      grid-template-columns: 1fr;
    }

    .body .embed,
    .body .photos {
      grid-column: 1;
    }

    .body .text {
      grid-column: 1;
    }

    .item.child summary .line {
      padding-left: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }

  h3,
  h4 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  h3 a,
  h4 a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  h3 a:hover,
  h3 a:focus-visible,
  h4 a:hover,
  h4 a:focus-visible {
    text-decoration-color: currentColor;
  }

  .text {
    max-width: 60ch;
  }

  /* Embeds, photo rows and covers span the heading and text columns. */
  .body .embed,
  .body .photos,
  .body .cover {
    grid-column: 1 / -1;
  }

  .cover {
    position: relative;
    display: block;
    width: min(100%, 28rem);
    margin-top: 1rem;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .photos img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
  }

  .photos a {
    position: relative;
    display: block;
  }

  .story-badge {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    max-width: calc(100% - 1.2rem);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.65);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    backdrop-filter: blur(4px);
  }

  .photos a:hover .story-badge,
  .photos a:focus-visible .story-badge {
    background: rgb(0 0 0 / 0.85);
  }

  .embed {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 5;
    min-height: 10rem;
    margin-top: 1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #fff;
  }

  .text p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .text p:last-child {
    margin-bottom: 0;
  }



</style>
