---
import Merlin from '../components/Merlin.astro';

const title = 'Samperet.com';
const description = 'Strategy, relationships, systems, design, & code.';

// Copy is deliberately thin — edit freely. `body` is the longer text under each row.
const sections = [
  {
    name: 'Acadialps.com',
    line: 'A strategic sales channel built for C-suite conversations.',
    href: 'https://acadialps.com',
    embed: 'https://www.acadialps.com/',
    body: [
      'Recruited 220+ senior advisors, many of them former Big 4 consultants, to build a strategic sales channel dedicated to C-suite conversations.',
    ],
  },
  {
    name: 'Founders Wanted',
    line: 'Turning stagnant intellectual property into companies.',
    body: [
      'Searching through thousands of pieces of stagnant intellectual property, and commercializing the viable ones by injecting marketing, recruiting, and seed money.',
      'Projects successfully launched include AI Parkinson’s detection, NASA-based rock blasting, and IoT consumer devices.',
    ],
  },
  {
    name: 'Airbnb',
    line: 'Early host, PDX founder.',
    body: [
      'One of the first 2,000 hosts to sign up. By the time I started working there, my host ID was too short to use as a badge number.',
      'A PDX founder, in the first batch of hires to open the Portland office. I played a critical role in designing the customer service processes and building the office itself, including Brian Chesky’s favorite table, inspired by Twin Peaks, and a honeybee room with custom laser-cut bee-nest chandeliers.',
    ],
    photos: [
      { src: '/photos/airbnb-bearshark.jpg', alt: 'A bear-shark sculpture, half polar bear and half shark, suspended from the ceiling of an Airbnb office' },
      { src: '/photos/airbnb-wood-ball.jpg', alt: 'Selfie in safety glasses in a workshop, in front of a giant sphere made of patchwork wood' },
    ],
  },
  {
    name: 'Automation',
    line: 'Automating things since childhood.',
    merlin: true,
    body: [
      'I was automating things as a young child: building games in HyperCard, and later designing home automation routines in Xcode.',
    ],
  },
  {
    name: 'Design',
    line: 'Deep attention to detail.',
    body: [
      'Aesthetic design, systems design, and onboarding UX design all capture my deep attention to detail.',
      'I enjoy elements of surprise and delight, context awareness, and memorable user experiences.',
    ],
  },
  {
    name: 'Consciousness, Yoga & Self Development',
    line: 'Facilitator, group leader, lifelong student.',
    body: [
      'A facilitator of HeartIQ, a body of work from the Netherlands.',
      'Leading men’s groups through the ManKind Project since 2012.',
    ],
  },
  {
    name: 'Humanitarian Relief',
    line: 'Showing up after disasters.',
    body: [
      'Went to New Orleans after Hurricane Katrina, and to Tacloban, Philippines, after Typhoon Haiyan.',
      'In Tacloban we were the first Americans to arrive, and paved the way for the relief efforts that followed by converting a ransacked hospital into a distribution warehouse.',
    ],
    photos: [
      { src: '/photos/tacloban-hospital.jpg', alt: 'The relief team on the steps of R.T. Romualdez Hospital in Tacloban' },
      { src: '/photos/tacloban-c130.jpg', alt: 'The team in scrubs with backpacks beside a C-130 on a rain-soaked runway' },
      { src: '/photos/new-orleans-katrina.jpg', alt: 'Volunteers with a resident beside a storm-damaged house marked FEMA in New Orleans' },
    ],
  },
  {
    name: 'Travel',
    line: 'Places that shaped how I see things.',
    body: [
      'Japan, Nepal, Moldova, Ukraine, Hong Kong, Shenzhen, Malaysia, and the Philippines, plus multiple drives across the USA.',
      'I’ve also lived in Maui, Australia, and India.',
    ],
    photos: [
      { src: '/travel/australia-pinnacles.jpg', alt: 'Tree pose on a limestone pillar in the Pinnacles desert, Western Australia' },
      { src: '/travel/india-cafe.jpg', alt: 'Working on a laptop in a beach café in India, under a hand-painted menu board' },
      { src: '/travel/nepal-stupa.jpg', alt: 'Sitting cross-legged on a brick wall beside a stupa in Nepal' },
    ],
  },
  {
    name: 'jayaandfiona.com',
    line: 'Jaya and Fiona’s Fun Zone.',
    href: 'https://jayaandfiona.com',
    embed: 'https://jayaandfiona.com/',
    body: [
      'Hosting experiences for my kids that make learning and communicating fun.',
      'Making things for them was my entrance to vibe coding, before the term was coined.',
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <main>
      <header class="hero">
        <h1>Samperet.com</h1>
        <h2>strategy, relationships, systems, design, &amp; code.</h2>
      </header>

      {
        sections.map(({ name, line, href, embed, body, merlin, photos }) => (
          <section class="item">
            {embed && (
              <iframe
                class="embed"
                src={embed}
                title={`${name}, live site`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
              />
            )}
            <h3>{href ? <a href={href}>{name}</a> : name}</h3>
            <div class="text">
              <p class="line">{line}</p>
              {body.map((para) => <p>{para}</p>)}
              {merlin && <Merlin />}
            </div>
            {photos && photos.length > 0 && (
              <div class="photos">
                {photos.map(({ src, alt }) => (
                  <a href={src}>
                    <img src={src} alt={alt} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
          </section>
        ))
      }
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #111111;
    --muted: #57534e;
    --rule: #e7e5e4;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0c0c;
      --fg: #f5f5f4;
      --muted: #a8a29e;
      --rule: #292524;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    width: 80%;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  @media (max-width: 640px) {
    main {
      width: auto;
      margin: 0 1rem;
    }
  }

  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  h2 {
    margin: 1.25rem 0 0;
    max-width: 32ch;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--muted);
    line-height: 1.4;
  }

  .item {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 2fr;
    gap: 0.5rem 2rem;
    align-items: start;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
  }

  .item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: 1fr;
    }
  }

  h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  h3 a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  h3 a:hover,
  h3 a:focus-visible {
    text-decoration-color: currentColor;
  }

  .text {
    max-width: 60ch;
  }

  /* Embeds and photo rows span the heading and text columns. */
  .embed,
  .photos {
    grid-column: 1 / -1;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .photos img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
  }

  .embed {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 5;
    min-height: 10rem;
    margin-bottom: 1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #fff;
  }

  .text p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .text p:last-child {
    margin-bottom: 0;
  }

  .text .line {
    color: var(--fg);
    line-height: 1.5;
  }

</style>
