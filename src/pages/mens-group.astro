---
// The men's group: what it is, its four rounds (each opens its explanation when clicked), and
// the application form, which posts to /api/apply. Without JavaScript the rounds are all open
// and the form posts itself; the page's #applied and #apply-failed notes answer it.
import Base from '../layouts/Base.astro';

type Round = { id: string; name: string; weeks: string; line: string; color: string; ink: string; body: string[]; shadow: string };

const rounds: Round[] = [
  {
    id: 'lover',
    name: 'Lover',
    weeks: 'Weeks 1–3',
    line: 'Feeling, connection and aliveness.',
    color: 'var(--ebisu)',
    ink: 'var(--fg)',
    body: [
      'The Lover is the part of a man that feels: joy, grief, desire, beauty, the plain pleasure of being alive. We begin here because a circle is built on connection.',
      'These weeks are for getting to know each other, slowing down, and learning to say what is actually going on inside.',
    ],
    shadow: 'Chasing more and more sensation, or going numb and feeling nothing at all.',
  },
  {
    id: 'warrior',
    name: 'Warrior',
    weeks: 'Weeks 4–6',
    line: 'Purpose, boundaries and commitment.',
    color: 'var(--tirol)',
    ink: 'var(--fg)',
    body: [
      'The Warrior is energy in service of something: a clear aim, discipline, the courage to act and the courage to say no.',
      'These weeks look at what you are fighting for, where your yes and your no are clear and where they aren’t, and the commitments you keep and the ones you avoid.',
    ],
    shadow: 'Turning harsh and controlling, or collapsing and never showing up for the fight.',
  },
  {
    id: 'magician',
    name: 'Magician',
    weeks: 'Weeks 7–9',
    line: 'Awareness, insight and change.',
    color: 'var(--hackberry)',
    ink: '#fff',
    body: [
      'The Magician sees beneath the surface: the patterns we repeat, the stories we tell ourselves, the feelings behind our reactions.',
      'These weeks turn the circle’s attention inward, to the beliefs and old wounds that run us, and to how they change once they are seen.',
    ],
    shadow: 'Using what he knows to manipulate, or playing innocent to avoid responsibility.',
  },
  {
    id: 'king',
    name: 'King',
    weeks: 'Weeks 10–12',
    line: 'Order, blessing and leadership.',
    color: 'var(--beach)',
    ink: 'var(--fg)',
    body: [
      'The King holds the whole: he sets a direction, makes order, and blesses the people around him.',
      'The last round brings the first three together, feeling, purpose and insight, into a mature way of leading your own life, your family and your work. We close the circle in the final week.',
    ],
    shadow: 'Becoming a tyrant, or a weakling who gives his power away.',
  },
];

const description =
  'A free men’s group, weekly for three months, in four rounds: Lover, Warrior, Magician and King. Apply to join; time, place and start date are set once five men are accepted.';
---

<Base title="Men’s Group · Samperet.com" description={description} path="/mens-group/">
  <main class="wrap mg">
    <a class="arrow-link home-btn" href="/" data-track="nav:home"><span class="arrow" aria-hidden="true">←</span> Home</a>

    <header class="mg-head">
      <span class="eyebrow">Men’s group</span>
      <h1>A men’s group, weekly for three months.</h1>
      <p class="lede">Twelve weeks in four rounds: Lover, Warrior, Magician and King.</p>
    </header>

    <dl class="mg-facts">
      <div><dt>Cost</dt><dd>Free</dd></div>
      <div><dt>Meets</dt><dd>Weekly, for three months</dd></div>
      <div><dt>Rounds</dt><dd>Four, three weeks each</dd></div>
      <div><dt>Time, place &amp; start date</dt><dd>Set once five men are accepted</dd></div>
    </dl>

    <div class="mg-intro measure">
      <p>
        A small circle of men, meeting once a week to be honest about our lives: what we feel, what we want, where we are stuck, and what we are
        here to do. No one is fixed or lectured; each man is met, heard and challenged by the others.
      </p>
      <p>
        I have joined and built men’s circles since my initiation into the ManKind Project in 2012, and have led circles of healing and
        transformation since 2016. The rounds follow the four archetypes of mature masculinity that Robert Moore and Douglas Gillette
        describe in <cite>King, Warrior, Magician, Lover</cite>.
      </p>
    </div>

    <section class="mg-rounds" aria-labelledby="rounds-title">
      <h2 id="rounds-title">The four rounds</h2>
      <p class="muted mg-hint">Choose a round to read about it.</p>
      <div class="round-tiles">
        {
          rounds.map((r) => (
            <button
              type="button"
              class="round-tile"
              id={`round-${r.id}`}
              aria-expanded="false"
              aria-controls={`round-${r.id}-panel`}
              style={`--round-color: ${r.color}; --round-ink: ${r.ink}`}
              data-track={`mens-group:round:${r.id}`}
            >
              <span class="round-meta">{r.weeks}</span>
              <span class="round-name">{r.name}</span>
              <span class="round-line">{r.line}</span>
              <span class="round-mark" aria-hidden="true"></span>
            </button>
          ))
        }
      </div>
      {
        rounds.map((r, i) => (
          <div class="round-panel" id={`round-${r.id}-panel`} role="region" aria-labelledby={`round-${r.id}`} style={`--round-color: ${r.color}`} hidden>
            <h3>
              <span class="round-panel-meta">Round {i + 1} · {r.weeks}</span>
              {r.name}
            </h3>
            {r.body.map((p) => <p>{p}</p>)}
            <p class="round-shadow">
              <strong>In shadow:</strong> {r.shadow}
            </p>
          </div>
        ))
      }
      <noscript><style>.round-panel[hidden] { display: block; }</style></noscript>
    </section>

    <section class="mg-apply" id="apply" aria-labelledby="apply-title">
      <h2 id="apply-title">Apply to join</h2>
      <p class="muted measure">
        The group begins once five men have been accepted. I’ll read every application and write back to each of you, and to those accepted
        with the time, place and start date.
      </p>

      <p class="mg-note mg-done" id="applied" tabindex="-1" data-done>
        <strong>Thank you<span data-done-name></span>.</strong> Your application is in. Once five men have been accepted, I’ll write to you
        with the time, place and start date.
      </p>
      <p class="mg-note mg-failed" id="apply-failed" tabindex="-1">
        That didn’t go through. Try again, or write to <a href="mailto:sam@peret.net?subject=Men%E2%80%99s%20group">sam@peret.net</a>.
      </p>

      <form class="mg-form" method="post" action="/api/apply" data-apply>
        <div class="field-row">
          <label class="field">
            <span>Name</span>
            <input name="name" autocomplete="name" maxlength="100" required />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" maxlength="200" required />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>Phone <em>optional</em></span>
            <input name="phone" type="tel" autocomplete="tel" maxlength="50" />
          </label>
          <label class="field">
            <span>Where do you live? <em>optional</em></span>
            <input name="lives" autocomplete="address-level2" maxlength="200" placeholder="Town or city" />
          </label>
        </div>
        <label class="field">
          <span>What draws you to the group?</span>
          <textarea name="why" rows="5" maxlength="4000" required></textarea>
        </label>
        <label class="field">
          <span>Have you sat in a men’s circle, or done other men’s work, before? <em>optional</em></span>
          <textarea name="experience" rows="3" maxlength="4000"></textarea>
        </label>
        <label class="field">
          <span>Which days and times usually work for you? <em>optional</em></span>
          <input name="times" maxlength="1000" placeholder="Weekday evenings, Sunday mornings…" />
        </label>
        <label class="check">
          <input type="checkbox" name="commit" value="yes" required />
          <span>I can commit to meeting weekly for three months.</span>
        </label>
        <div class="hp" aria-hidden="true">
          <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p class="mg-error" role="alert" data-error></p>
        <div class="mg-submit">
          <button type="submit" class="btn btn-accent" data-track="mens-group:apply">Send my application <span aria-hidden="true">→</span></button>
          <span class="muted">Free. No commitment until you are accepted.</span>
        </div>
      </form>
    </section>
  </main>

  <script>
    import { sessionId, startTracking, track } from '../scripts/track';

    startTracking();

    // The rounds: one explanation open at a time; clicking the open round closes it.
    const tiles = [...document.querySelectorAll<HTMLButtonElement>('.round-tile')];
    const show = (open: HTMLButtonElement | null) => {
      for (const tile of tiles) {
        const on = tile === open;
        tile.setAttribute('aria-expanded', String(on));
        document.getElementById(tile.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    for (const tile of tiles) {
      tile.addEventListener('click', () => show(tile.getAttribute('aria-expanded') === 'true' ? null : tile));
    }
    // A link to a round (#lover) opens it.
    const fromHash = () => {
      const tile = document.getElementById(`round-${location.hash.slice(1)}`);
      if (tile instanceof HTMLButtonElement) show(tile);
    };
    addEventListener('hashchange', fromHash);
    fromHash();

    // The form: checked here, sent as JSON, answered in place.
    const form = document.querySelector<HTMLFormElement>('[data-apply]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.noValidate = true; // checked below, with messages in the site's voice
    form.addEventListener('input', () => (error.textContent = ''));

    const problem = () => {
      for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')) {
        if (field.name === 'website' || field.checkValidity()) continue;
        field.focus();
        if (field.name === 'commit') return 'The group asks for twelve weeks. Tick the box if you can commit to them.';
        if (field.name === 'email' && field.value.trim()) return 'That email address doesn’t look right.';
        const label = field.closest('label')?.querySelector('span')?.textContent?.trim();
        return `${label ?? 'This'} is needed.`;
      }
      return null;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.textContent = '';
      const missing = problem();
      if (missing) {
        error.textContent = missing;
        return;
      }
      const data = Object.fromEntries(new FormData(form));
      button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, session: sessionId() }),
        });
        const reply = await res.json().catch(() => ({ ok: false }));
        if (!reply.ok) throw new Error(reply.error ?? 'That didn’t go through. Try again, or write to sam@peret.net.');
        track('click', 'mens-group:applied');
        done.querySelector('[data-done-name]')!.textContent = `, ${String(data.name).trim().split(/\s+/)[0]}`;
        done.classList.add('shown');
        form.hidden = true;
        done.focus();
      } catch (err) {
        error.textContent = err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'That didn’t go through. Try again, or write to sam@peret.net.';
      } finally {
        button.disabled = false;
      }
    });
  </script>
</Base>

<style is:global>
  .mg {
    padding: var(--s6) 0 var(--s9);
    display: grid;
  }

  .mg-head {
    display: grid;
    gap: var(--s3);
    margin: var(--s7) 0 var(--s6);
  }

  .mg-head h1 {
    font-size: clamp(2.5rem, 1.4rem + 5vw, 5rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    max-width: 16ch;
  }

  .mg-head .lede {
    font-size: clamp(1.125rem, 1rem + 1vw, 1.5rem);
  }

  /* The facts: a row of hairline-topped cells, no boxes. */
  .mg-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--s4) var(--s5);
    margin: 0 0 var(--s7);
  }

  .mg-facts > div {
    padding-top: var(--s3);
    border-top: 2px solid var(--fg);
  }

  .mg-facts dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mg-facts dd {
    margin: var(--s1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .mg-intro {
    margin-bottom: var(--s8);
    font-size: var(--text-md);
  }

  .mg-intro cite {
    font-style: italic;
  }

  /* ---- The rounds ---- */
  .mg-rounds {
    margin-bottom: var(--s8);
  }

  .mg-hint {
    margin: var(--s2) 0 var(--s5);
  }

  .round-tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s3);
  }

  .round-tile {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--s1);
    min-height: 13rem;
    padding: var(--s7) var(--s4) var(--s4); /* clear of the corner mark */
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--round-color);
    color: var(--round-ink);
    text-align: left;
    transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
  }

  .round-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .round-tile:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .round-meta {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .round-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .round-line {
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  /* A plus in the corner that turns into a minus while the round is open. */
  .round-mark {
    position: absolute;
    top: var(--s3);
    right: var(--s3);
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid currentColor;
    border-radius: var(--radius);
    opacity: 0.8;
  }

  .round-mark::before,
  .round-mark::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.75rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate var(--fast) var(--ease);
  }

  .round-mark::after {
    rotate: 90deg;
  }

  .round-tile[aria-expanded='true'] .round-mark::after {
    rotate: 0deg;
  }

  /* The open round wears an ink ring, so it reads as the one the explanation below belongs to. */
  .round-tile[aria-expanded='true'] {
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--fg);
  }

  .round-panel {
    max-width: var(--measure);
    margin-top: var(--s5);
    padding: var(--s1) 0 var(--s1) var(--s5);
    border-left: 4px solid var(--round-color);
  }

  .round-panel h3 {
    display: grid;
    gap: var(--s1);
    margin-bottom: var(--s3);
    font-size: var(--text-xl);
  }

  .round-panel-meta {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .round-panel p {
    font-size: var(--text-md);
  }

  .round-shadow {
    color: var(--muted);
  }

  .round-shadow strong {
    color: var(--fg);
    font-weight: 600;
  }

  /* ---- The form ---- */
  .mg-apply {
    display: grid;
    gap: var(--s4);
    padding-top: var(--s7);
    border-top: var(--hairline);
    scroll-margin-top: var(--s5);
  }

  .mg-form {
    display: grid;
    gap: var(--s4);
    max-width: 44rem;
    margin-top: var(--s3);
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--s4);
  }

  .field {
    display: grid;
    gap: var(--s2);
  }

  .field > span {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .field em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    line-height: 1.5;
    transition: border-color var(--fast) var(--ease);
  }

  .field textarea {
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--faint);
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--muted);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--fg);
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .check {
    display: flex;
    align-items: start;
    gap: var(--s3);
    font-weight: 600;
    cursor: pointer;
  }

  .check input {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.2rem 0 0;
    accent-color: var(--accent);
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .mg-error:empty {
    display: none;
  }

  .mg-error {
    color: var(--hackberry);
    font-weight: 600;
  }

  .mg-submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s5);
  }

  .mg-submit .btn {
    padding: 0.8rem 1.3rem;
    font-size: var(--text-base);
  }

  .mg-submit .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .mg-submit .muted {
    font-size: var(--text-sm);
  }

  /* The answers: shown after sending, or when the no-script form lands back on #applied. */
  .mg-note {
    display: none;
    max-width: 44rem;
    padding: var(--s4) var(--s5);
    border-left: 4px solid var(--accent);
    background: var(--accent-soft);
    font-size: var(--text-md);
    outline: none;
  }

  .mg-failed {
    border-left-color: var(--hackberry);
    background: #f6e9f0;
  }

  .mg-note.shown,
  .mg-note:target {
    display: block;
  }

  .mg-form[hidden],
  .mg-done:target ~ .mg-form {
    display: none;
  }

  @media (max-width: 760px) {
    .round-tiles {
      grid-template-columns: repeat(2, 1fr);
    }

    .round-tile {
      min-height: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .round-tile:hover {
      transform: none;
    }
  }
</style>
