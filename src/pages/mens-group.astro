---
// The men's group in Charlotte, VT. Its own look, darker and rougher than the rest of the site:
// near-black paper with grain, Oswald for headings, square edges. Merlin and the photo viewer stay
// off this page.
//
// The four archetypes sit on a wheel, Lover at the top, and it turns clockwise with the scroll,
// bringing Warrior, Magician and King to the top in turn; the words turn with the wheel, upright
// when their wedge is on top. The explanations sit beside it.
//
// The application asks one question at a time, like Typeform: Enter moves on, letters pick
// choices, and an optional video answers "When have you felt most alive?". It posts to
// /api/apply. Without JavaScript every explanation shows, the questions are one plain form, the
// video is left out, and the page's #applied and #apply-failed notes answer the post.
import { Font } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { GROUP } from '../data/mens-group';

type Archetype = { id: string; name: string; element: string; line: string; color: string; ink: string; body: string[]; shadow: string };

// Colours follow each archetype's element in Cliff Barry's Shadow Work map (MKP publishes none):
// Kazan for the Lover's water, burnt sienna for the Warrior's earth, Hackberry for the
// Magician's air, Beach gold for the King's fire.
const archetypes: Archetype[] = [
  {
    id: 'lover',
    name: 'Lover',
    element: 'Water',
    line: 'Feeling. Connection. Aliveness.',
    color: 'var(--kazan)',
    ink: '#fff',
    body: [
      'The part of you that feels: joy, grief, desire, beauty, the plain fact of being alive. We start here because a circle runs on connection.',
      'Slow down. Get to know each other. Say what is actually going on inside.',
    ],
    shadow: 'Chasing the next hit, or going numb.',
  },
  {
    id: 'warrior',
    name: 'Warrior',
    element: 'Earth',
    line: 'Purpose. Boundaries. Commitment.',
    color: '#a3472a',
    ink: '#fff',
    body: [
      'Energy in service of something: a clear aim, discipline, the guts to act and the guts to say no.',
      'What are you fighting for? Where is your yes a yes and your no a no? Which commitments do you keep, and which do you dodge?',
    ],
    shadow: 'Harsh and controlling, or collapsed and missing from the fight.',
  },
  {
    id: 'magician',
    name: 'Magician',
    element: 'Air',
    line: 'Awareness. Insight. Change.',
    color: 'var(--hackberry)',
    ink: '#fff',
    body: [
      'Seeing under the surface: the patterns you repeat, the stories you tell yourself, what is really driving the reaction.',
      'We turn the light on the beliefs and old wounds that run us. Seen clearly, they lose their grip.',
    ],
    shadow: 'Using what he knows to manipulate, or playing dumb to dodge responsibility.',
  },
  {
    id: 'king',
    name: 'King',
    element: 'Fire',
    line: 'Order. Blessing. Leadership.',
    color: 'var(--beach)',
    ink: '#141414',
    body: [
      'Holding the whole thing: setting direction, making order, blessing the people around you.',
      'Here the other three come together in how you lead your life, your family and your work. Then we close the circle.',
    ],
    shadow: 'A tyrant, or a weakling who gives his power away.',
  },
];

const needed = GROUP.size - GROUP.filled;
const description = `A men’s group in Charlotte, Vermont, weekly for three months: Lover, Warrior, Magician, King. ${GROUP.filled} of ${GROUP.size} places filled; it starts once five men are in.`;

// The questions, in order. `optional` ones can be passed with Enter.
const TIMES = ['Weekday mornings', 'Weekday evenings', 'Weekend mornings', 'Weekend afternoons', 'I’m flexible'];
const EXPERIENCE = ['Yes, the ManKind Project', 'Yes, other men’s work or circles', 'No, this would be my first'];
const KEYS = 'ABCDE';
---

<Base title="Men’s Work, Charlotte VT · Samperet.com" description={description} path="/mens-group/" bodyClass="grit" merlin={false} viewer={false}>
  <Font slot="head" cssVariable="--font-oswald" preload />

  <main class="wrap mg">
    <a class="arrow-link home-btn" href="/" data-track="nav:home"><span class="arrow" aria-hidden="true">←</span> Home</a>

    <header class="mg-head">
      <h1>Men’s work <span>Charlotte VT</span></h1>
    </header>

    <p class="mg-lead">
      Show up, share, hold each other accountable, shift your perspective, check out in your sovereignty. <span>No fixing. No bullshit.</span>
    </p>

    <section class="mg-about" aria-labelledby="about-title">
      <h2 id="about-title">About me</h2>
      <div class="measure">
        <p>
          Born in ’86, grew up in NH, lived in California, Australia, Maui and Portland. I’ve sat in and built men’s circles since 2012. I’m a
          Dad, an entrepreneur, facilitator and yogi. You can check me out at <a href="/">Samperet.com</a>.
        </p>
        <p>
          I’m looking for a specific resonance of men to build this container with. Equal parts passion, curiosity, liveliness and skill. If you
          have questions, call me at <a href="tel:+16035311077">603.531.1077</a>, otherwise <a href="#apply">fill out the application</a> to
          apply.
        </p>
      </div>
    </section>

    <section class="mg-who" aria-labelledby="who-title">
      <h2 id="who-title">Who I’m looking for</h2>
      <ul>
        <li>Men who want to take responsibility for their lives, and support the men around them to do the same.</li>
        <li>Men who can fix shit, from cars to relationships.</li>
        <li>Men who can say the hard thing, who don’t ask for permission when none is needed, and who pave the way for the man behind them.</li>
      </ul>
    </section>

    <section class="mg-work" aria-labelledby="work-title">
      <h2 id="work-title">The work</h2>
      <p class="mg-hint">Scroll, or click the wheel.</p>

      <div class="work-layout">
        <div class="wheel-dock" data-dock>
          <div class="wheel" data-wheel style="--turn: 0deg">
            <span class="wheel-pointer" aria-hidden="true"></span>
            <div class="wheel-disc">
              {
                archetypes.map((a, i) => (
                  <button
                    type="button"
                    class="wedge"
                    data-wedge={i}
                    aria-label={a.name}
                    aria-controls={`${a.id}-panel`}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    style={`--at: ${(360 - i * 90) % 360}deg; --c: ${a.color}; --ink: ${a.ink}`}
                    data-track={`mens-group:wheel:${a.id}`}
                  >
                    <span class="wedge-name">{a.name}</span>
                  </button>
                ))
              }
            </div>
            <button type="button" class="wheel-hub" data-next aria-label="Turn to the next" data-track="mens-group:wheel:next">
              Next <span aria-hidden="true">↻</span>
            </button>
          </div>
        </div>

        <div class="panels">
          {
            archetypes.map((a) => (
              <div class="panel" id={`${a.id}-panel`} style={`--c: ${a.color}`} data-panel>
                <h3>{a.name}</h3>
                <p class="panel-line">{a.line}</p>
                {a.body.map((p) => <p>{p}</p>)}
                <p class="panel-shadow">
                  <strong>In shadow:</strong> {a.shadow}
                </p>
                <p class="panel-element">{a.element}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mg-apply" id="apply" aria-labelledby="apply-title">
      <h2 id="apply-title">Apply</h2>

      <div class="seats">
        <ol class="seat-row" aria-hidden="true">
          {Array.from({ length: GROUP.size }, (_, i) => <li class:list={['seat', { filled: i < GROUP.filled }]} />)}
        </ol>
        <p>
          <strong>{GROUP.filled} of {GROUP.size} in.</strong>{' '}
          {needed > 0 ? `${needed} more ${needed === 1 ? 'man' : 'men'} and we start.` : 'The circle is full.'}
        </p>
      </div>

      <button type="button" class="btn btn-accent apply-start" data-apply-start hidden>
        Apply now <span aria-hidden="true">→</span>
      </button>

      <p class="mg-note mg-done-nojs" id="applied" tabindex="-1">
        <strong>Got it.</strong> Once five men are in, I’ll write to you with the time, place and start date.
      </p>
      <p class="mg-note mg-failed" id="apply-failed" tabindex="-1">
        That didn’t go through. Try again, or write to <a href="mailto:sam@peret.net?subject=Men%E2%80%99s%20group">sam@peret.net</a>.
      </p>

      <div class="tf" data-tf>
        <div class="tf-progress" aria-hidden="true"><span data-progress></span></div>

        <form class="tf-form" method="post" action="/api/apply" enctype="multipart/form-data" data-apply>
          <div class="q" data-q>
            <label class="q-label" for="q-name"><span class="q-num">1 <span aria-hidden="true">→</span></span> What’s your name?</label>
            <input id="q-name" class="q-input" name="name" autocomplete="name" maxlength="100" required placeholder="Type your answer here…" />
          </div>

          <div class="q" data-q>
            <label class="q-label" for="q-email"><span class="q-num">2 <span aria-hidden="true">→</span></span> Good to meet you<span data-first></span>. What’s your email?</label>
            <input id="q-email" class="q-input" name="email" type="email" autocomplete="email" maxlength="200" required placeholder="name@example.com" />
          </div>

          <div class="q" data-q data-optional>
            <label class="q-label" for="q-phone"><span class="q-num">3 <span aria-hidden="true">→</span></span> Phone number? <em>Optional</em></label>
            <input id="q-phone" class="q-input" name="phone" type="tel" autocomplete="tel" maxlength="50" placeholder="Type your answer here…" />
          </div>

          <div class="q" data-q data-optional>
            <label class="q-label" for="q-lives"><span class="q-num">4 <span aria-hidden="true">→</span></span> Where do you live? <em>Optional</em></label>
            <input id="q-lives" class="q-input" name="lives" autocomplete="address-level2" maxlength="200" placeholder="Town" />
          </div>

          <div class="q" data-q>
            <label class="q-label" for="q-why"><span class="q-num">5 <span aria-hidden="true">→</span></span> What draws you to this group?</label>
            <textarea id="q-why" class="q-input q-long" name="why" rows="3" maxlength="4000" required placeholder="Type your answer here…"></textarea>
            <p class="q-tip"><b>Shift ⇧ + Enter ↵</b> for a new line</p>
          </div>

          <div class="q q-video" data-q data-optional data-video hidden>
            <p class="q-label"><span class="q-num">6 <span aria-hidden="true">→</span></span> When have you felt most alive? <em>Optional</em></p>
            <p class="q-desc">Answer on video, up to a minute. It comes to me with your application as an email attachment; it isn’t published or kept on this site.</p>
            <div class="video-stage" data-stage>
              <video class="video-live" data-live playsinline muted hidden></video>
              <video class="video-take" data-take playsinline controls hidden></video>
              <p class="video-question" data-question>When have you felt most alive?</p>
              <span class="video-count" data-count aria-hidden="true"></span>
              <span class="video-clock" data-clock hidden>0:00 / 1:00</span>
            </div>
            <div class="video-controls">
              <button type="button" class="btn" data-camera>Turn on camera</button>
              <button type="button" class="btn btn-accent" data-record hidden><span class="rec-dot" aria-hidden="true"></span> Record</button>
              <button type="button" class="btn btn-accent" data-stop hidden>Stop</button>
              <button type="button" class="btn btn-quiet" data-again hidden>Record again</button>
              <button type="button" class="btn btn-quiet" data-remove hidden>Remove video</button>
            </div>
            <p class="video-status" data-status aria-live="polite"></p>
          </div>

          <fieldset class="q" data-q data-optional>
            <legend class="q-label"><span class="q-num">7 <span aria-hidden="true">→</span></span> Have you done men’s work or sat in a men’s circle before? <em>Optional</em></legend>
            <div class="choices">
              {
                EXPERIENCE.map((e, i) => (
                  <label class="choice">
                    <input type="radio" name="experience" value={e} />
                    <span class="key">{KEYS[i]}</span> {e}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="q" data-q data-optional>
            <legend class="q-label"><span class="q-num">8 <span aria-hidden="true">→</span></span> When can you usually meet? <em>Choose as many as you like</em></legend>
            <div class="choices">
              {
                TIMES.map((t, i) => (
                  <label class="choice">
                    <input type="checkbox" name="times" value={t} />
                    <span class="key">{KEYS[i]}</span> {t}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="q" data-q data-commit>
            <legend class="q-label"><span class="q-num">9 <span aria-hidden="true">→</span></span> Can you commit to meeting weekly for three months, and to being accountable to the group?</legend>
            <div class="choices">
              <label class="choice">
                <input type="radio" name="commit" value="yes" required />
                <span class="key">A</span> Yes. I’m in.
              </label>
              <label class="choice">
                <input type="radio" name="commit" value="no" />
                <span class="key">B</span> Not right now.
              </label>
            </div>
            <p class="q-tip q-not-now" data-not-now hidden>Then now isn’t the time, and that’s an honest answer. Come back when it is.</p>
          </fieldset>

          <div class="hp" aria-hidden="true">
            <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <p class="q-error" role="alert" data-error></p>

          <div class="tf-actions tf-step-actions">
            <button type="button" class="btn btn-accent tf-ok" data-ok>OK <span aria-hidden="true">✓</span></button>
            <button type="submit" class="btn btn-accent tf-submit" data-submit data-track="mens-group:apply">Submit <span aria-hidden="true">→</span></button>
            <span class="tf-hint" data-hint>press <b>Enter ↵</b></span>
          </div>
        </form>

        <div class="tf-screen tf-done" data-done hidden tabindex="-1">
          <p class="tf-big">Got it<span data-done-name></span>.</p>
          <p class="tf-sub">Once five men are in, I’ll write to you with the time, place and start date.</p>
        </div>

        <nav class="tf-nav" aria-label="Questions" data-nav hidden>
          <button type="button" class="tf-arrow" data-prev aria-label="Previous question">↑</button>
          <button type="button" class="tf-arrow" data-next-q aria-label="Next question">↓</button>
        </nav>
      </div>
    </section>
  </main>

  <script>
    import fixWebmDuration from 'fix-webm-duration';
    import { sessionId, startTracking, track } from '../scripts/track';

    startTracking();

    // ---- The wheel ----
    // The four explanations stack beside the wheel (below it on a phone), and the wheel stays
    // in view, turning with the scroll itself: a quarter turn clockwise from one explanation to
    // the next, smoothly in between, and back as the reader scrolls up. The wedges run
    // counter-clockwise from the top (Lover 0°, Warrior 270°, Magician 180°, King 90°), so turning
    // clockwise brings them up in order, each on top exactly when its explanation reaches the
    // reading line. Clicking a wedge, or the hub for
    // the next one, scrolls to that explanation, and the wheel turns along the way.
    const wheel = document.querySelector<HTMLElement>('[data-wheel]')!;
    const dock = document.querySelector<HTMLElement>('[data-dock]')!;
    const wedges = [...wheel.querySelectorAll<HTMLButtonElement>('[data-wedge]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
    let current = -1;

    // The reading line, where an explanation's top sits once it's the one being read: under the
    // docked wheel on a phone, a quarter of the way down the window beside it.
    const stacked = matchMedia('(max-width: 860px)');
    const anchor = () => (stacked.matches ? dock.getBoundingClientRect().bottom + 16 : innerHeight * 0.25);

    // How far through the four the reader is: 0 at Lover, 3 at King, fractions in between.
    const throughWheel = () => {
      const line = anchor();
      const tops = panels.map((p) => p.getBoundingClientRect().top - line);
      if (tops[0] >= 0) return 0;
      for (let i = 0; i < tops.length - 1; i++) {
        if (tops[i + 1] > 0) return i + -tops[i] / (tops[i + 1] - tops[i]);
      }
      return tops.length - 1;
    };

    const sync = () => {
      const at = throughWheel();
      wheel.style.setProperty('--turn', `${at * 90}deg`);
      const index = Math.round(at);
      if (index === current) return;
      current = index;
      for (const [i, wedge] of wedges.entries()) wedge.setAttribute('aria-pressed', String(i === index));
      for (const [i, panel] of panels.entries()) panel.classList.toggle('on', i === index);
    };
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const goTo = (index: number, smooth = true) =>
      scrollTo({ top: scrollY + panels[index].getBoundingClientRect().top - anchor(), behavior: smooth && !reduced.matches ? 'smooth' : 'auto' });

    for (const [i, wedge] of wedges.entries()) wedge.addEventListener('click', () => goTo(i === current ? (i + 1) % panels.length : i));
    wheel.querySelector('[data-next]')!.addEventListener('click', () => goTo((current + 1) % panels.length));

    // A link to one (#warrior) opens on it.
    const fromHash = () => {
      const i = panels.findIndex((p) => p.id === `${location.hash.slice(1)}-panel`);
      if (i >= 0) goTo(i, false);
    };
    addEventListener('hashchange', fromHash);
    fromHash();
    sync();

    // ---- The video: when have you felt most alive? ----
    const LIMIT = 60; // seconds
    const MAX_BYTES = 4_200_000; // under Vercel's 4.5 MB request limit, with the rest of the form
    const videoQ = document.querySelector<HTMLElement>('[data-video]')!;
    const live = videoQ.querySelector<HTMLVideoElement>('[data-live]')!;
    const takeView = videoQ.querySelector<HTMLVideoElement>('[data-take]')!;
    const question = videoQ.querySelector<HTMLElement>('[data-question]')!;
    const countEl = videoQ.querySelector<HTMLElement>('[data-count]')!;
    const clockEl = videoQ.querySelector<HTMLElement>('[data-clock]')!;
    const status = videoQ.querySelector<HTMLElement>('[data-status]')!;
    const vb = {
      camera: videoQ.querySelector<HTMLButtonElement>('[data-camera]')!,
      record: videoQ.querySelector<HTMLButtonElement>('[data-record]')!,
      stop: videoQ.querySelector<HTMLButtonElement>('[data-stop]')!,
      again: videoQ.querySelector<HTMLButtonElement>('[data-again]')!,
      remove: videoQ.querySelector<HTMLButtonElement>('[data-remove]')!,
    };
    type VideoButton = keyof typeof vb;
    const showButtons = (...names: VideoButton[]) => {
      for (const [name, button] of Object.entries(vb)) button.hidden = !names.includes(name as VideoButton);
    };

    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const pickType = (types: string[]) => types.find((t) => MediaRecorder.isTypeSupported(t)) ?? '';

    let stream: MediaStream | undefined;
    let recorder: MediaRecorder | undefined;
    let take: { blob: Blob; seconds: number } | undefined;
    let takeUrl = '';
    const canRecord = typeof MediaRecorder !== 'undefined' && !!navigator.mediaDevices?.getUserMedia;

    const stopCamera = () => {
      stream?.getTracks().forEach((t) => t.stop());
      stream = undefined;
      live.srcObject = null;
      live.hidden = true;
      question.classList.remove('over');
    };

    const clearTake = () => {
      take = undefined;
      if (takeUrl) URL.revokeObjectURL(takeUrl);
      takeUrl = '';
      takeView.removeAttribute('src');
      takeView.hidden = true;
    };

    const cameraOn = async () => {
      status.textContent = '';
      vb.camera.disabled = true;
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
          audio: { echoCancellation: true, noiseSuppression: true },
        });
      } catch {
        status.textContent = 'The camera didn’t turn on. Allow this page to use your camera and microphone, or skip this one.';
        vb.camera.disabled = false;
        return;
      }
      vb.camera.disabled = false;
      clearTake();
      live.srcObject = stream;
      live.hidden = false;
      void live.play().catch(() => {});
      question.classList.add('over');
      showButtons('record');
      status.textContent = 'When you’re ready, hit Record. You’ve got a minute.';
    };

    const record = async () => {
      if (!stream) return;
      showButtons();
      for (const n of [3, 2, 1]) {
        countEl.textContent = String(n);
        await sleep(800);
      }
      countEl.textContent = '';
      const type = pickType([
        'video/mp4;codecs=avc1.42E01E,mp4a.40.2',
        'video/mp4;codecs=avc1,mp4a',
        'video/webm;codecs=vp8,opus',
        'video/webm;codecs=vp9,opus',
        'video/webm',
        'video/mp4',
      ]);
      const chunks: Blob[] = [];
      recorder = new MediaRecorder(stream, { ...(type && { mimeType: type }), videoBitsPerSecond: 350_000, audioBitsPerSecond: 48_000 });
      recorder.ondataavailable = (e) => e.data.size && chunks.push(e.data);
      const started = performance.now();
      const stopped = new Promise((r) => recorder!.addEventListener('stop', r, { once: true }));
      recorder.start(1000);
      showButtons('stop');
      clockEl.hidden = false;
      status.textContent = 'Recording.';
      const tick = setInterval(() => {
        const s = (performance.now() - started) / 1000;
        clockEl.textContent = `${clock(s)} / ${clock(LIMIT)}`;
        if (s >= LIMIT && recorder?.state === 'recording') recorder.stop();
      }, 250);

      await stopped;
      clearInterval(tick);
      const seconds = (performance.now() - started) / 1000;
      clockEl.hidden = true;
      stopCamera();
      let blob = new Blob(chunks, { type: recorder.mimeType || type || 'video/webm' });
      // Chrome's WebM carries no duration, so players can't show its length or seek; write it in.
      if (blob.type.includes('webm')) blob = await fixWebmDuration(blob, seconds * 1000, { logger: false });
      if (blob.size > MAX_BYTES) {
        status.textContent = 'That take is too big to send. Record a shorter one.';
        showButtons('again');
        return;
      }
      take = { blob, seconds };
      takeUrl = URL.createObjectURL(blob);
      takeView.src = takeUrl;
      takeView.hidden = false;
      showButtons('again', 'remove');
      status.textContent = `Your video (${clock(seconds)}) goes with your application.`;
    };

    vb.camera.addEventListener('click', cameraOn);
    vb.record.addEventListener('click', () => void record());
    vb.stop.addEventListener('click', () => recorder?.state === 'recording' && recorder.stop());
    vb.again.addEventListener('click', cameraOn);
    vb.remove.addEventListener('click', () => {
      clearTake();
      showButtons('camera');
      status.textContent = 'Video removed.';
    });

    // ---- The application, one question at a time ----
    const tf = document.querySelector<HTMLElement>('[data-tf]')!;
    const form = tf.querySelector<HTMLFormElement>('[data-apply]')!;
    const done = tf.querySelector<HTMLElement>('[data-done]')!;
    const nav = tf.querySelector<HTMLElement>('[data-nav]')!;
    const progress = tf.querySelector<HTMLElement>('[data-progress]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const ok = form.querySelector<HTMLButtonElement>('[data-ok]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const hint = form.querySelector<HTMLElement>('[data-hint]')!;
    const notNow = form.querySelector<HTMLElement>('[data-not-now]')!;
    if (canRecord) videoQ.hidden = false;
    const questions = [...form.querySelectorAll<HTMLElement>('[data-q]')].filter((q) => !q.hidden);
    // Number what's asked, so a browser that can't record skips the video without a gap.
    for (const [i, q] of questions.entries()) q.querySelector('.q-num')!.firstChild!.textContent = `${i + 1} `;

    let at = -1; // nothing shown yet; the first question opens on load
    tf.classList.add('tf-on');
    // The form waits behind the Apply now button (without JavaScript it simply shows).
    const applyStart = document.querySelector<HTMLButtonElement>('[data-apply-start]')!;
    applyStart.hidden = false;
    tf.hidden = true;
    applyStart.addEventListener('click', () => {
      applyStart.hidden = true;
      tf.hidden = false;
      tf.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      show(0);
    });
    nav.hidden = false;
    form.noValidate = true; // checked here, with messages in the page's voice

    const inputsOf = (q: HTMLElement) => [...q.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
    const firstName = () => (form.elements.namedItem('name') as HTMLInputElement).value.trim().split(/\s+/)[0] ?? '';

    const problemIn = (q: HTMLElement): string | null => {
      if (q.hasAttribute('data-commit')) {
        const choice = (form.elements.namedItem('commit') as RadioNodeList).value;
        if (!choice) return 'Pick one.';
        return choice === 'yes' ? null : 'This group needs a yes.';
      }
      if (q === videoQ && recorder?.state === 'recording') return 'Stop the recording first.';
      for (const field of inputsOf(q)) {
        if (field.checkValidity()) continue;
        if (field.type === 'email' && field.value.trim()) return 'That email doesn’t look right.';
        return 'This one’s needed.';
      }
      return null;
    };

    // `focus` is off for the first question on load, so the page doesn't jump to the form.
    const show = (index: number, focus = true) => {
      const back = index < at;
      at = index;
      error.textContent = '';
      form.classList.add('active');
      for (const [i, q] of questions.entries()) {
        q.classList.toggle('on', i === at);
        q.classList.toggle('from-above', back);
      }
      const last = at === questions.length - 1;
      ok.hidden = last;
      submit.hidden = !last;
      hint.hidden = last;
      progress.style.width = `${(at / questions.length) * 100}%`;
      (nav.querySelector('[data-prev]') as HTMLButtonElement).disabled = at === 0;
      (nav.querySelector('[data-next-q]') as HTMLButtonElement).disabled = last;
      if (at === 1) form.querySelector('[data-first]')!.textContent = firstName() ? `, ${firstName()}` : '';
      const q = questions[at];
      if (q && focus) {
        const focusable = q.querySelector<HTMLElement>('.q-input, input:checked, .choice input, [data-camera]');
        focusable?.focus({ preventScroll: true });
      }
      if (q !== videoQ && stream && recorder?.state !== 'recording') {
        stopCamera();
        showButtons(take ? 'again' : 'camera', ...(take ? (['remove'] as VideoButton[]) : []));
      }
    };

    const forward = () => {
      const q = questions[at];
      const issue = problemIn(q);
      if (issue) {
        error.textContent = issue;
        return;
      }
      if (at < questions.length - 1) show(at + 1);
    };

    ok.addEventListener('click', forward);
    nav.querySelector('[data-prev]')!.addEventListener('click', () => at > 0 && show(at - 1));
    nav.querySelector('[data-next-q]')!.addEventListener('click', forward);
    form.addEventListener('input', () => (error.textContent = ''));
    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name === 'commit') notNow.hidden = target.value !== 'no';
      // A single choice moves on by itself, as Typeform does; checkboxes wait for OK.
      if (target.type === 'radio' && target.name === 'experience') setTimeout(forward, 350);
    });

    // Enter moves on (Shift+Enter is a new line in the long answer); letters pick choices.
    tf.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        if (target instanceof HTMLButtonElement || target instanceof HTMLVideoElement) return;
        e.preventDefault();
        if (at === questions.length - 1) form.requestSubmit();
        else forward();
        return;
      }
      const q = questions[at];
      if (!q || e.metaKey || e.ctrlKey || e.altKey || target.matches('.q-input')) return;
      const index = 'abcde'.indexOf(e.key.toLowerCase());
      const box = index >= 0 ? q.querySelectorAll<HTMLInputElement>('.choice input')[index] : undefined;
      if (box) {
        e.preventDefault();
        box.click();
        box.focus({ preventScroll: true });
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      for (const [i, q] of questions.entries()) {
        const issue = problemIn(q);
        if (!issue) continue;
        show(i);
        error.textContent = issue;
        return;
      }
      const data = new FormData(form);
      data.set('session', sessionId() ?? '');
      if (take) {
        data.set('video', take.blob, `most-alive.${take.blob.type.includes('mp4') ? 'mp4' : 'webm'}`);
        data.set('video_length', clock(take.seconds));
      }
      submit.disabled = true;
      error.textContent = take ? 'Sending your application and video…' : 'Sending…';
      error.classList.add('quiet');
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
        const reply = await res.json().catch(() => ({ ok: false }));
        if (!reply.ok) throw new Error(reply.error ?? (res.status === 413 ? 'That video is too big to send. Record a shorter one.' : ''));
        track('click', 'mens-group:applied');
        stopCamera();
        done.querySelector('[data-done-name]')!.textContent = firstName() ? `, ${firstName()}` : '';
        form.hidden = true;
        nav.hidden = true;
        done.hidden = false;
        progress.style.width = '100%';
        done.focus({ preventScroll: true });
      } catch (err) {
        error.textContent = err instanceof Error && err.message && err.message !== 'Failed to fetch' ? err.message : 'That didn’t go through. Try again, or write to sam@peret.net.';
      } finally {
        error.classList.remove('quiet');
        submit.disabled = false;
      }
    });

    show(0, false);
  </script>
</Base>

